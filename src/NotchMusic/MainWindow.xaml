<Window x:Class="NotchMusic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NotchMusic.Helpers"
        Title="DRANOTCH"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        Loaded="Window_Loaded">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <helpers:BoolToStrikethroughConverter x:Key="BoolToStrike"/>
        <helpers:CountToVisibilityConverter x:Key="CountToVis"/>
        <helpers:CountToVisibilityConverter x:Key="InverseCountToVis" Invert="True"/>

        <!-- Luxury Specular Rim Border Brush for the Mac Notch -->
        <LinearGradientBrush x:Key="LuxuryNotchBorderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#14FFFFFF" Offset="0.0"/>
            <GradientStop Color="#282838" Offset="0.5"/>
            <GradientStop Color="#3C3C52" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Satin Pill Surface Brush -->
        <LinearGradientBrush x:Key="LuxuryPillBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#262632" Offset="0.0"/>
            <GradientStop Color="#191922" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Silver Metallic Gradient Brush (Matching DRANOTCH Logo) -->
        <LinearGradientBrush x:Key="MetallicSilverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#E2E6F0" Offset="0.35"/>
            <GradientStop Color="#949BA8" Offset="0.72"/>
            <GradientStop Color="#D4D9E6" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Luxury Squircle Icon Badge Surface & Rim -->
        <LinearGradientBrush x:Key="MetallicIconBadgeBgBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#232330" Offset="0.0"/>
            <GradientStop Color="#15151E" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MetallicIconBadgeBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4AFFFFFF" Offset="0.0"/>
            <GradientStop Color="#1CFFFFFF" Offset="0.5"/>
            <GradientStop Color="#36FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Luxury Vector Geometries (24x24 ViewBox) -->
        <!-- 1. Waktu Sholat: Crescent Moon & 4-Point Diamond Star -->
        <Geometry x:Key="LuxuryPrayerIconGeometry">M 20.6,13.4 A 8.6,8.6 0 1 1 10.6,3.4 A 6.6,6.6 0 0 0 20.6,13.4 Z M 17.5,2.2 L 18.5,5.0 L 21.3,6.0 L 18.5,7.0 L 17.5,9.8 L 16.5,7.0 L 13.7,6.0 L 16.5,5.0 Z</Geometry>

        <!-- 2. To-Do List: Luxury Rounded Task Frame & Bold Checkmark -->
        <Geometry x:Key="LuxuryTodoIconGeometry">M 9.2,11.3 L 11.6,13.7 L 18.2,7.1 L 20.1,9.0 L 11.6,17.5 L 7.3,13.2 Z M 5.5,3.2 H 14.2 V 5.5 H 5.8 V 18.2 H 18.5 V 12.8 H 20.8 V 18.5 A 2.3,2.3 0 0 1 18.5,20.8 H 5.5 A 2.3,2.3 0 0 1 3.2,18.5 V 5.5 A 2.3,2.3 0 0 1 5.5,3.2 Z</Geometry>

        <!-- 3. Browser: Meridian Globe Lines -->
        <Geometry x:Key="LuxuryBrowserIconGeometry">M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 2.6,9.3 H 21.4 M 2.6,14.7 H 21.4 M 12,2 C 15.1,5.2 16.7,8.5 16.7,12 C 16.7,15.5 15.1,18.8 12,22 C 8.9,18.8 7.3,15.5 7.3,12 C 7.3,8.5 8.9,5.2 12,2 Z</Geometry>

        <!-- 4. Modular Components Grid (4 Squares) -->
        <Geometry x:Key="LuxuryComponentsGridGeometry">M 3,3 H 10.2 V 10.2 H 3 Z M 13.8,3 H 21 V 10.2 H 13.8 Z M 3,13.8 H 10.2 V 21 H 3 Z M 13.8,13.8 H 21 V 21 H 13.8 Z</Geometry>

        <!-- 5. Music Eighth Note -->
        <Geometry x:Key="LuxuryMusicNoteGeometry">M 12,3 V 13.55 C 11.41,13.21 10.73,13 10,13 C 7.79,13 6,14.79 6,17 C 6,19.21 7.79,21 10,21 C 12.21,21 14,19.21 14,17 V 7 H 18 V 3 H 12 Z</Geometry>

        <!-- 6. Radio Online (Komponen ke-5): Luxury Radio Receiver & Antenna -->
        <Geometry x:Key="LuxuryRadioIconGeometry">M 6.5,7 L 16.8,2.8 L 17.6,4.6 L 10.5,7.5 H 19.5 A 2.5,2.5 0 0 1 22,10 V 18.5 A 2.5,2.5 0 0 1 19.5,21 H 4.5 A 2.5,2.5 0 0 1 2,18.5 V 10 A 2.5,2.5 0 0 1 4.5,7.5 H 6.5 Z M 8,11.5 A 2.8,2.8 0 1 0 8,17.1 A 2.8,2.8 0 1 0 8,11.5 Z M 13.5,12 H 19 V 13.6 H 13.5 Z M 13.5,15.2 H 17.5 V 16.8 H 13.5 Z</Geometry>

        <!-- Button style for sleek media controls -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F5F5FA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#48FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallPillButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource LuxuryPillBackgroundBrush}"/>
            <Setter Property="Foreground" Value="#E8E8F2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#343446"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Margin" Value="2.5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#323244"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#565672"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#404058"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill for To-Do -->
        <Style x:Key="FilterPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#16161A"/>
            <Setter Property="Foreground" Value="#888899"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#282830"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom CheckBox for To-Do -->
        <Style x:Key="TodoCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="BoxBorder" Width="18" Height="18" CornerRadius="5"
                                Background="#16161A" BorderBrush="#383840" BorderThickness="1.2">
                            <Path x:Name="CheckMark" Data="M 3 8 L 7 12 L 14 4" Stroke="#000000" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete Button for To-Do Item -->
        <Style x:Key="TodoDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555566"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DelBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DelBorder" Property="Background" Value="#33FF4D6D"/>
                                <Setter Property="Foreground" Value="#FF6B8B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox for To-Do -->
        <Style x:Key="TodoTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#141418"/>
            <Setter Property="Foreground" Value="#EDEDF5"/>
            <Setter Property="BorderBrush" Value="#2E2E36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Category ComboBox Style -->
        <Style x:Key="DarkCategoryComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#141418"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderBrush" Value="#2E2E36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Editable Text / Selected Value -->
                                    <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                             Background="Transparent" Foreground="#DDDDDD"
                                             BorderThickness="0" Padding="6,3" VerticalAlignment="Center"
                                             FontSize="11" CaretBrush="#FFFFFF"/>

                                    <!-- Placeholder when empty -->
                                    <TextBlock Grid.Column="0" Text="Kategori ▾" Foreground="#666677" FontSize="10.5"
                                               IsHitTestVisible="False" Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PART_EditableTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Toggle Dropdown Button -->
                                    <ToggleButton Grid.Column="1" Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="#888888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!-- Popup Dropdown List -->
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PopupAnimation="Slide">
                                <Border Background="#141418" BorderBrush="#2E2E36" BorderThickness="1" CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="160" Padding="3" Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#555560"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#E2E2EA"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#24242A"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#32323A"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseAppButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallPillButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Main Outer Container Attached to Top Bezel with Mac-Style Concave Notch Ears & DropShadow -->
    <Grid Margin="24,0,24,26" SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid.Effect>
            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="10" BlurRadius="28" Opacity="0.92"/>
        </Grid.Effect>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="MainIslandBorder"
                Grid.Column="1"
                Background="#000000"
                BorderBrush="{StaticResource LuxuryNotchBorderBrush}"
                BorderThickness="1.2,0,1.2,1.2"
                CornerRadius="0,0,24,24"
                MouseDown="Island_MouseDown">
            <Border.ContextMenu>
                <ContextMenu Background="#141418" BorderBrush="#282834" BorderThickness="1.2">
                    <MenuItem Header="Perluas Panel" Command="{Binding SetModeCommand}" CommandParameter="Expanded" 
                              Foreground="#FFFFFF" Visibility="{Binding IsCompactMode, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="Perkecil ke Notch" Command="{Binding SetModeCommand}" CommandParameter="Compact"
                              Foreground="#FFFFFF" Visibility="{Binding IsExpandedMode, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="Pengaturan" Command="{Binding OpenSettingsCommand}" Foreground="#FFFFFF"/>
                    <Separator Background="#282834"/>
                    <MenuItem Header="Tutup / Keluar Aplikasi" Command="{Binding ExitApplicationCommand}" Foreground="#FF6666"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- ================= MODE 1A: COMPACT (LUXURY MAC NOTCH: 5 KOMPONEN MODULAR) ================= -->
                <Grid x:Name="CompactView" Visibility="{Binding ShowCompactMusicView, Converter={StaticResource BoolToVis}}" 
                      Height="52" MaxWidth="1540" Margin="18,4,14,6" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Kolom 0: Komponen 1 - Musik (Album art, Track info & Standby lyrics, & Tombol Play/Pause) -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Kolom 1: Pembatas Garis 1 (Musik | Radio Online) -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Kolom 2: Komponen 2 - Radio Online (Di Sebelah Kanan Music Player) -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Kolom 3: Pembatas Garis 2 (Radio Online | Waktu Sholat) -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Kolom 4: Komponen 3 - Waktu Sholat -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Kolom 5: Pembatas Garis 3 (Waktu Sholat | To-Do) -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Kolom 6: Komponen 4 - To-Do List -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Kolom 7: Pembatas Garis 4 (To-Do | Browser) -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Kolom 8: Komponen 5 - Browser Mengambang -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Kolom 9: Tombol Pin, Perluas (Expand ▾), & Tombol Kecilkan Notch di ujung kanan -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- KOMPONEN 1: MUSIC PLAYER (Mac Dynamic Notch Style) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Luxury Mac Squircle Album Art (Selalu tampil; saat dikecilkan & musik tidak aktif hanya ikon ini yang muncul) -->
                        <Border Width="46" Height="46" CornerRadius="12" Margin="2,0,2,0" ClipToBounds="True" Cursor="Hand"
                                Background="#14141C" BorderBrush="#36FFFFFF" BorderThickness="1.2"
                                ToolTip="{Binding CurrentTrack.Title, FallbackValue='Pemutar Musik DRANOTCH (Klik untuk buka YouTube Music)'}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenYouTubeMusicCommand}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Image Source="pack://application:,,,/NotchMusic;component/Assets/app.png" Width="28" Height="28" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Image Source="{Binding CurrentTrack.Thumbnail}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <!-- Track Title, Live Standby Lyrics & Tombol Play/Pause (Muncul saat Notch penuh ATAU saat Musik sedang aktif diputar) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding ShowFullMusicInCompact, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center" Margin="9,0,10,0" MaxWidth="290">
                                <!-- Baris 1: Judul dan Artis -->
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="{Binding CurrentTrack.Artist, FallbackValue=''}" 
                                               Foreground="#A0A0B2" FontSize="12.5" FontWeight="SemiBold" DockPanel.Dock="Right" 
                                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='DRANOTCH'}" 
                                               Foreground="#FFFFFF" FontWeight="Bold" FontSize="15"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <!-- Baris 2: Lirik Real-Time Saat Standby -->
                                <Grid Margin="0,2,0,0" ToolTip="{Binding StandbyLyric}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource LuxuryMusicNoteGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                          Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StandbyLyric, FallbackValue='Siap memutar...'}" 
                                               Foreground="#E6E6F2" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <!-- Tombol Play / Pause (Luxury Satin Glass Circle) -->
                            <Button Style="{StaticResource ControlButtonStyle}" Command="{Binding TogglePlayPauseCommand}" 
                                    Width="40" Height="40" Padding="0" ToolTip="Putar / Jeda" VerticalAlignment="Center" Margin="0,0,2,0">
                                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource MetallicIconBadgeBgBrush}" BorderBrush="{StaticResource MetallicIconBadgeBorderBrush}" BorderThickness="1">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Play icon (when paused) -->
                                        <Path Data="M 0 0 L 12 7 L 0 14 Z" Fill="{StaticResource MetallicSilverBrush}" Margin="2,0,0,0"
                                              Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible, TargetNullValue=Visible}"/>
                                        <!-- Pause icon (when playing) -->
                                        <Path Data="M 0 0 H 3.5 V 13 H 0 Z M 6.5 0 H 10 V 13 H 6.5 Z" Fill="{StaticResource MetallicSilverBrush}"
                                              Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
                                    </Grid>
                                </Border>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- PEMBATAS GARIS 1 (Snap Divider): Musik | Radio Online -->
                    <Border Grid.Column="1" Width="1.2" Height="32" Background="#282836" Margin="7,0" VerticalAlignment="Center"
                            ToolTip="Batas modular komponen Musik &amp; Radio Online"/>

                    <!-- KOMPONEN 2: RADIO ONLINE (Di Sebelah Kanan Music Player) -->
                    <Border Grid.Column="2" Background="#121218" BorderBrush="#2C2C3A" BorderThickness="1.2"
                            CornerRadius="15" Height="44" Margin="2,0,2,0" Padding="8,4" Cursor="Hand"
                            ToolTip="{Binding RadioNotchTooltip}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenRadioCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Luxury Silver Metallic Radio Badge (Selalu tampil) -->
                            <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource MetallicIconBadgeBgBrush}"
                                    BorderBrush="{StaticResource MetallicIconBadgeBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <Path Data="{StaticResource LuxuryRadioIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                      Width="15.5" Height="15.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Detail Radio (Muncul saat Notch penuh ATAU saat Radio sedang aktif) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0"
                                        Visibility="{Binding ShowFullRadioInCompact, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding RadioCompactLabel}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold"
                                           VerticalAlignment="Center" MaxWidth="115" TextTrimming="CharacterEllipsis"/>
                                <!-- Quick Play / Pause Radio Button -->
                                <Button Style="{StaticResource ControlButtonStyle}" Command="{Binding ToggleRadioPlayPauseCommand}"
                                        Width="26" Height="26" Padding="0" Margin="6,0,0,0" ToolTip="Putar / Jeda Radio Online" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#222230" BorderBrush="#36364A" BorderThickness="1">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M 0 0 L 7 4.2 L 0 8.4 Z" Fill="{StaticResource MetallicSilverBrush}" Margin="1.5,0,0,0"
                                                  Visibility="{Binding IsRadioPlaying, Converter={StaticResource InverseBoolToVis}}"/>
                                            <Path Data="M 0 0 H 2.2 V 8 H 0 Z M 4 0 H 6.2 V 8 H 4 Z" Fill="#30D158"
                                                  Visibility="{Binding IsRadioPlaying, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                </Button>
                                <Ellipse Width="6" Height="6" Fill="#30D158" Margin="6,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsRadioActiveOrOpen, Converter={StaticResource BoolToVis}}"
                                         ToolTip="{Binding RadioStatusMessage}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- PEMBATAS GARIS 2 (Snap Divider): Radio Online | Waktu Sholat -->
                    <Border Grid.Column="3" Width="1.2" Height="32" Background="#282836" Margin="7,0" VerticalAlignment="Center"
                            Visibility="{Binding ShowPrayerDivider1, Converter={StaticResource BoolToVis}}"
                            ToolTip="Batas modular komponen Radio Online &amp; Waktu Sholat"/>

                    <!-- KOMPONEN 3: WAKTU SHOLAT (Selalu muncul utuh walaupun idle/dikecilkan) -->
                    <Border Grid.Column="4" Background="#121218" BorderBrush="#2C2C3A" BorderThickness="1.2"
                            CornerRadius="15" Height="44" Margin="2,0,2,0" Padding="9,4,12,4" Cursor="Hand"
                            Visibility="{Binding ShowCompactPrayerPill, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding PrayerScheduleTooltip}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenPrayerScheduleCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Luxury Silver Metallic Prayer Icon Badge -->
                            <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource MetallicIconBadgeBgBrush}"
                                    BorderBrush="{StaticResource MetallicIconBadgeBorderBrush}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource LuxuryPrayerIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                      Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding NextPrayerName}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding NextPrayerTimeFormatted}" Foreground="#E8E8F2" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <Border Background="#222230" BorderBrush="#36364A" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NextPrayerCountdownBadge}" Foreground="#D4D4E4" FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- PEMBATAS GARIS 3 (Snap Divider): Waktu Sholat | To-Do List -->
                    <Border Grid.Column="5" Width="1.2" Height="32" Background="#282836" Margin="7,0" VerticalAlignment="Center"
                            Visibility="{Binding ShowPrayerDivider2, Converter={StaticResource BoolToVis}}"
                            ToolTip="Batas modular komponen Waktu Sholat &amp; To-Do"/>

                    <!-- KOMPONEN 4: TO-DO LIST (Ticker) -->
                    <Border Grid.Column="6" Background="#121218" BorderBrush="#2C2C3A" BorderThickness="1.2"
                            CornerRadius="15" Height="44" Margin="2,0,2,0" Padding="8,4" Cursor="Hand"
                            Visibility="{Binding ShowTodoTicker, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding CurrentTickerText, StringFormat='To-Do: {0} (Klik untuk buka panel)'}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetModeCommand}" CommandParameter="Expanded"/>
                        </Border.InputBindings>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <!-- Checkmark / Quick Complete Silver Metallic Badge -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Detail Ticker (Muncul saat Notch penuh ATAU saat ada tugas aktif) -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tombol Cepat Selesai jika ada tugas tertunda (Silver Metallic Squircle Badge) -->
                            <Button Grid.Column="0" Command="{Binding CompleteCurrentTickerCommand}"
                                    ToolTip="Tandai tugas pertama selesai" Style="{StaticResource ControlButtonStyle}"
                                    Padding="0" Width="28" Height="28" VerticalAlignment="Center"
                                    Visibility="{Binding HasPendingTodos, Converter={StaticResource BoolToVis}}">
                                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource MetallicIconBadgeBgBrush}"
                                        BorderBrush="{StaticResource MetallicIconBadgeBorderBrush}" BorderThickness="1">
                                    <Path Data="{StaticResource LuxuryTodoIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                          Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>

                            <!-- Ikon Luxury To-Do jika tidak ada tugas tertunda (Proportional Silver Metallic Badge) -->
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="{StaticResource MetallicIconBadgeBgBrush}"
                                    BorderBrush="{StaticResource MetallicIconBadgeBorderBrush}" BorderThickness="1" VerticalAlignment="Center"
                                    Visibility="{Binding HasPendingTodos, Converter={StaticResource InverseBoolToVis}}">
                                <Path Data="{StaticResource LuxuryTodoIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                      Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Detail Tugas (Muncul saat Notch penuh ATAU saat To-Do memiliki tugas aktif) -->
                            <Grid Grid.Column="1" Margin="8,0,4,0" MinWidth="145" MaxWidth="255" VerticalAlignment="Center"
                                  Visibility="{Binding ShowFullTodoInCompact, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Badge Jumlah Tugas (misal 3) -->
                                <Border Grid.Column="0" Background="#222230" BorderBrush="#36364A" BorderThickness="1" CornerRadius="6" Padding="5,1.5" Margin="0,0,6,0"
                                        VerticalAlignment="Center" Visibility="{Binding HasPendingTodos, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding CurrentTickerBadge}" Foreground="#E8E8F2" FontSize="11" FontWeight="Bold"/>
                                </Border>

                                <!-- Teks Judul Tugas yang Berjalan dari Kanan ke Kiri Terus Bersambung Lintas Kategori -->
                                <helpers:MarqueeTextBlock Grid.Column="1" Text="{Binding CurrentTickerText}" 
                                                          Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold"
                                                          Speed="36" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- PEMBATAS GARIS 4 (Snap Divider): To-Do List | Browser -->
                    <Border Grid.Column="7" Width="1.2" Height="32" Background="#282836" Margin="7,0" VerticalAlignment="Center"
                            ToolTip="Batas modular komponen To-Do List &amp; Browser"/>

                    <!-- KOMPONEN 5: BROWSER MENGAMBANG -->
                    <Border Grid.Column="8" Background="#121218" BorderBrush="#2C2C3A" BorderThickness="1.2"
                            CornerRadius="15" Height="44" Margin="2,0,8,0" Padding="8,4" Cursor="Hand"
                            ToolTip="Buka Browser Mengambang (YouTube, Streaming Film, Web Bebas)">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenFloatingBrowserCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Luxury Silver Metallic Globe Badge (Selalu tampil) -->
                            <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource MetallicIconBadgeBgBrush}"
                                    BorderBrush="{StaticResource MetallicIconBadgeBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <Path Data="{StaticResource LuxuryBrowserIconGeometry}" Stroke="{StaticResource MetallicSilverBrush}"
                                      StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="15.5" Height="15.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Detail Teks Browser (Muncul saat Notch penuh ATAU saat Browser sedang aktif dibuka) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,5,0"
                                        Visibility="{Binding ShowFullBrowserInCompact, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Browser" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Ellipse Width="6" Height="6" Fill="#30D158" Margin="7,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsBrowserWindowOpen, Converter={StaticResource BoolToVis}}"
                                         ToolTip="Browser Mengambang sedang aktif"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TOMBOL KOMPONEN, PIN, PERLUAS PANEL (Expand ▾), & TOMBOL MENGECILKAN NOTCH DI UJUNG SEBELAH KANAN -->
                    <StackPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding ToggleComponentsMenuCommand}"
                                ToolTip="Munculkan komponen notch yang ditutup" Visibility="{Binding HasClosedComponents, Converter={StaticResource BoolToVis}}"
                                Padding="10,8" Margin="2,0,4,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource LuxuryComponentsGridGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock Text="+" FontSize="12.5" FontWeight="Bold" Foreground="#FFAA44" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding TogglePinCommand}"
                                ToolTip="{Binding PinButtonTooltip}" Padding="10,8" Margin="2,0,3,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📌" FontSize="11.5" VerticalAlignment="Center"/>
                                <Ellipse Width="5" Height="5" Fill="#30D158" Margin="4,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" 
                                CommandParameter="Expanded" Padding="11,10" ToolTip="Perluas Panel" Margin="1,0,3,0">
                            <Path Data="M 0,0 L 5.5,5.5 L 11,0" Stroke="{StaticResource MetallicSilverBrush}"
                                  StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <!-- Tombol Mengecilkan / Memperbesar Notch di ujung sebelah kanan (Menggantikan tombol Close di Gambar 1) -->
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding ToggleMiniModeCommand}"
                                Padding="10,9" ToolTip="{Binding MiniModeButtonTooltip}" Margin="1,0,0,0">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Ikon Mengecilkan Notch (Panah Masuk ›‹ saat Notch sedang Penuh) -->
                                <Path Data="M 0,1 L 4,5 L 0,9 M 11,1 L 7,5 L 11,9" Stroke="{StaticResource MetallicSilverBrush}"
                                      StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="{Binding IsIdleMiniMode, Converter={StaticResource InverseBoolToVis}}"/>
                                <!-- Ikon Memperbesar Notch (Panah Keluar ‹› saat Notch sedang Dikecilkan) -->
                                <Path Data="M 4,1 L 0,5 L 4,9 M 7,1 L 11,5 L 7,9" Stroke="#30D158"
                                      StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="{Binding IsIdleMiniMode, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================= MODE 1B: COMPACT (TODO ONLY NOTCH) ================= -->
                <Grid x:Name="CompactTodoView" Visibility="{Binding ShowCompactTodoOnlyView, Converter={StaticResource BoolToVis}}" 
                      Height="52" MaxWidth="1180" Margin="18,4,14,6" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- To-Do Icon Badge (Mac Squircle Silver Metallic) -->
                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Margin="2,0,10,0" Cursor="Hand"
                            Background="{StaticResource MetallicIconBadgeBgBrush}" BorderBrush="{StaticResource MetallicIconBadgeBorderBrush}" BorderThickness="1.2">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetModeCommand}" CommandParameter="Expanded"/>
                        </Border.InputBindings>
                        <Path Data="{StaticResource LuxuryTodoIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                              Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Ticker Task Info (Click to Expand - Muncul saat Notch penuh ATAU ada tugas aktif) -->
                    <Border Grid.Column="1" Background="#121218" BorderBrush="#2C2C3A" BorderThickness="1.2"
                            CornerRadius="15" Height="44" Margin="0,0,10,0" Padding="12,4" MinWidth="180" Cursor="Hand"
                            Visibility="{Binding ShowFullTodoInCompact, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding CurrentTickerText, StringFormat='To-Do: {0} (Klik untuk buka daftar)'}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetModeCommand}" CommandParameter="Expanded"/>
                        </Border.InputBindings>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Badge Jumlah Tugas -->
                            <Border Grid.Column="0" Background="#222230" BorderBrush="#36364A" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,8,0"
                                    VerticalAlignment="Center" Visibility="{Binding HasPendingTodos, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding CurrentTickerBadge}" Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold"/>
                            </Border>

                            <helpers:MarqueeTextBlock Grid.Column="1" Text="{Binding CurrentTickerText}" 
                                                      Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold"
                                                      Speed="36" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Quick Complete Button -->
                    <Button Grid.Column="2" Command="{Binding CompleteCurrentTickerCommand}"
                            ToolTip="Tandai tugas selesai" Style="{StaticResource ControlButtonStyle}"
                            Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,8,0"
                            Visibility="{Binding HasPendingTodos, Converter={StaticResource BoolToVis}}">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource MetallicIconBadgeBgBrush}"
                                BorderBrush="{StaticResource MetallicIconBadgeBorderBrush}" BorderThickness="1.2">
                            <Path Data="{StaticResource LuxuryTodoIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                  Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>

                    <!-- Prayer Times Pill (Compact Mode - Selalu muncul walaupun idle) -->
                    <Border Grid.Column="3" Background="#121218" BorderBrush="#2C2C3A" BorderThickness="1.2"
                            CornerRadius="15" Height="44" Margin="0,0,2,0" Padding="9,4,12,4" Cursor="Hand"
                            Visibility="{Binding ShowCompactPrayerPill, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding PrayerScheduleTooltip}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenPrayerScheduleCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource MetallicIconBadgeBgBrush}"
                                    BorderBrush="{StaticResource MetallicIconBadgeBorderBrush}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource LuxuryPrayerIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                      Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding NextPrayerName}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding NextPrayerTimeFormatted}" Foreground="#E8E8F2" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Border Background="#222230" BorderBrush="#36364A" BorderThickness="1" CornerRadius="6" Padding="5,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NextPrayerCountdownBadge}" Foreground="#D4D4E4" FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Pembatas Garis: To-Do/Sholat | Radio Online -->
                    <Border Grid.Column="4" Width="1.2" Height="32" Background="#282836" Margin="7,0" VerticalAlignment="Center"
                            ToolTip="Batas modular komponen To-Do List &amp; Radio Online"/>

                    <!-- Komponen Radio Online -->
                    <Border Grid.Column="5" Background="#121218" BorderBrush="#2C2C3A" BorderThickness="1.2"
                            CornerRadius="15" Height="44" Margin="2,0,2,0" Padding="8,4" Cursor="Hand"
                            ToolTip="{Binding RadioNotchTooltip}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenRadioCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource MetallicIconBadgeBgBrush}"
                                    BorderBrush="{StaticResource MetallicIconBadgeBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <Path Data="{StaticResource LuxuryRadioIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                      Width="15.5" Height="15.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0"
                                        Visibility="{Binding ShowFullRadioInCompact, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding RadioCompactLabel}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold"
                                           VerticalAlignment="Center" MaxWidth="115" TextTrimming="CharacterEllipsis"/>
                                <Button Style="{StaticResource ControlButtonStyle}" Command="{Binding ToggleRadioPlayPauseCommand}"
                                        Width="26" Height="26" Padding="0" Margin="6,0,0,0" ToolTip="Putar / Jeda Radio Online" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#222230" BorderBrush="#36364A" BorderThickness="1">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M 0 0 L 7 4.2 L 0 8.4 Z" Fill="{StaticResource MetallicSilverBrush}" Margin="1.5,0,0,0"
                                                  Visibility="{Binding IsRadioPlaying, Converter={StaticResource InverseBoolToVis}}"/>
                                            <Path Data="M 0 0 H 2.2 V 8 H 0 Z M 4 0 H 6.2 V 8 H 4 Z" Fill="#30D158"
                                                  Visibility="{Binding IsRadioPlaying, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                </Button>
                                <Ellipse Width="6" Height="6" Fill="#30D158" Margin="6,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsRadioActiveOrOpen, Converter={StaticResource BoolToVis}}"
                                         ToolTip="{Binding RadioStatusMessage}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Pembatas Garis: Radio Online | Browser -->
                    <Border Grid.Column="6" Width="1.2" Height="32" Background="#282836" Margin="7,0" VerticalAlignment="Center"
                            ToolTip="Batas modular komponen Radio Online &amp; Browser"/>

                    <!-- Komponen 4: Browser Mengambang -->
                    <Border Grid.Column="7" Background="#121218" BorderBrush="#2C2C3A" BorderThickness="1.2"
                            CornerRadius="15" Height="44" Margin="2,0,8,0" Padding="8,4" Cursor="Hand"
                            ToolTip="Buka Browser Mengambang (YouTube, Streaming Film, Web Bebas)">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenFloatingBrowserCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource MetallicIconBadgeBgBrush}"
                                    BorderBrush="{StaticResource MetallicIconBadgeBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <Path Data="{StaticResource LuxuryBrowserIconGeometry}" Stroke="{StaticResource MetallicSilverBrush}"
                                      StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="15.5" Height="15.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,5,0"
                                        Visibility="{Binding ShowFullBrowserInCompact, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Browser" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Ellipse Width="6" Height="6" Fill="#30D158" Margin="7,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsBrowserWindowOpen, Converter={StaticResource BoolToVis}}"
                                         ToolTip="Browser Mengambang sedang aktif"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Actions (Pin, Expand, Settings, & Tombol Mengecilkan Notch di ujung kanan) -->
                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding TogglePinCommand}"
                                ToolTip="{Binding PinButtonTooltip}" Padding="10,8" Margin="0,0,3,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📌" FontSize="11.5" VerticalAlignment="Center"/>
                                <Ellipse Width="5" Height="5" Fill="#30D158" Margin="4,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" CommandParameter="Expanded" Padding="11,10" ToolTip="Perluas To-Do">
                            <Path Data="M 0,0 L 5.5,5.5 L 11,0" Stroke="{StaticResource MetallicSilverBrush}"
                                  StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenSettingsCommand}" Content="⚙" FontSize="13.5" Padding="10,7" ToolTip="Pengaturan" Margin="3,0,3,0"/>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding ToggleMiniModeCommand}"
                                Padding="10,9" ToolTip="{Binding MiniModeButtonTooltip}" Margin="0">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 0,1 L 4,5 L 0,9 M 11,1 L 7,5 L 11,9" Stroke="{StaticResource MetallicSilverBrush}"
                                      StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="{Binding IsIdleMiniMode, Converter={StaticResource InverseBoolToVis}}"/>
                                <Path Data="M 4,1 L 0,5 L 4,9 M 7,1 L 11,5 L 7,9" Stroke="#30D158"
                                      StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="{Binding IsIdleMiniMode, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                    <!-- ================= MODE 2: EXPANDED (SIDE-BY-SIDE: MUSIC & TO-DO) ================= -->
                <Grid x:Name="ExpandedView" Visibility="{Binding IsExpandedMode, Converter={StaticResource BoolToVis}}" 
                      Width="{Binding ExpandedPanelWidth}" Margin="22,16,22,18">

                    <!-- TAMPILAN NORMAL (MUSIK, WAKTU SHOLAT, & TO-DO) -->
                    <Grid Visibility="{Binding ShowNormalExpandedContent, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <!-- Kolom 0: Pemutar Musik -->
                            <ColumnDefinition Width="{Binding MusicColumnWidth}"/>
                            <!-- Garis Pemisah Vertikal 1: Musik | Waktu Sholat -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Kolom 2: Waktu Sholat (Expanded) -->
                            <ColumnDefinition Width="{Binding PrayerColumnWidth}"/>
                            <!-- Garis Pemisah Vertikal 2: Waktu Sholat | To-Do -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Kolom 4: To-Do List -->
                            <ColumnDefinition Width="{Binding TodoColumnWidth}"/>
                        </Grid.ColumnDefinitions>

                    <!-- ===== SISI KIRI: PEMUTAR MUSIK ===== -->
                    <Grid Grid.Column="0" Visibility="{Binding ShowMusicSection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Session info & Tools -->
                        <Grid Grid.Row="0" Margin="0,0,6,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Album art / Icon DRANOTCH (Luxury Mac Squircle) -->
                            <Border Grid.Column="0" Width="50" Height="50" CornerRadius="13" ClipToBounds="True" Background="#14141C" BorderBrush="#36FFFFFF" BorderThickness="1.2" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Grid>
                                    <Image Source="pack://application:,,,/NotchMusic;component/Assets/app.png" Width="28" Height="28" Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Image Source="{Binding CurrentTrack.Thumbnail}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>

                            <!-- Track Title, Artist, Session -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='Tidak ada lagu'}" 
                                           Foreground="#FFFFFF" FontSize="15.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CurrentTrack.Artist, FallbackValue='-'}" 
                                           Foreground="#C8C8D8" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                <TextBlock Text="{Binding SessionStatus}" 
                                           Foreground="#84849A" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>

                            <!-- Top actions (Update, Pin, YouTube Music, Lyrics, Komponen Symbol, Settings, Minimize, Close) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SmallPillButton}" 
                                        Command="{Binding OpenUpdateCommand}" 
                                        Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVis}}" 
                                        ToolTip="Versi baru tersedia! Klik untuk memperbarui DRANOTCH" 
                                        Background="#222228" Padding="6,3" Margin="0,0,3,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✨" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AvailableUpdateVersion, StringFormat='Update {0}'}" 
                                                   Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding TogglePinCommand}" ToolTip="Pin agar tetap terbuka" Padding="5,3" Margin="0,0,3,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📌" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <TextBlock Text="Pin" FontSize="11" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#888899"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenYouTubeMusicCommand}" 
                                        ToolTip="Buka Pemutar YouTube Music untuk ganti lagu" Padding="6,3" Margin="0,0,3,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▶" Foreground="#FF4D6D" FontSize="9" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBlock Text="YT Music" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" CommandParameter="Lyrics" Content="Lirik" ToolTip="Mode Layar Lirik Penuh" Padding="6,3" Margin="0,0,3,0"/>
                                
                                <!-- Komponen Radio Online di sebelah kanan Music Player -->
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenRadioCommand}"
                                        ToolTip="{Binding RadioNotchTooltip}" Padding="7,3" Margin="0,0,3,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource LuxuryRadioIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="Radio" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <Ellipse Width="5" Height="5" Fill="#30D158" Margin="4,0,0,0" VerticalAlignment="Center"
                                                 Visibility="{Binding IsRadioActiveOrOpen, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Button>

                                <!-- Tombol Komponen (Ikon Grid Silver Metallic) -->
                                <Button x:Name="ComponentsButton" Style="{StaticResource SmallPillButton}" Command="{Binding ToggleComponentsMenuCommand}"
                                        ToolTip="{Binding ComponentsButtonTooltip}" Padding="7,4" Margin="0,0,3,0">
                                    <Path Data="{StaticResource LuxuryComponentsGridGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                          Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                </Button>

                                <!-- Popup Menu Komponen Notch -->
                                <Popup x:Name="ComponentsPopup" IsOpen="{Binding IsComponentsMenuOpen, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=ComponentsButton}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="#14141A" BorderBrush="#282836" BorderThickness="1.2"
                                            CornerRadius="14" Padding="12,10" Width="290" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.75"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <!-- Popup Header -->
                                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallPillButton}"
                                                        Command="{Binding ToggleComponentsMenuCommand}" Content="✕" Padding="4,1" FontSize="10"/>
                                                <StackPanel>
                                                    <TextBlock Text="Komponen Notch" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Bold"/>
                                                    <TextBlock Text="Atur dan munculkan kembali komponen" Foreground="#777788" FontSize="9.5"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <Border Height="1" Background="#242430" Margin="0,0,0,8"/>

                                            <!-- Item 1: Radio Online (Di sebelah kanan Music Player) -->
                                            <Border Background="#0E0E12" BorderBrush="#202028" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource LuxuryRadioIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Radio Online" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding RadioStatusSummary}" Foreground="#888899" FontSize="9.5" Margin="19,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding ToggleRadioPlayPauseCommand}"
                                                                ToolTip="Putar atau jeda siaran radio" Padding="7,3" Margin="2,0">
                                                            <Grid>
                                                                <TextBlock Text="Putar" FontSize="10.5" Visibility="{Binding IsRadioPlaying, Converter={StaticResource InverseBoolToVis}}"/>
                                                                <TextBlock Text="Jeda" FontSize="10.5" Visibility="{Binding IsRadioPlaying, Converter={StaticResource BoolToVis}}"/>
                                                            </Grid>
                                                        </Button>
                                                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding ToggleRadioWindowCommand}"
                                                                ToolTip="Buka atau tutup jendela Radio Online" Padding="8,3" Margin="2,0">
                                                            <TextBlock Text="{Binding RadioButtonActionText}" FontSize="10.5"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Item 2: Waktu Sholat -->
                                            <Border Background="#0E0E12" BorderBrush="#202028" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource LuxuryPrayerIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Waktu Sholat" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding NextPrayerCountdownBadge, StringFormat='Next: {0}'}" Foreground="#888899" FontSize="9.5" Margin="19,1,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding AttachPrayerCommand}"
                                                                ToolTip="Pasang kembali ke notch utama" Padding="6,3" Margin="2,0">
                                                            <TextBlock Text="Di Notch" FontSize="10.5"/>
                                                        </Button>
                                                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding DetachPrayerCommand}"
                                                                ToolTip="Buka di jendela melayang" Padding="6,3" Margin="2,0">
                                                            <TextBlock Text="Melayang" FontSize="10.5"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Item 3: To-Do List -->
                                            <Border Background="#0E0E12" BorderBrush="#202028" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource LuxuryTodoIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="To-Do List" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding TodoSummaryText}" Foreground="#888899" FontSize="9.5" Margin="19,1,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding AttachTodoCommand}"
                                                                ToolTip="Pasang kembali ke notch utama" Padding="6,3" Margin="2,0">
                                                            <TextBlock Text="Di Notch" FontSize="10.5"/>
                                                        </Button>
                                                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding DetachTodoCommand}"
                                                                ToolTip="Buka di jendela melayang" Padding="6,3" Margin="2,0">
                                                            <TextBlock Text="Melayang" FontSize="10.5"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Item 4: Browser Mengambang -->
                                            <Border Background="#0E0E12" BorderBrush="#202028" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource LuxuryBrowserIconGeometry}" Stroke="{StaticResource MetallicSilverBrush}"
                                                                  StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Browser Mengambang" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding BrowserStatusSummary}" Foreground="#888899" FontSize="9.5" Margin="19,1,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding ToggleBrowserCommand}"
                                                                ToolTip="Buka atau tutup jendela browser mengambang" Padding="8,3" Margin="2,0">
                                                            <TextBlock Text="{Binding BrowserButtonActionText}" FontSize="10.5"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Tombol Reset / Pulihkan Semua ke Notch -->
                                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding RestoreAllComponentsCommand}"
                                                    Background="#1F1F2A" Margin="0,2,0,0" Padding="8,5" HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="↺" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Munculkan Semua di Notch" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenSettingsCommand}" Content="⚙" ToolTip="Pengaturan" Padding="5,3" Margin="0,0,3,0"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" CommandParameter="Compact" Content="▴" ToolTip="Tutup ke Compact"
                                        Visibility="{Binding ShowMusicMinimizeButton, Converter={StaticResource BoolToVis}}" Padding="5,3" Margin="0,0,3,0"/>
                                <Button Style="{StaticResource CloseAppButtonStyle}" Command="{Binding ExitApplicationCommand}" Content="✕" ToolTip="Tutup Aplikasi DRANOTCH"
                                        Visibility="{Binding ShowMusicMinimizeButton, Converter={StaticResource BoolToVis}}" Padding="5,3" Margin="0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Synced 3-Line Lyrics Preview / Unsynced Scrollable Lyrics / YT Music Button State -->
                        <Border Grid.Row="1" Background="#141418" CornerRadius="10" Padding="10,8" Margin="0,4,0,8"
                                MinHeight="68" MaxHeight="96">
                            <Grid>
                                <!-- State 1: Tidak ada lagu yang diputar -> Tombol YT Music -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasTrack, Converter={StaticResource InverseBoolToVis}}">
                                    <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenYouTubeMusicCommand}"
                                            ToolTip="Buka Pemutar YouTube Music" Background="#23171F" BorderBrush="#4A2534" BorderThickness="1.2"
                                            Padding="14,8" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="▶" Foreground="#FF4D6D" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="YT Music" Foreground="#FFD0DD" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- State 2: Ada lagu yang diputar -> Tampilkan Lirik -->
                                <Grid Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}">
                                    <!-- Synced 3-Line Display -->
                                    <StackPanel VerticalAlignment="Center"
                                                Visibility="{Binding IsLyricsSynced, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding PreviousLyric}" Foreground="#555566" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding ActiveLyric}" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2"/>
                                        <TextBlock Text="{Binding NextLyric}" Foreground="#555566" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Unsynced / Plain Lyrics Display with ScrollViewer -->
                                    <ScrollViewer VerticalAlignment="Center" MaxHeight="80" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding IsLyricsSynced, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="{Binding ActiveLyric}" Foreground="#CCCCCC" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18"/>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Progress bar & time -->
                        <Grid Grid.Row="2" Margin="0,2,0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Slider Grid.Row="0" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding CurrentPositionSeconds, Mode=TwoWay}"
                                    IsMoveToPointEnabled="True" Cursor="Hand" Margin="0,0,0,2"
                                    PreviewMouseDown="ProgressBar_PreviewMouseDown" PreviewMouseUp="ProgressBar_PreviewMouseUp"/>
                            <Grid Grid.Row="1">
                                <TextBlock Text="{Binding FormattedTime}" Foreground="#888899" FontSize="11" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding CurrentLyrics.Source, StringFormat='Sumber: {0}'}" Foreground="#666677" FontSize="10" HorizontalAlignment="Left"/>
                            </Grid>
                        </Grid>

                        <!-- Media Controls (Previous, Play/Pause, Next) -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,8">
                            <Button Style="{StaticResource ControlButtonStyle}" Command="{Binding PreviousCommand}" Width="36" Height="36" ToolTip="Sebelumnya">
                                <Path Data="M 0 0 H 2.5 V 12 H 0 Z M 11 0 L 3 6 L 11 12 Z" Fill="#EEEEEE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource ControlButtonStyle}" Command="{Binding TogglePlayPauseCommand}" 
                                    Width="44" Height="44" Margin="12,0" Padding="0" ToolTip="Putar / Jeda">
                                <Border Width="40" Height="40" CornerRadius="20" Background="#FFFFFF">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Play icon (triangle) -->
                                        <Path Data="M 0 0 L 13 8 L 0 16 Z" Fill="#000000" Margin="2,0,0,0"
                                              Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible, TargetNullValue=Visible}"/>
                                        <!-- Pause icon (two bars) -->
                                        <Path Data="M 0 0 H 4 V 14 H 0 Z M 7 0 H 11 V 14 H 7 Z" Fill="#000000"
                                              Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
                                    </Grid>
                                </Border>
                            </Button>
                            <Button Style="{StaticResource ControlButtonStyle}" Command="{Binding NextCommand}" Width="36" Height="36" ToolTip="Berikutnya">
                                <Path Data="M 0 0 L 8 6 L 0 12 Z M 8.5 0 H 11 V 12 H 8.5 Z" Fill="#EEEEEE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <!-- Quick Tools (Offset, Import) -->
                        <Grid Grid.Row="4" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Offset controls -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Offset:" Foreground="#777788" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OffsetSubtractCommand}" Content="-0.5s" ToolTip="Lirik terlambat (geser mundur)"/>
                                <TextBlock Text="{Binding ManualOffsetSeconds, StringFormat='{}{0:0.0}s'}" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OffsetAddCommand}" Content="+0.5s" ToolTip="Lirik terlalu cepat (geser maju)"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OffsetResetCommand}" Content="Reset" ToolTip="Reset offset ke 0s"/>
                            </StackPanel>

                            <!-- Import LRC / TXT -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding ImportLyricsCommand}" Content="Impor File (.lrc/.txt)"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ===== PEMISAH VERTIKAL 1: MUSIK | WAKTU SHOLAT ===== -->
                    <Border Grid.Column="1" Width="1" Background="#222228" Margin="10,2"
                            Visibility="{Binding ShowExpandedPrayerDivider1, Converter={StaticResource BoolToVis}}"/>

                    <!-- ===== KOLOM 2: WAKTU SHOLAT (EXPANDED) ===== -->
                    <Grid Grid.Column="2" Visibility="{Binding ShowPrayerSectionInMainWindow, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="Auto"/> <!-- Next Prayer Card -->
                            <RowDefinition Height="*"/>    <!-- Daily Schedule List -->
                            <RowDefinition Height="Auto"/> <!-- Status / Footer -->
                        </Grid.RowDefinitions>

                        <!-- Header: Icon, Waktu Sholat, Kota, Tanggal Hijriah, Lepas -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource MetallicIconBadgeBgBrush}"
                                            BorderBrush="{StaticResource MetallicIconBadgeBorderBrush}" BorderThickness="1" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource LuxuryPrayerIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                              Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Waktu Sholat" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Background="#1C1C24" CornerRadius="4" Padding="5,1" Margin="0,0,5,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentPrayerSchedule.CityName}" Foreground="#CCCCCC" FontSize="9.5" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding CurrentPrayerSchedule.HijriDate}" FontSize="9.5" Foreground="#888899" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding DetachPrayerCommand}"
                                        Content="⧉" ToolTip="Lepas Waktu Sholat ke jendela terpisah" Margin="0,0,3,0"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenSettingsCommand}" Content="⚙" ToolTip="Pengaturan Waktu Sholat" Margin="0,0,3,0"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding ClosePrayerCommand}" Content="✕" ToolTip="Tutup Waktu Sholat"/>
                            </StackPanel>
                        </Grid>

                        <!-- Highlight Next Prayer Card -->
                        <Border Grid.Row="1" Background="#14141A" BorderBrush="#282836" BorderThickness="1.2" 
                                CornerRadius="10" Padding="10,6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="WAKTU BERIKUTNYA" FontSize="8.5" FontWeight="Bold" Foreground="#888899" Margin="0,0,0,1"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding NextPrayerName}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding NextPrayerTimeFormatted}" FontSize="15" FontWeight="Light" Foreground="#DDDDDD"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#20202A" CornerRadius="6" Padding="6,3" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="HITUNG MUNDUR" FontSize="7.5" FontWeight="Bold" Foreground="#777788" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding NextPrayerCountdownBadge}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Today's Schedule Cards List -->
                        <Border Grid.Row="2" Background="#0C0C0F" CornerRadius="10" Padding="5,4" Height="172">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding CurrentPrayerSchedule.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="8,4" Margin="0,1,0,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#121216"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                <Setter Property="Background" Value="#1E1E28"/>
                                                                <Setter Property="BorderBrush" Value="#444458"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#DDDDDD"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" FontSize="11.5" FontWeight="Bold" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                        <Setter Property="FontSize" Value="12"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Border Grid.Column="2" CornerRadius="4" Padding="5,1.5" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#18181F"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                        <Setter Property="Background" Value="#2A2A38"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding CountdownText}" FontSize="9" FontWeight="Medium">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#777788"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Footer: Pengingat Status -->
                        <Grid Grid.Row="3" Margin="2,4,2,0">
                            <TextBlock Text="Pengingat: -10m • Adzan • +15m" FontSize="9.5" Foreground="#666677" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- ===== PEMISAH VERTIKAL 2: WAKTU SHOLAT | TO-DO ===== -->
                    <Border Grid.Column="3" Width="1" Background="#222228" Margin="10,2"
                            Visibility="{Binding ShowExpandedPrayerDivider2, Converter={StaticResource BoolToVis}}"/>

                    <!-- ===== SISI KANAN: TO-DO LIST ===== -->
                    <Grid Grid.Column="4" Margin="0,0,2,0" Visibility="{Binding ShowTodoSectionInMainWindow, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="Auto"/> <!-- Filter Tabs -->
                            <RowDefinition Height="Auto"/> <!-- Input New Task -->
                            <RowDefinition Height="*"/>    <!-- Task List -->
                        </Grid.RowDefinitions>

                        <!-- Header: Judul, Ringkasan, dan Tombol Tutup -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Tombol Pin & Pengaturan saat mode Hanya To-Do (Music disembunyikan) -->
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding TogglePinCommand}" ToolTip="Pin agar tetap terbuka"
                                        Visibility="{Binding ShowMusicSection, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,4,0">
                                    <TextBlock Text="📌" FontSize="10"/>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding ToggleComponentsMenuCommand}" ToolTip="Kelola komponen notch"
                                        Visibility="{Binding ShowMusicSection, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,4,0">
                                    <TextBlock Text="🍱" FontSize="10"/>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenSettingsCommand}" Content="⚙" ToolTip="Pengaturan"
                                        Visibility="{Binding ShowMusicSection, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,4,0"/>

                                <!-- Tombol Lepas Jendela To-Do ke jendela melayang tersendiri -->
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding DetachTodoCommand}"
                                        Content="⧉" ToolTip="Lepas To-Do List ke jendela terpisah" Margin="0,0,4,0"/>

                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding ClearCompletedTodosCommand}" 
                                        Visibility="{Binding HasCompletedTodos, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Hapus semua tugas yang selesai" Padding="6,2" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🗑" FontSize="10" Margin="0,0,3,0"/>
                                        <TextBlock Text="Bersihkan" FontSize="10.5"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" CommandParameter="Compact" Content="▴" ToolTip="Tutup ke Compact" Margin="0,0,3,0"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding CloseTodoCommand}" Content="✕" ToolTip="Tutup To-Do List" Margin="0"/>

                                <!-- Pembatas Garis: To-Do List | Browser -->
                                <Border Width="1.2" Height="20" Background="#2C2C3A" Margin="7,0" VerticalAlignment="Center"
                                        ToolTip="Batas modular komponen To-Do List &amp; Browser"/>

                                <!-- Komponen Browser Mengambang -->
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenFloatingBrowserCommand}"
                                        ToolTip="Buka Browser Mengambang (YouTube, Streaming Film, Web Bebas)" Padding="8,4" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource LuxuryBrowserIconGeometry}" Stroke="{StaticResource MetallicSilverBrush}"
                                              StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Browser" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Tombol Close Aplikasi di ujung sebelah kanan -->
                                <Button Style="{StaticResource CloseAppButtonStyle}" Command="{Binding ExitApplicationCommand}"
                                        Content="✕" ToolTip="Tutup Aplikasi DRANOTCH" Padding="7,4" Margin="0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource MetallicIconBadgeBgBrush}"
                                        BorderBrush="{StaticResource MetallicIconBadgeBorderBrush}" BorderThickness="1" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource LuxuryTodoIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                          Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="To-Do List" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Background="#1A1A20" CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TodoSummaryText}" Foreground="#CCCCCC" FontSize="10.5" FontWeight="Medium"/>
                                </Border>

                                <!-- Tombol Status Google Drive (Klik untuk Login / Sync) -->
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding SyncGoogleDriveCommand}"
                                        ToolTip="{Binding GoogleDriveSyncTooltip}" Padding="6,2" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="☁" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFAA44"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGoogleDriveConnected}" Value="True">
                                                            <Setter Property="Foreground" Value="#4CD964"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding GoogleDriveStatusButtonText}" FontSize="10" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#BBBBCC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGoogleDriveConnected}" Value="True">
                                                            <Setter Property="Foreground" Value="#EEEEEE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- Filter Tabs -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource FilterPillStyle}" Command="{Binding SetTodoFilterCommand}" CommandParameter="All">
                                    <TextBlock Text="Semua">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAllFilterSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Style="{StaticResource FilterPillStyle}" Command="{Binding SetTodoFilterCommand}" CommandParameter="Active">
                                    <TextBlock Text="Aktif">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActiveFilterSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Style="{StaticResource FilterPillStyle}" Command="{Binding SetTodoFilterCommand}" CommandParameter="Completed">
                                    <TextBlock Text="Selesai">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompletedFilterSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </StackPanel>

                            <!-- Kategori Filter Chips (Tampil jika ada kategori) -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasCategories, Converter={StaticResource BoolToVis}}" Margin="0,5,0,0">
                                <ItemsControl ItemsSource="{Binding AvailableCategories}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource FilterPillStyle}"
                                                    Command="{Binding DataContext.SetCategoryFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Margin="0,0,4,0" Padding="6,1.5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="#" Foreground="#888888" FontSize="9" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="#B0B0C0"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Input Tugas Baru (Dengan Pilihan Kategori) -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <!-- Dropdown / Input Kategori -->
                                <ColumnDefinition Width="95"/>
                                <!-- Input Teks Tugas -->
                                <ColumnDefinition Width="*"/>
                                <!-- Tombol Tambah (+) -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Pilihan Kategori Dropdown / Input -->
                            <ComboBox Grid.Column="0" 
                                      IsEditable="True"
                                      ItemsSource="{Binding ExistingCategories}"
                                      Text="{Binding NewTodoCategory, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource DarkCategoryComboBoxStyle}"
                                      Margin="0,0,5,0" VerticalAlignment="Center"
                                      ToolTip="Pilih atau ketik kategori/tag tugas (misal: MARIBON)"/>

                            <!-- Input Teks Tugas -->
                            <Grid Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBox x:Name="NewTodoTextBox" 
                                         Text="{Binding NewTodoTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TodoTextBoxStyle}" VerticalAlignment="Center">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding AddTodoCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <!-- Placeholder / Watermark -->
                                <TextBlock Text="Tulis tugas lalu Enter..." Foreground="#666677" FontSize="11"
                                           IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewTodoTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Tombol Tambah (+) -->
                            <Button Grid.Column="2" Command="{Binding AddTodoCommand}" ToolTip="Tambah Tugas"
                                    Background="#FFFFFF" Foreground="#000000" Width="28" Height="28" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                       FontWeight="Bold" FontSize="15" Foreground="#000000"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Daftar Tugas (Scrollable) -->
                        <Border Grid.Row="3" Background="#0E0E12" CornerRadius="10" Padding="6,4" Height="172">
                            <Grid>
                                <!-- Tampilan saat kosong -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding FilteredTodos.IsEmpty, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="🎉" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Tidak ada tugas saat ini" Foreground="#666677" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- List Item -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                    <ItemsControl ItemsSource="{Binding FilteredTodos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#141418" CornerRadius="8" Padding="6,5" Margin="0,2,0,2"
                                                        helpers:TodoDragDropBehavior.IsEnabled="True">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#1C1C22"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <!-- Drag Handle Grip -->
                                                            <ColumnDefinition Width="Auto"/>
                                                            <!-- Checkbox -->
                                                            <ColumnDefinition Width="Auto"/>
                                                            <!-- Judul Tugas & Kategori Tag -->
                                                            <ColumnDefinition Width="*"/>
                                                            <!-- Tombol Hapus -->
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Drag Grip Handle ⋮⋮ -->
                                                        <Border Grid.Column="0" Width="14" Height="20" Background="Transparent" Cursor="SizeAll"
                                                                VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="Tahan dan geser naik/turun untuk ubah urutan">
                                                            <TextBlock Text="⋮⋮" Foreground="#555566" FontSize="11" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Checkbox -->
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                                  Style="{StaticResource TodoCheckBoxStyle}"
                                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                        <!-- Judul Tugas & Kategori Tag (Mode Tampilan) -->
                                                        <DockPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand"
                                                                   ToolTip="Klik dua kali atau klik ikon pensil untuk mengedit tugas"
                                                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                            <DockPanel.InputBindings>
                                                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding StartEditCommand}"/>
                                                            </DockPanel.InputBindings>

                                                            <!-- Tag / Kategori Badge -->
                                                            <Border DockPanel.Dock="Left" Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}"
                                                                    Background="#1E1E24" BorderBrush="#363640" BorderThickness="1"
                                                                    CornerRadius="4" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Category}" Foreground="#DDDDDD" FontSize="9.5" FontWeight="Bold"/>
                                                            </Border>

                                                            <!-- Teks Tugas -->
                                                            <TextBlock Text="{Binding TaskText}" VerticalAlignment="Center"
                                                                       FontSize="11.5" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#E2E2EA"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                <Setter Property="Foreground" Value="#666677"/>
                                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DockPanel>

                                                        <!-- Mode Edit Inline -->
                                                        <Grid Grid.Column="2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                              Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource TodoTextBoxStyle}"
                                                                     FontSize="11.5" Padding="6,3" VerticalAlignment="Center"
                                                                     ToolTip="Tekan Enter untuk simpan, Esc untuk batal">
                                                                <TextBox.InputBindings>
                                                                    <KeyBinding Key="Enter" Command="{Binding SaveEditCommand}"/>
                                                                    <KeyBinding Key="Esc" Command="{Binding CancelEditCommand}"/>
                                                                </TextBox.InputBindings>
                                                            </TextBox>
                                                        </Grid>

                                                        <!-- Tombol Aksi saat Normal (Edit ✎ & Hapus ×) -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                            <Button Command="{Binding StartEditCommand}"
                                                                    Style="{StaticResource TodoDeleteButtonStyle}"
                                                                    ToolTip="Edit tugas" Width="20" Height="20" Margin="0,0,2,0">
                                                                <TextBlock Text="✎" FontSize="11" Foreground="#777788" Margin="0,-1,0,0"/>
                                                            </Button>
                                                            <Button Command="{Binding DeleteCommand}"
                                                                    Style="{StaticResource TodoDeleteButtonStyle}"
                                                                    ToolTip="Hapus tugas" Width="20" Height="20">
                                                                <TextBlock Text="×" FontSize="14" FontWeight="Bold" Margin="0,-2,0,0"/>
                                                            </Button>
                                                        </StackPanel>

                                                        <!-- Tombol Aksi saat Mode Edit (Simpan ✓ & Batal ✕) -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                            <Button Command="{Binding SaveEditCommand}"
                                                                    Style="{StaticResource TodoDeleteButtonStyle}"
                                                                    ToolTip="Simpan (Enter)" Width="20" Height="20" Margin="0,0,2,0">
                                                                <TextBlock Text="✓" FontSize="12" Foreground="#4CD964" FontWeight="Bold"/>
                                                            </Button>
                                                            <Button Command="{Binding CancelEditCommand}"
                                                                    Style="{StaticResource TodoDeleteButtonStyle}"
                                                                    ToolTip="Batal (Esc)" Width="20" Height="20">
                                                                <TextBlock Text="✕" FontSize="11" Foreground="#FF4D6D"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== TAMPILAN KHUSUS WAKTU SHOLAT ===== -->
                <Grid Visibility="{Binding ShowPrayerExpandedContent, Converter={StaticResource BoolToVis}}" Width="412" Margin="4,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Highlight Next Prayer Card -->
                        <RowDefinition Height="*"/>    <!-- Today's Schedule Cards -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Actions & Status -->
                    </Grid.RowDefinitions>

                    <!-- Header: Title, City, Hijri Date, Back Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource MetallicIconBadgeBgBrush}"
                                        BorderBrush="{StaticResource MetallicIconBadgeBorderBrush}" BorderThickness="1" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource LuxuryPrayerIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                          Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Waktu Sholat" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <Border Background="#1C1C24" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentPrayerSchedule.CityName}" Foreground="#CCCCCC" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentPrayerSchedule.HijriDate}" FontSize="11" Foreground="#888899" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding DetachPrayerCommand}" Content="⧉" ToolTip="Lepas Waktu Sholat ke Jendela Sendiri" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenSettingsCommand}" Content="⚙" ToolTip="Pengaturan Waktu Sholat" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding TogglePrayerPanelCommand}" Content="✕" ToolTip="Kembali ke Pemutar"/>
                        </StackPanel>
                    </Grid>

                    <!-- Next Prayer Countdown Banner Card -->
                    <Border Grid.Row="1" Background="#14141A" BorderBrush="#282836" BorderThickness="1.2" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="WAKTU BERIKUTNYA" FontSize="9.5" FontWeight="Bold" Foreground="#888899" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding NextPrayerName}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding NextPrayerTimeFormatted}" FontSize="18" FontWeight="Light" Foreground="#DDDDDD"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#20202A" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="HITUNG MUNDUR" FontSize="8.5" FontWeight="Bold" Foreground="#777788" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding NextPrayerCountdownBadge}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Schedule Cards Grid (Imsak, Subuh, Terbit, Dzuhur, Ashar, Maghrib, Isya) -->
                    <Border Grid.Row="2" Background="#0C0C0F" CornerRadius="10" Padding="8,6" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding CurrentPrayerSchedule.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="10,6" Margin="0,2,0,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#121216"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                        <Setter Property="Background" Value="#1E1E28"/>
                                                        <Setter Property="BorderBrush" Value="#444458"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#DDDDDD"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" FontSize="13" FontWeight="Bold" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                <Setter Property="FontSize" Value="13.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Border Grid.Column="2" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#18181F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                <Setter Property="Background" Value="#2A2A38"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding CountdownText}" FontSize="10" FontWeight="Medium">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#777788"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Bottom Status & Actions -->
                    <DockPanel Grid.Row="3" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallPillButton}" Command="{Binding TogglePrayerPanelCommand}" 
                                Content="← Kembali" Padding="10,4" Margin="6,0,0,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Pengingat aktif: Sebelum (-10m) • Saat Adzan • Sesudah (+15m)" FontSize="10" Foreground="#666677"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Grid>

                <!-- ================= MODE 3: LYRICS (LUXURY MAC KARAOKE STAGE) ================= -->
                <Grid x:Name="LyricsView" Visibility="{Binding IsLyricsMode, Converter={StaticResource BoolToVis}}" 
                      Width="640" Height="400" Margin="24,18,24,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar (Album Art + Crisp Track Info + Mode Pills without Click-Through) -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Luxury Squircle Album Art -->
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" ClipToBounds="True"
                                Background="#14141C" BorderBrush="#36FFFFFF" BorderThickness="1.2" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Grid>
                                <Image Source="pack://application:,,,/NotchMusic;component/Assets/app.png" Width="26" Height="26" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Image Source="{Binding CurrentTrack.Thumbnail}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='DRANOTCH'}"
                                       FontWeight="Bold" FontSize="17" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentTrack.Artist, FallbackValue='Siap memutar musik...'}"
                                       FontSize="13" FontWeight="Medium" Foreground="#A6A6BA" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" CommandParameter="Expanded"
                                    Content="Expanded" FontSize="12.5" Padding="14,6" Margin="0,0,6,0" ToolTip="Buka Panel Penuh"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" CommandParameter="Compact"
                                    Content="Compact" FontSize="12.5" Padding="14,6" Margin="0,0,6,0" ToolTip="Kembali ke Notch"/>
                            <Button Style="{StaticResource CloseAppButtonStyle}" Command="{Binding ExitApplicationCommand}"
                                    Content="✕" FontSize="12.5" Padding="10,6" Margin="0" ToolTip="Tutup Aplikasi DRANOTCH"/>
                        </StackPanel>
                    </Grid>

                    <!-- Big Central Focused Lyrics Stage (Obsidian Velvet Glass) -->
                    <Border Grid.Row="1" BorderBrush="#2C2C3E" BorderThickness="1.2" CornerRadius="18" Padding="24,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0D0D14" Offset="0.0"/>
                                <GradientStop Color="#07070B" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid VerticalAlignment="Center">
                            <!-- Standby / Empty State when no track is playing -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasTrack, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="♪" FontSize="32" FontWeight="Bold" Foreground="#4A4A64" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Belum Ada Lagu yang Diputar" FontSize="16" FontWeight="Bold" Foreground="#EDEDF6" HorizontalAlignment="Center"/>
                                <TextBlock Text="Putar musik dari YouTube Music, Spotify, atau browser untuk menampilkan lirik karaoke otomatis."
                                           FontSize="12.5" Foreground="#88889E" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="0,6,0,16"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenYouTubeMusicCommand}"
                                            Padding="14,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶" Foreground="#FF4D6D" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Buka YT Music" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Active Track Lyrics Container -->
                            <Grid Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}">
                                <!-- Synced 3-Line Display -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsLyricsSynced, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding PreviousLyric}" FontSize="15.5" FontWeight="Medium" Foreground="#62627A"
                                               TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>
                                    <TextBlock Text="{Binding ActiveLyric}" FontSize="{Binding Settings.LyricsFontSize}" Foreground="#FFFFFF"
                                               FontWeight="ExtraBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#FFFFFF" BlurRadius="14" ShadowDepth="0" Opacity="0.22"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="{Binding NextLyric}" FontSize="15.5" FontWeight="Medium" Foreground="#62627A"
                                               TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,14,0,0"/>
                                </StackPanel>

                                <!-- Unsynced / Plain Lyrics Display -->
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding IsLyricsSynced, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="{Binding ActiveLyric}" FontSize="15.5" FontWeight="Medium" Foreground="#E4E4F0"
                                               TextAlignment="Center" TextWrapping="Wrap" LineHeight="26"/>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Bottom Bar (Luxury Vector Transport Controls, Time, & Offset) -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding PreviousCommand}" Width="38" Height="34" Padding="0" ToolTip="Sebelumnya" Margin="0,0,6,0">
                                <Path Data="M 0 0 H 2.2 V 11 H 0 Z M 10 0 L 2.8 5.5 L 10 11 Z" Fill="#F0F0F8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource ControlButtonStyle}" Command="{Binding TogglePlayPauseCommand}" Width="40" Height="38" Padding="0" ToolTip="Putar / Jeda" Margin="0,0,6,0">
                                <Border Width="36" Height="36" CornerRadius="18" Background="#FFFFFF">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M 0 0 L 11 6.5 L 0 13 Z" Fill="#000000" Margin="2,0,0,0"
                                              Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible, TargetNullValue=Visible}"/>
                                        <Path Data="M 0 0 H 3.5 V 12 H 0 Z M 6.2 0 H 9.7 V 12 H 6.2 Z" Fill="#000000"
                                              Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
                                    </Grid>
                                </Border>
                            </Button>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding NextCommand}" Width="38" Height="34" Padding="0" ToolTip="Berikutnya" Margin="0">
                                <Path Data="M 0 0 L 7.2 5.5 L 0 11 Z M 7.8 0 H 10 V 11 H 7.8 Z" Fill="#F0F0F8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" Foreground="#9898B0" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding OffsetSubtractCommand}" Content="-0.5s" FontSize="12" Padding="11,6"/>
                            <TextBlock Text="{Binding ManualOffsetSeconds, StringFormat='{}{0:0.0}s'}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding OffsetAddCommand}" Content="+0.5s" FontSize="12" Padding="11,6"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= FLOATING ISLAND PRAYER NOTIFICATION BANNER ================= -->
                <Border Visibility="{Binding HasActivePrayerNotification, Converter={StaticResource BoolToVis}}"
                        Background="#0D0D11" BorderBrush="#343444" BorderThickness="1.5" CornerRadius="22"
                        Padding="12,6" Margin="4,2" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#1C1C26" Margin="0,0,10,0">
                            <TextBlock Text="🕌" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Background="#242434" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActivePrayerNotification.PrayerTimeFormatted}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding ActivePrayerNotification.Title}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding ActivePrayerNotification.Message}" Foreground="#CCCCCC" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Dismiss button -->
                        <Button Grid.Column="2" Command="{Binding DismissPrayerNotificationCommand}"
                                Style="{StaticResource SmallPillButton}" Content="×" ToolTip="Tutup Notifikasi"
                                Width="24" Height="24" Padding="0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Left Top Bezel Concave Ear (Mac-Style Larger Luxury Concave Fillet 28x28) -->
        <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Top" Margin="0,0,-1.4,0" IsHitTestVisible="False">
            <Path Data="M 0,0 L 28,0 L 28,28 C 28,12.54 15.46,0 0,0 Z" Fill="#000000"/>
            <Path Data="M 28,28 C 28,12.54 15.46,0 0,0" Stroke="#242432" StrokeThickness="1.2"/>
        </Grid>

        <!-- Right Top Bezel Concave Ear (Mac-Style Larger Luxury Concave Fillet 28x28) -->
        <Grid Grid.Column="2" Width="28" Height="28" VerticalAlignment="Top" Margin="-1.4,0,0,0" IsHitTestVisible="False">
            <Path Data="M 0,0 L 28,0 C 12.54,0 0,12.54 0,28 Z" Fill="#000000"/>
            <Path Data="M 28,0 C 12.54,0 0,12.54 0,28" Stroke="#242432" StrokeThickness="1.2"/>
        </Grid>
    </Grid>
</Window>
