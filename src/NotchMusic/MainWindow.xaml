<Window x:Class="NotchMusic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NotchMusic.Helpers"
        Title="DRANOTCH"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        Loaded="Window_Loaded">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <helpers:BoolToStrikethroughConverter x:Key="BoolToStrike"/>
        <helpers:CountToVisibilityConverter x:Key="CountToVis"/>
        <helpers:CountToVisibilityConverter x:Key="InverseCountToVis" Invert="True"/>

        <!-- Button style for sleek media controls -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallPillButton" TargetType="Button">
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A4D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill for To-Do -->
        <Style x:Key="FilterPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C1828"/>
            <Setter Property="Foreground" Value="#888899"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#2E2840"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom CheckBox for To-Do -->
        <Style x:Key="TodoCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="BoxBorder" Width="18" Height="18" CornerRadius="5"
                                Background="#1C1829" BorderBrush="#4A3F63" BorderThickness="1.2">
                            <Path x:Name="CheckMark" Data="M 3 8 L 7 12 L 14 4" Stroke="#FFFFFF" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#AF78FF"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#AF78FF"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#AF78FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete Button for To-Do Item -->
        <Style x:Key="TodoDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555566"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DelBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DelBorder" Property="Background" Value="#33FF4D6D"/>
                                <Setter Property="Foreground" Value="#FF6B8B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox for To-Do -->
        <Style x:Key="TodoTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#161622"/>
            <Setter Property="Foreground" Value="#EDEDF5"/>
            <Setter Property="BorderBrush" Value="#3A2E50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#AF78FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="#AF78FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Category ComboBox Style -->
        <Style x:Key="DarkCategoryComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#161622"/>
            <Setter Property="Foreground" Value="#D5B6FF"/>
            <Setter Property="BorderBrush" Value="#3A2E50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Editable Text / Selected Value -->
                                    <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                             Background="Transparent" Foreground="#D5B6FF"
                                             BorderThickness="0" Padding="6,3" VerticalAlignment="Center"
                                             FontSize="11" CaretBrush="#AF78FF"/>

                                    <!-- Placeholder when empty -->
                                    <TextBlock Grid.Column="0" Text="Kategori ▾" Foreground="#666677" FontSize="10.5"
                                               IsHitTestVisible="False" Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PART_EditableTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Toggle Dropdown Button -->
                                    <ToggleButton Grid.Column="1" Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="#8A75B0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!-- Popup Dropdown List -->
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PopupAnimation="Slide">
                                <Border Background="#1A1826" BorderBrush="#443460" BorderThickness="1" CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="160" Padding="3" Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#7754B5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#E2E2EA"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#32224A"/>
                                            <Setter Property="Foreground" Value="#AF78FF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#412966"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Outer Container with DropShadow -->
    <Grid Margin="12">
        <Border x:Name="MainIslandBorder"
                Background="#101014"
                BorderBrush="#382E4D"
                BorderThickness="1.2"
                CornerRadius="24"
                MouseDown="Island_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.6"/>
            </Border.Effect>

            <Grid>
                <!-- ================= MODE 1A: COMPACT (MUSIC & OPTIONAL TO-DO TICKER) ================= -->
                <Grid x:Name="CompactView" Visibility="{Binding ShowCompactMusicView, Converter={StaticResource BoolToVis}}" 
                      Height="48" MinWidth="340" MaxWidth="620" Margin="8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Album Art / Placeholder -->
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Margin="2,0,8,0" ClipToBounds="True" Background="#282236">
                        <Grid>
                            <TextBlock Text="♪" Foreground="#AF78FF" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding CurrentTrack.Thumbnail}" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <!-- Track Title & Live Standby Lyrics -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <!-- Baris 1: Judul dan Artis -->
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="{Binding CurrentTrack.Artist, FallbackValue=''}" 
                                       Foreground="#8A7E99" FontSize="10.5" DockPanel.Dock="Right" 
                                       VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='DRANOTCH'}" 
                                       Foreground="#F5F5FA" FontWeight="SemiBold" FontSize="12.5"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <!-- Baris 2: Lirik Real-Time Saat Standby -->
                        <Grid Margin="0,2,0,0" ToolTip="{Binding StandbyLyric}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="♪" Foreground="#AF78FF" FontSize="10" FontWeight="Bold" 
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding StandbyLyric, FallbackValue='Siap memutar...'}" 
                                       Foreground="#E2CAFF" FontSize="11.5" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Playing wave/activity indicator -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,6,0"
                                Visibility="{Binding CurrentTrack.IsPlaying, Converter={StaticResource BoolToVis}}">
                        <Rectangle Width="2" Height="10" Fill="#AF78FF" Margin="1,0"/>
                        <Rectangle Width="2" Height="14" Fill="#AF78FF" Margin="1,0"/>
                        <Rectangle Width="2" Height="8" Fill="#AF78FF" Margin="1,0"/>
                    </StackPanel>

                    <!-- To-Do Ticker Container (di samping kontrol musik saat minimize / compact) -->
                    <Border Grid.Column="3" Background="#161222" BorderBrush="#3A2D52" BorderThickness="1.2"
                            CornerRadius="12" Height="32" Margin="4,0,6,0" Padding="6,2"
                            MinWidth="130" MaxWidth="220" Cursor="Hand"
                            Visibility="{Binding ShowTodoTicker, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding CurrentTickerText, StringFormat='To-Do: {0} (Klik untuk buka panel)'}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetModeCommand}" CommandParameter="Expanded"/>
                        </Border.InputBindings>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <!-- Checkmark / Quick Complete Button -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Badge Nomor Tugas (misal: 1/3) -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Badge Kategori / Tag jika ada -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Teks Ticker Berjalan/Berganti -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tombol Cepat Selesai jika ada tugas tertunda -->
                            <Button Grid.Column="0" Command="{Binding CompleteCurrentTickerCommand}"
                                    ToolTip="Tandai tugas ini selesai" Style="{StaticResource ControlButtonStyle}"
                                    Padding="0" Margin="0,0,4,0" Width="18" Height="18" VerticalAlignment="Center"
                                    Visibility="{Binding HasPendingTodos, Converter={StaticResource BoolToVis}}">
                                <Border Width="16" Height="16" CornerRadius="4" Background="#261E38" BorderBrush="#7754B5" BorderThickness="1">
                                    <TextBlock Text="✓" Foreground="#C8A5FF" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>

                            <!-- Ikon ✓ jika tidak ada tugas tertunda -->
                            <TextBlock Grid.Column="0" Text="✓" Foreground="#8A75B0" FontWeight="Bold" FontSize="11"
                                       VerticalAlignment="Center" Margin="2,0,4,0"
                                       Visibility="{Binding HasPendingTodos, Converter={StaticResource InverseBoolToVis}}"/>

                            <!-- Badge Indeks (misal 1/3) -->
                            <Border Grid.Column="1" Background="#2B1E44" CornerRadius="5" Padding="4,1" Margin="0,0,4,0"
                                    VerticalAlignment="Center" Visibility="{Binding HasPendingTodos, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding CurrentTickerBadge}" Foreground="#D5B6FF" FontSize="9.5" FontWeight="SemiBold"/>
                            </Border>

                            <!-- Badge Kategori / Tag pada Ticker jika ada -->
                            <Border Grid.Column="2" Background="#381D4A" BorderBrush="#9E5FC9" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding CurrentTickerItem.HasCategory, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding CurrentTickerItem.Category}" Foreground="#FFD1F5" FontSize="9" FontWeight="Bold"/>
                            </Border>

                            <!-- Teks Judul Tugas yang Berganti secara Ticker -->
                            <TextBlock Grid.Column="3" Text="{Binding CurrentTickerText, NotifyOnTargetUpdated=True}" 
                                       Foreground="#EDEDF5" FontSize="11.5" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1.0" Duration="0:0:0.35"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Play / Pause Button & Expand trigger -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ControlButtonStyle}" Command="{Binding TogglePlayPauseCommand}" Width="28" Height="28" ToolTip="Putar / Jeda">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Play icon (when paused) -->
                                <Path Data="M 0 0 L 10 6 L 0 12 Z" Fill="#AF78FF" Margin="2,0,0,0"
                                      Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible, TargetNullValue=Visible}"/>
                                <!-- Pause icon (when playing) -->
                                <Path Data="M 0 0 H 3 V 11 H 0 Z M 5.5 0 H 8.5 V 11 H 5.5 Z" Fill="#AF78FF"
                                      Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" CommandParameter="Expanded" Content="▾" ToolTip="Perluas Panel"/>
                    </StackPanel>
                </Grid>

                <!-- ================= MODE 1B: COMPACT (TODO ONLY NOTCH) ================= -->
                <Grid x:Name="CompactTodoView" Visibility="{Binding ShowCompactTodoOnlyView, Converter={StaticResource BoolToVis}}" 
                      Height="48" MinWidth="260" MaxWidth="440" Margin="8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- To-Do Icon Badge -->
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Margin="2,0,8,0" Background="#261E38" BorderBrush="#7754B5" BorderThickness="1">
                        <TextBlock Text="✓" Foreground="#C8A5FF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Ticker Task Info (Click to Expand) -->
                    <Border Grid.Column="1" Background="#161222" BorderBrush="#3A2D52" BorderThickness="1.2"
                            CornerRadius="12" Height="32" Margin="0,0,6,0" Padding="8,2" Cursor="Hand"
                            ToolTip="{Binding CurrentTickerText, StringFormat='To-Do: {0} (Klik untuk buka daftar)'}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetModeCommand}" CommandParameter="Expanded"/>
                        </Border.InputBindings>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Badge Indeks -->
                            <Border Grid.Column="0" Background="#2B1E44" CornerRadius="5" Padding="4,1" Margin="0,0,5,0"
                                    VerticalAlignment="Center" Visibility="{Binding HasPendingTodos, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding CurrentTickerBadge}" Foreground="#D5B6FF" FontSize="9.5" FontWeight="SemiBold"/>
                            </Border>

                            <!-- Badge Kategori jika ada -->
                            <Border Grid.Column="1" Background="#381D4A" BorderBrush="#9E5FC9" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="0,0,5,0"
                                    VerticalAlignment="Center" Visibility="{Binding CurrentTickerItem.HasCategory, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding CurrentTickerItem.Category}" Foreground="#FFD1F5" FontSize="9" FontWeight="Bold"/>
                            </Border>

                            <TextBlock Grid.Column="2" Text="{Binding CurrentTickerText}" Foreground="#EDEDF5" FontSize="11.5" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Quick Complete Button -->
                    <Button Grid.Column="2" Command="{Binding CompleteCurrentTickerCommand}"
                            ToolTip="Tandai tugas selesai" Style="{StaticResource ControlButtonStyle}"
                            Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,4,0"
                            Visibility="{Binding HasPendingTodos, Converter={StaticResource BoolToVis}}">
                        <Border Width="22" Height="22" CornerRadius="6" Background="#261E38" BorderBrush="#7754B5" BorderThickness="1">
                            <TextBlock Text="✓" Foreground="#C8A5FF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>

                    <!-- Actions (Expand & Settings) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" CommandParameter="Expanded" Content="▾" ToolTip="Perluas To-Do"/>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenSettingsCommand}" Content="⚙" ToolTip="Pengaturan" Margin="2,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ================= MODE 2: EXPANDED (SIDE-BY-SIDE: MUSIC & TO-DO) ================= -->
                <Grid x:Name="ExpandedView" Visibility="{Binding IsExpandedMode, Converter={StaticResource BoolToVis}}" 
                      Width="{Binding ExpandedPanelWidth}" Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <!-- Kolom Kiri: Pemutar Musik -->
                        <ColumnDefinition Width="{Binding MusicColumnWidth}"/>
                        <!-- Garis Pemisah Vertikal -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Kolom Kanan: To-Do List -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== SISI KIRI: PEMUTAR MUSIK ===== -->
                    <Grid Grid.Column="0" Visibility="{Binding ShowMusicSection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Session info & Tools -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Album art -->
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" ClipToBounds="True" Background="#22222E" Margin="0,0,12,0">
                                <Image Source="{Binding CurrentTrack.Thumbnail}" Stretch="UniformToFill"/>
                            </Border>

                            <!-- Track Title, Artist, Session -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='Tidak ada lagu'}" 
                                           Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CurrentTrack.Artist, FallbackValue='-'}" 
                                           Foreground="#D0B5FF" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding SessionStatus}" 
                                           Foreground="#777788" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Top actions (Update, YouTube Music, Pin, Lyrics, Settings) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource SmallPillButton}" 
                                        Command="{Binding OpenUpdateCommand}" 
                                        Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVis}}" 
                                        ToolTip="Versi baru tersedia! Klik untuk memperbarui DRANOTCH" 
                                        Background="#4D1D4A" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✨" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AvailableUpdateVersion, StringFormat='Update {0}'}" 
                                                   Foreground="#FFAEF2" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenYouTubeMusicCommand}" ToolTip="Buka Pemutar YouTube Music" Background="#361E2E">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▶" Foreground="#FF4D6D" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="YT Music" Foreground="#FFD0DD" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding TogglePinCommand}" ToolTip="Pin agar tetap terbuka">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📌" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBlock Text="Pin" FontSize="11" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#888899"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Foreground" Value="#AF78FF"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" CommandParameter="Lyrics" Content="Lirik" ToolTip="Mode Layar Lirik Penuh"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenSettingsCommand}" Content="⚙" ToolTip="Pengaturan"/>
                            </StackPanel>
                        </Grid>

                        <!-- Synced 3-Line Lyrics Preview -->
                        <Border Grid.Row="1" Background="#181822" CornerRadius="10" Padding="10,8" Margin="0,4,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding PreviousLyric}" Foreground="#555566" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding ActiveLyric}" Foreground="#E4C8FF" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2"/>
                                <TextBlock Text="{Binding NextLyric}" Foreground="#555566" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Progress bar & time -->
                        <Grid Grid.Row="2" Margin="0,2,0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Slider Grid.Row="0" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding CurrentPositionSeconds, Mode=TwoWay}"
                                    IsMoveToPointEnabled="True" Cursor="Hand" Margin="0,0,0,2"
                                    PreviewMouseDown="ProgressBar_PreviewMouseDown" PreviewMouseUp="ProgressBar_PreviewMouseUp"/>
                            <Grid Grid.Row="1">
                                <TextBlock Text="{Binding FormattedTime}" Foreground="#888899" FontSize="11" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding CurrentLyrics.Source, StringFormat='Sumber: {0}'}" Foreground="#666677" FontSize="10" HorizontalAlignment="Left"/>
                            </Grid>
                        </Grid>

                        <!-- Media Controls (Previous, Play/Pause, Next) -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,8">
                            <Button Style="{StaticResource ControlButtonStyle}" Command="{Binding PreviousCommand}" Width="36" Height="36" ToolTip="Sebelumnya">
                                <Path Data="M 0 0 H 2.5 V 12 H 0 Z M 11 0 L 3 6 L 11 12 Z" Fill="#EEEEEE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource ControlButtonStyle}" Command="{Binding TogglePlayPauseCommand}" 
                                    Width="44" Height="44" Margin="12,0" Padding="0" ToolTip="Putar / Jeda">
                                <Border Width="40" Height="40" CornerRadius="20" Background="#AF78FF">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Play icon (triangle) -->
                                        <Path Data="M 0 0 L 13 8 L 0 16 Z" Fill="#121216" Margin="2,0,0,0"
                                              Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible, TargetNullValue=Visible}"/>
                                        <!-- Pause icon (two bars) -->
                                        <Path Data="M 0 0 H 4 V 14 H 0 Z M 7 0 H 11 V 14 H 7 Z" Fill="#121216"
                                              Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
                                    </Grid>
                                </Border>
                            </Button>
                            <Button Style="{StaticResource ControlButtonStyle}" Command="{Binding NextCommand}" Width="36" Height="36" ToolTip="Berikutnya">
                                <Path Data="M 0 0 L 8 6 L 0 12 Z M 8.5 0 H 11 V 12 H 8.5 Z" Fill="#EEEEEE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <!-- Quick Tools (Offset, Import) -->
                        <Grid Grid.Row="4" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Offset controls -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Offset:" Foreground="#777788" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OffsetSubtractCommand}" Content="-0.5s" ToolTip="Lirik terlambat (geser mundur)"/>
                                <TextBlock Text="{Binding ManualOffsetSeconds, StringFormat='{}{0:0.0}s'}" Foreground="#AF78FF" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OffsetAddCommand}" Content="+0.5s" ToolTip="Lirik terlalu cepat (geser maju)"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OffsetResetCommand}" Content="Reset" ToolTip="Reset offset ke 0s"/>
                            </StackPanel>

                            <!-- Import LRC / TXT -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding ImportLyricsCommand}" Content="Impor File (.lrc/.txt)"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ===== PEMISAH VERTIKAL ===== -->
                    <Border Grid.Column="1" Width="1" Background="#282136" Margin="14,2,14,2"
                            Visibility="{Binding ShowSplitter, Converter={StaticResource BoolToVis}}"/>

                    <!-- ===== SISI KANAN: TO-DO LIST ===== -->
                    <Grid Grid.Column="2" Visibility="{Binding ShowTodoSectionInMainWindow, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="Auto"/> <!-- Filter Tabs -->
                            <RowDefinition Height="Auto"/> <!-- Input New Task -->
                            <RowDefinition Height="*"/>    <!-- Task List -->
                        </Grid.RowDefinitions>

                        <!-- Header: Judul, Ringkasan, dan Tombol Tutup -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✓" Foreground="#AF78FF" FontSize="15" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="To-Do List" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Background="#231A36" CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TodoSummaryText}" Foreground="#D0B5FF" FontSize="10.5" FontWeight="Medium"/>
                                </Border>

                                <!-- Tombol Sinkronisasi Google Drive -->
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding SyncGoogleDriveCommand}"
                                        ToolTip="{Binding GoogleDriveSyncTooltip}" Padding="5,2" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="☁" FontSize="11" Margin="0,0,3,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#7E7294"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGoogleDriveConnected}" Value="True">
                                                            <Setter Property="Foreground" Value="#AF78FF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Sync" FontSize="10" Foreground="#D5C5EE"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Tombol Pin & Pengaturan saat mode Hanya To-Do (Music disembunyikan) -->
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding TogglePinCommand}" ToolTip="Pin agar tetap terbuka"
                                        Visibility="{Binding ShowMusicSection, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,4,0">
                                    <TextBlock Text="📌" FontSize="10"/>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenSettingsCommand}" Content="⚙" ToolTip="Pengaturan"
                                        Visibility="{Binding ShowMusicSection, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,4,0"/>

                                <!-- Tombol Lepas Jendela To-Do ke jendela melayang tersendiri -->
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding DetachTodoCommand}"
                                        ToolTip="Lepas To-Do List ke jendela terpisah (tidak menempel dengan musik)" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⧉" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Lepas" FontSize="10.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding ClearCompletedTodosCommand}" 
                                        Visibility="{Binding HasCompletedTodos, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Hapus semua tugas yang selesai" Padding="6,2" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🗑" FontSize="10" Margin="0,0,3,0"/>
                                        <TextBlock Text="Bersihkan" FontSize="10.5"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" CommandParameter="Compact" Content="▴" ToolTip="Tutup ke Compact"/>
                            </StackPanel>
                        </Grid>

                        <!-- Filter Tabs -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource FilterPillStyle}" Command="{Binding SetTodoFilterCommand}" CommandParameter="All">
                                    <TextBlock Text="Semua">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAllFilterSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#AF78FF"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Style="{StaticResource FilterPillStyle}" Command="{Binding SetTodoFilterCommand}" CommandParameter="Active">
                                    <TextBlock Text="Aktif">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActiveFilterSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#AF78FF"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Style="{StaticResource FilterPillStyle}" Command="{Binding SetTodoFilterCommand}" CommandParameter="Completed">
                                    <TextBlock Text="Selesai">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompletedFilterSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#AF78FF"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </StackPanel>

                            <!-- Kategori Filter Chips (Tampil jika ada kategori) -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasCategories, Converter={StaticResource BoolToVis}}" Margin="0,5,0,0">
                                <ItemsControl ItemsSource="{Binding AvailableCategories}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource FilterPillStyle}"
                                                    Command="{Binding DataContext.SetCategoryFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Margin="0,0,4,0" Padding="6,1.5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="#" Foreground="#AF78FF" FontSize="9" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="#B0B0C0"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Input Tugas Baru (Dengan Pilihan Kategori) -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <!-- Dropdown / Input Kategori -->
                                <ColumnDefinition Width="100"/>
                                <!-- Input Teks Tugas -->
                                <ColumnDefinition Width="*"/>
                                <!-- Tombol Tambah (+) -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Pilihan Kategori Dropdown / Input -->
                            <ComboBox Grid.Column="0" 
                                      IsEditable="True"
                                      ItemsSource="{Binding ExistingCategories}"
                                      Text="{Binding NewTodoCategory, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource DarkCategoryComboBoxStyle}"
                                      Margin="0,0,5,0" VerticalAlignment="Center"
                                      ToolTip="Pilih atau ketik kategori/tag tugas (misal: MARIBON)"/>

                            <!-- Input Teks Tugas -->
                            <Grid Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBox x:Name="NewTodoTextBox" 
                                         Text="{Binding NewTodoTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TodoTextBoxStyle}" VerticalAlignment="Center">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding AddTodoCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <!-- Placeholder / Watermark -->
                                <TextBlock Text="Tulis tugas lalu Enter..." Foreground="#666677" FontSize="11"
                                           IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewTodoTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Tombol Tambah (+) -->
                            <Button Grid.Column="2" Command="{Binding AddTodoCommand}" ToolTip="Tambah Tugas"
                                    Background="#AF78FF" Foreground="#101014" Width="28" Height="28" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                       FontWeight="Bold" FontSize="15" Foreground="#101014"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#C296FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Daftar Tugas (Scrollable) -->
                        <Border Grid.Row="3" Background="#0C0C12" CornerRadius="10" Padding="6,4" Height="172">
                            <Grid>
                                <!-- Tampilan saat kosong -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding FilteredTodos.IsEmpty, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="🎉" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Tidak ada tugas saat ini" Foreground="#666677" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- List Item -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                    <ItemsControl ItemsSource="{Binding FilteredTodos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#14141C" CornerRadius="8" Padding="6,5" Margin="0,2,0,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#1C1C28"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Checkbox -->
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                                  Style="{StaticResource TodoCheckBoxStyle}"
                                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                        <!-- Judul Tugas & Kategori Tag -->
                                                        <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <!-- Tag / Kategori Badge -->
                                                            <Border DockPanel.Dock="Left" Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}"
                                                                    Background="#2C1D42" BorderBrush="#7754B5" BorderThickness="1"
                                                                    CornerRadius="4" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Category}" Foreground="#D6B5FF" FontSize="9.5" FontWeight="Bold"/>
                                                            </Border>

                                                            <!-- Teks Tugas -->
                                                            <TextBlock Text="{Binding TaskText}" VerticalAlignment="Center"
                                                                       FontSize="11.5" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#E2E2EA"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                <Setter Property="Foreground" Value="#666677"/>
                                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DockPanel>

                                                        <!-- Tombol Hapus -->
                                                        <Button Grid.Column="2" Command="{Binding DeleteCommand}"
                                                                Style="{StaticResource TodoDeleteButtonStyle}"
                                                                ToolTip="Hapus tugas" Width="20" Height="20" VerticalAlignment="Center">
                                                            <TextBlock Text="×" FontSize="14" FontWeight="Bold" Margin="0,-2,0,0"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= MODE 3: LYRICS ================= -->
                <Grid x:Name="LyricsView" Visibility="{Binding IsLyricsMode, Converter={StaticResource BoolToVis}}" 
                      Width="460" Height="320" Margin="14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='DRANOTCH'}" FontWeight="Bold" FontSize="14" Foreground="#AF78FF" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentTrack.Artist, FallbackValue='-'}" FontSize="11" Foreground="#9999AA" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallPillButton}" Click="ToggleClickThrough_Click" Content="Click-Through" ToolTip="Tembus klik mouse"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" CommandParameter="Expanded" Content="Expanded"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" CommandParameter="Compact" Content="Compact"/>
                        </StackPanel>
                    </Grid>

                    <!-- Big Central Focused Lyrics -->
                    <Border Grid.Row="1" Background="#0A0A0E" CornerRadius="12" Padding="14">
                        <Grid VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PreviousLyric}" FontSize="14" Foreground="#444455" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding ActiveLyric}" FontSize="{Binding Settings.LyricsFontSize}" Foreground="#FFFFFF" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4"/>
                                <TextBlock Text="{Binding NextLyric}" FontSize="14" Foreground="#444455" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Bottom Bar (Play/Pause, Time, Offset) -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding PreviousCommand}" Content="⏮" Width="30"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding TogglePlayPauseCommand}" Width="36" Height="24" ToolTip="Putar / Jeda">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 0 0 L 9 5.5 L 0 11 Z" Fill="#AF78FF" Margin="1.5,0,0,0"
                                          Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible, TargetNullValue=Visible}"/>
                                    <Path Data="M 0 0 H 2.5 V 10 H 0 Z M 5 0 H 7.5 V 10 H 5 Z" Fill="#AF78FF"
                                          Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding NextCommand}" Content="⏭" Width="30"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" Foreground="#777788" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding OffsetSubtractCommand}" Content="-0.5s"/>
                            <TextBlock Text="{Binding ManualOffsetSeconds, StringFormat='{}{0:0.0}s'}" Foreground="#AF78FF" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding OffsetAddCommand}" Content="+0.5s"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
