<Window x:Class="NotchMusic.Views.PrayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NotchMusic.Helpers"
        Title="DRANOTCH - Waktu Sholat"
        Width="360" MinWidth="300"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="{Binding Settings.AlwaysOnTop}"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <LinearGradientBrush x:Key="MetallicSilverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#E2E6F0" Offset="0.35"/>
            <GradientStop Color="#949BA8" Offset="0.72"/>
            <GradientStop Color="#D4D9E6" Offset="1.0"/>
        </LinearGradientBrush>

        <Geometry x:Key="LuxuryPrayerIconGeometry">M 20.6,13.4 A 8.6,8.6 0 1 1 10.6,3.4 A 6.6,6.6 0 0 0 20.6,13.4 Z M 17.5,2.2 L 18.5,5.0 L 21.3,6.0 L 18.5,7.0 L 17.5,9.8 L 16.5,7.0 L 13.7,6.0 L 16.5,5.0 Z</Geometry>

        <!-- Small Pill Button Style -->
        <Style x:Key="SmallPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A2A34"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="PrayerContainerBorder"
                Background="#0A0A0C"
                BorderBrush="#24242A"
                BorderThickness="1.2"
                CornerRadius="20"
                MouseDown="Border_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.65"/>
            </Border.Effect>

            <Grid>
                <!-- ================= MODE 1: COMPACT PRAYER NOTCH ================= -->
                <Grid x:Name="PrayerCompactView"
                      Visibility="{Binding IsPrayerWindowCompact, Converter={StaticResource BoolToVis}}"
                      Height="48" Margin="8,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Badge -->
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9" Margin="2,0,8,0" 
                            Background="#1C1C26" BorderBrush="#38FFFFFF" BorderThickness="1">
                        <Path Data="{StaticResource LuxuryPrayerIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                              Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Next Prayer Pill / Info (Click to Expand) -->
                    <Border Grid.Column="1" Background="#141418" BorderBrush="#24242A" BorderThickness="1.2"
                            CornerRadius="12" Height="32" Margin="0,0,6,0" Padding="8,2" Cursor="Hand"
                            ToolTip="{Binding PrayerScheduleTooltip}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ExpandPrayerWindowCommand}"/>
                        </Border.InputBindings>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding NextPrayerName}" Foreground="#FFFFFF" 
                                       FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding NextPrayerTimeFormatted}" Foreground="#DDDDDD" 
                                       FontSize="11.5" VerticalAlignment="Center" Margin="0,0,5,0"/>

                            <Border Grid.Column="2" Background="#1E1E24" CornerRadius="4" Padding="4,1" 
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding NextPrayerCountdownBadge}" Foreground="#AAAAAA" FontSize="9.5"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Actions (Expand, Pasang ke Notch, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding ExpandPrayerWindowCommand}" Content="&#x25BE;" ToolTip="Perluas Jadwal"/>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding AttachPrayerCommand}" ToolTip="Pasang kembali ke notch utama" Margin="2,0,0,0">
                            <TextBlock Text="&#x21F2;" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource SmallPillButton}" Click="CloseButton_Click" Content="&#x2715;" ToolTip="Tutup Waktu Sholat" Margin="2,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ================= MODE 2: EXPANDED PRAYER SCHEDULE ================= -->
                <Grid x:Name="PrayerExpandedView"
                      Visibility="{Binding IsPrayerWindowExpanded, Converter={StaticResource BoolToVis}}"
                      Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Next Prayer Countdown Card -->
                        <RowDefinition Height="Auto"/> <!-- Daily Schedule List -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
                    </Grid.RowDefinitions>

                    <!-- Header: Icon, Judul, Kota, Tanggal Hijriah, Pasang, Minimize, Tutup -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="7" Background="#1C1C26" BorderBrush="#38FFFFFF" BorderThickness="1" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource LuxuryPrayerIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                          Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Waktu Sholat" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <Border Background="#1C1C24" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentPrayerSchedule.CityName}" Foreground="#CCCCCC" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentPrayerSchedule.HijriDate}" FontSize="11" Foreground="#888899" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <!-- Tombol Pasang Kembali ke Notch Utama -->
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding AttachPrayerCommand}"
                                    Content="&#x21F2;" ToolTip="Pasang kembali Waktu Sholat ke notch utama" Margin="0,0,4,0"/>

                            <!-- Tombol Tutup ke Compact (Minimize) -->
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding MinimizePrayerWindowCommand}"
                                    Content="&#x25B4;" ToolTip="Tutup ke Compact" Margin="0,0,4,0"/>

                            <!-- Tombol Tutup / Sembunyikan -->
                            <Button Style="{StaticResource SmallPillButton}" Click="CloseButton_Click"
                                    Content="&#x2715;" ToolTip="Tutup jendela Waktu Sholat"/>
                        </StackPanel>
                    </Grid>

                    <!-- Next Prayer Countdown Banner Card -->
                    <Border Grid.Row="1" Background="#14141A" BorderBrush="#282836" BorderThickness="1.2" 
                            CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="WAKTU BERIKUTNYA" FontSize="9.5" FontWeight="Bold" Foreground="#888899" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding NextPrayerName}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding NextPrayerTimeFormatted}" FontSize="18" FontWeight="Light" Foreground="#DDDDDD"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#20202A" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="HITUNG MUNDUR" FontSize="8.5" FontWeight="Bold" Foreground="#777788" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding NextPrayerCountdownBadge}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Schedule Cards Grid (Imsak, Subuh, Terbit, Dzuhur, Ashar, Maghrib, Isya) -->
                    <Border Grid.Row="2" Background="#0C0C0F" CornerRadius="10" Padding="8,6" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding CurrentPrayerSchedule.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10,6" Margin="0,2,0,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#121216"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                            <Setter Property="Background" Value="#1E1E28"/>
                                                            <Setter Property="BorderBrush" Value="#444458"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#DDDDDD"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" FontSize="13" FontWeight="Bold" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontSize" Value="13.5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Border Grid.Column="2" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#18181F"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                    <Setter Property="Background" Value="#2A2A38"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding CountdownText}" FontSize="10" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#777788"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </Border>

                    <!-- Bottom Status & Actions -->
                    <Grid Grid.Row="3" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pilihan Suara Adzan Terpilih & Preview -->
                        <Border Grid.Column="0" Background="#141418" BorderBrush="#24242A" BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="0,0,6,0">
                            <StackPanel>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Suara: " Foreground="#777788" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedAdhanSoundName}" ToolTip="{Binding SelectedAdhanSoundName}" Foreground="#DDDDDD" FontSize="10.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,4,0"/>

                                    <!-- Pause / Resume saat playing -->
                                    <Button Grid.Column="2" Style="{StaticResource SmallPillButton}" Command="{Binding ToggleAdhanPlayPauseCommand}"
                                            Visibility="{Binding IsAdhanPlaying, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Jeda / Lanjutkan" Padding="6,2" Margin="0,0,3,0">
                                        <TextBlock Text="{Binding AdhanPlayPauseButtonIcon}" FontSize="9"/>
                                    </Button>

                                    <!-- Tombol Tes / Stop (Hanya Icon) -->
                                    <Button Grid.Column="3" Style="{StaticResource SmallPillButton}" Command="{Binding PlayAdhanPreviewCommand}"
                                            ToolTip="{Binding AdhanPlayButtonTooltip}" Padding="6,2" Margin="0">
                                        <TextBlock Text="{Binding AdhanPlayButtonIcon}" FontSize="9"/>
                                    </Button>
                                </Grid>

                                <!-- Mini Player Bar saat tes suara sedang berbunyi -->
                                <Grid Visibility="{Binding IsAdhanPlaying, Converter={StaticResource BoolToVis}}" Margin="0,4,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Grid.Column="0" Height="4" Minimum="0" Maximum="100" Value="{Binding AdhanProgressPercent, Mode=OneWay}"
                                                 Background="#252535" Foreground="#00E676" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AdhanProgressText}" Foreground="#00E676" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="1" Style="{StaticResource SmallPillButton}" Command="{Binding OpenSettingsCommand}" 
                                Content="⚙ Pengaturan" Padding="8,4"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
