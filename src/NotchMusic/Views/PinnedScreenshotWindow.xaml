<Window x:Class="NotchMusic.Views.PinnedScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DRANOTCH - Pinned Screenshot"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        MinWidth="120" MinHeight="80"
        Width="480" Height="320">

    <Grid x:Name="RootContainer" Margin="10">
        <!-- Drop Shadow Border -->
        <Border x:Name="OuterBorder" Background="#141418" CornerRadius="10"
                BorderBrush="#00D2FF" BorderThickness="1.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- Screenshot Image -->
                <Image x:Name="PinImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Hover Floating Controls at Top Right -->
                <Border x:Name="HoverToolbar" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="8" Background="#CC181820" CornerRadius="14" Padding="6,4"
                        BorderBrush="#38384A" BorderThickness="1" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pin indicator badge -->
                        <TextBlock Text="📌 Pin" Foreground="#00D2FF" FontSize="10.5" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="4,0,8,0"/>

                        <!-- Copy Button -->
                        <Button Content="📋" Click="BtnCopy_Click" ToolTip="Salin ke Clipboard"
                                Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                Padding="4,2" FontSize="11" Cursor="Hand" Margin="2,0"/>

                        <!-- Save As Button -->
                        <Button Content="💾" Click="BtnSaveAs_Click" ToolTip="Simpan Sebagai File..."
                                Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                Padding="4,2" FontSize="11" Cursor="Hand" Margin="2,0"/>

                        <!-- Close Button -->
                        <Button Content="✕" Click="BtnClose_Click" ToolTip="Tutup Pin"
                                Background="#EF4444" Foreground="#FFFFFF" BorderThickness="0"
                                Padding="6,2" FontSize="10" FontWeight="Bold" Cursor="Hand" Margin="4,0,2,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Resize Grip at Bottom Right -->
                <Thumb x:Name="ResizeGrip" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Cursor="SizeNWSE" Background="Transparent" Margin="2" DragDelta="ResizeGrip_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate>
                            <Path Data="M 12,2 L 2,12 M 12,6 L 6,12 M 12,10 L 10,12" Stroke="#888899" StrokeThickness="1.5"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>
    </Grid>
</Window>
