<Window x:Class="NotchMusic.Views.LiveTvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:helpers="clr-namespace:NotchMusic.Helpers"
        Title="DRANOTCH - Live TV"
        Width="480" Height="650" MinWidth="340" MinHeight="230"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#0A0A0E" Foreground="#EEEEEE">

    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="WindowChromeElement" CaptionHeight="0" CornerRadius="16" GlassFrameThickness="0" ResizeBorderThickness="7" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <LinearGradientBrush x:Key="MetallicSilverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#E2E6F0" Offset="0.35"/>
            <GradientStop Color="#949BA8" Offset="0.72"/>
            <GradientStop Color="#D4D9E6" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Luxury Live TV & Antenna Geometry (24x24) -->
        <Geometry x:Key="LuxuryLiveTvIconGeometry">M 8.5,2.5 L 12,6 L 15.5,2.5 L 16.9,3.9 L 14.3,6.5 H 19.5 A 2.5,2.5 0 0 1 22,9 V 18.5 A 2.5,2.5 0 0 1 19.5,21 H 4.5 A 2.5,2.5 0 0 1 2,18.5 V 9 A 2.5,2.5 0 0 1 4.5,6.5 H 9.7 L 7.1,3.9 Z M 4.5,8.8 V 18.2 H 19.5 V 8.8 Z M 9.8,10.8 L 15.5,13.5 L 9.8,16.2 Z</Geometry>

        <!-- Small Pill Button Style -->
        <Style x:Key="SmallPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E26"/>
            <Setter Property="Foreground" Value="#E0E0EC"/>
            <Setter Property="BorderBrush" Value="#303042"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2C2C3C"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4C4C66"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Chip Style -->
        <Style x:Key="TvFilterPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#15151C"/>
            <Setter Property="Foreground" Value="#9898AC"/>
            <Setter Property="BorderBrush" Value="#262634"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="9,3.5"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#242432"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#424258"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Input TextBox -->
        <Style x:Key="TvTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#14141C"/>
            <Setter Property="Foreground" Value="#EDEDF5"/>
            <Setter Property="BorderBrush" Value="#2C2C3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="#686888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Country ComboBox Style -->
        <Style x:Key="TvCountryComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#15151E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2C2C3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Foreground="#FFFFFF"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" Background="#15151E" BorderBrush="#2C2C3E" BorderThickness="1" CornerRadius="8" Padding="9,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="16"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource AncestorType=ComboBox}, FallbackValue='🌍 Semua Negara'}"
                                                           Foreground="#FFFFFF"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Path Grid.Column="1" Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="#B8B8D0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#20202E"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#484864"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#14141D" BorderBrush="#323248" BorderThickness="1" CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240" Padding="4" Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#F0F0FA"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#252536"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#32324A"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Padding 5px keeps WindowChrome 7px resize handles unobstructed by WebView2 -->
    <Border Background="#0A0A0E" BorderBrush="#282838" BorderThickness="1.5" CornerRadius="16" Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header Bar (Adapts to Compact Mini PiP vs Expanded Mode) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Video Player Area (16:9 or Stretch in Cinema/PiP Mode) -->
                <RowDefinition x:Name="VideoPlayerRow" Height="236"/>
                <!-- Row 2: Transport & Volume Bar (Expanded Mode Only) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: Country & Category Filter Row (Expanded Non-Cinema Mode) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 4: Search & Online Catalog Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 5: Collapsible Add Custom Stream Panel -->
                <RowDefinition Height="Auto"/>
                <!-- Row 6: Channel List -->
                <RowDefinition x:Name="ChannelListRow" Height="*"/>
                <!-- Row 7: Footer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= ROW 0: HEADER BAR (DRAGGABLE) ================= -->
            <Border Grid.Row="0" Background="#12121A" BorderBrush="#222232" BorderThickness="1"
                    CornerRadius="11" Padding="10,6" Margin="0,0,0,6"
                    MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <!-- COMPACT MINI PiP HEADER -->
                    <Grid Visibility="{Binding IsLiveTvWindowCompact, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Margin="0,0,7,0"
                                Background="#1C1C26" BorderBrush="#38FFFFFF" BorderThickness="1" Cursor="SizeAll"
                                ToolTip="Tahan dan geser untuk memindahkan Mini TV">
                            <Path Data="{StaticResource LuxuryLiveTvIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                  Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#666677"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiveTvPlaying}" Value="True">
                                                <Setter Property="Fill" Value="#30D158"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLiveTvBuffering}" Value="True">
                                                <Setter Property="Fill" Value="#FFAA44"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding CurrentLiveTvChannelName}" Foreground="#FFFFFF"
                                       FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding PreviousLiveTvChannelCommand}" Content="⏮" ToolTip="Saluran Sebelumnya" Padding="6,3"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding ToggleLiveTvPlayPauseCommand}" ToolTip="Putar / Jeda" Padding="7,3">
                                <Grid>
                                    <TextBlock Text="▶" FontSize="9.5" Visibility="{Binding IsLiveTvPlaying, Converter={StaticResource InverseBoolToVis}}"/>
                                    <TextBlock Text="⏸" FontSize="9.5" Visibility="{Binding IsLiveTvPlaying, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding NextLiveTvChannelCommand}" Content="⏭" ToolTip="Saluran Berikutnya" Padding="6,3"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding CycleLiveTvSourceCommand}" Content="🔄" ToolTip="Ganti Sumber Stream Cadangan" Padding="6,3"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding ExpandLiveTvWindowCommand}" Content="&#x25BE;" ToolTip="Perluas Jendela Live TV" Padding="7,3"/>
                            <Button Style="{StaticResource SmallPillButton}" Click="CloseButton_Click" Content="&#x2715;" ToolTip="Tutup Live TV" Padding="7,3"/>
                        </StackPanel>
                    </Grid>

                    <!-- EXPANDED STUDIO HEADER -->
                    <Grid Visibility="{Binding IsLiveTvWindowExpanded, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="8" Background="#1C1C26" BorderBrush="#38FFFFFF" BorderThickness="1" Margin="0,0,9,0" VerticalAlignment="Center" Cursor="SizeAll" ToolTip="Geser jendela Live TV">
                                <Path Data="{StaticResource LuxuryLiveTvIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                      Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Live TV" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <Border CornerRadius="5" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1E1E28"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLiveTvPlaying}" Value="True">
                                                        <Setter Property="Background" Value="#163824"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLiveTvBuffering}" Value="True">
                                                        <Setter Property="Background" Value="#382A14"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="5" Height="5" Margin="0,0,4,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#88889A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLiveTvPlaying}" Value="True">
                                                                <Setter Property="Fill" Value="#30D158"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLiveTvBuffering}" Value="True">
                                                                <Setter Property="Fill" Value="#FFAA44"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding LiveTvStateBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding LiveTvStatusMessage}" FontSize="10" Foreground="#88889C" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PinTopmostButton" Style="{StaticResource SmallPillButton}" Click="PinTopmostButton_Click"
                                    Content="📌" ToolTip="Selalu di Atas (Always on Top)" Padding="7,4"/>
                            <Button x:Name="CinemaModeButton" Style="{StaticResource SmallPillButton}" Click="CinemaModeButton_Click"
                                    Content="⛶" ToolTip="Mode Bioskop (Sembunyikan/Tampilkan Daftar Saluran)" Padding="7,4"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding ToggleAddCustomLiveTvCommand}"
                                    Content="+ URL" ToolTip="Tambah URL Stream TV Custom (.m3u8 / YouTube Live)" Padding="7,4"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding MinimizeLiveTvWindowCommand}"
                                    Content="📺 PiP" ToolTip="Perkecil ke Mode Mini Picture-in-Picture (PiP)" Padding="7,4"/>
                            <Button Style="{StaticResource SmallPillButton}" Click="CloseButton_Click"
                                    Content="&#x2715;" ToolTip="Tutup Jendela Live TV" Padding="7,4"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= ROW 1: SHARED 16:9 VIDEO SCREEN (WEBVIEW2 HLS & YOUTUBE PLAYER) ================= -->
            <Border Grid.Row="1" Background="#050508" BorderBrush="#242434" BorderThickness="1.2"
                    CornerRadius="12" ClipToBounds="True" Margin="0,0,0,6">
                <Grid>
                    <!-- Standby / Loading Overlay before WebView2 is ready -->
                    <StackPanel x:Name="PlayerLoadingOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                        <TextBlock Text="📺 Menyiapkan Layar Live TV..." Foreground="#DCDCE8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <ProgressBar IsIndeterminate="True" Width="150" Height="3" Foreground="#30D158" Background="#222230" BorderThickness="0"/>
                    </StackPanel>

                    <wv2:WebView2 x:Name="tvWebView"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  DefaultBackgroundColor="Black"
                                  Visibility="Hidden"/>
                </Grid>
            </Border>

            <!-- ================= ROW 2: NOW PLAYING INFO & TRANSPORT CONTROLS ================= -->
            <Border Grid.Row="2" x:Name="NowPlayingControlsBorder"
                    Background="#13131B" BorderBrush="#262636" BorderThickness="1"
                    CornerRadius="12" Padding="10,7" Margin="0,0,0,6"
                    Visibility="{Binding IsLiveTvWindowExpanded, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Active Channel Info + Source Switcher + Favorite -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding CurrentLiveTvChannelName}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentLiveTvChannelSubtitle}" FontSize="10.5" Foreground="#9898B0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallPillButton}"
                                    Command="{Binding CycleLiveTvSourceCommand}"
                                    ToolTip="Ganti jalur/server stream jika siaran macet" Padding="8,4" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄 " FontSize="10"/>
                                    <TextBlock Text="{Binding CurrentLiveTvSourceBadge}" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SmallPillButton}"
                                    Command="{Binding ToggleCurrentLiveTvFavoriteCommand}"
                                    ToolTip="Simpan Saluran ke Favorit" Padding="8,4">
                                <TextBlock Text="{Binding CurrentLiveTvFavoriteSymbol}" FontSize="13" Foreground="#FFCC4D"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Transport Buttons (Left) & Volume Slider (Right) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>

                        <!-- Prev / Play-Pause / Stop / Next -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding PreviousLiveTvChannelCommand}"
                                    Width="32" Height="28" Padding="0" ToolTip="Saluran Sebelumnya">
                                <Path Data="M 0 0 H 2 V 10 H 0 Z M 9 0 L 2.5 5 L 9 10 Z" Fill="#EEEEEE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding ToggleLiveTvPlayPauseCommand}"
                                    Width="40" Height="30" Padding="0" ToolTip="Putar / Jeda Siaran TV"
                                    Background="#FFFFFF" BorderBrush="#FFFFFF" Margin="4,0">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 0 0 L 10 6 L 0 12 Z" Fill="#000000" Margin="1.5,0,0,0"
                                          Visibility="{Binding IsLiveTvPlaying, Converter={StaticResource InverseBoolToVis}}"/>
                                    <Path Data="M 0 0 H 3.2 V 11 H 0 Z M 5.8 0 H 9 V 11 H 5.8 Z" Fill="#000000"
                                          Visibility="{Binding IsLiveTvPlaying, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding StopLiveTvCommand}"
                                    Width="32" Height="28" Padding="0" ToolTip="Hentikan Siaran" Margin="0,0,4,0">
                                <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#EEEEEE"/>
                            </Button>

                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding NextLiveTvChannelCommand}"
                                    Width="32" Height="28" Padding="0" ToolTip="Saluran Berikutnya">
                                <Path Data="M 0 0 L 6.5 5 L 0 10 Z M 7 0 H 9 V 10 H 7 Z" Fill="#EEEEEE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <!-- Volume Controls -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource SmallPillButton}" Command="{Binding ToggleLiveTvMuteCommand}"
                                    Padding="6,2" Margin="0,0,6,0" ToolTip="Bisukan / Bunyikan Suara TV">
                                <TextBlock Text="{Binding LiveTvVolumeIcon}" FontSize="11"/>
                            </Button>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding LiveTvVolume, Mode=TwoWay}"
                                    IsMoveToPointEnabled="True" VerticalAlignment="Center" Cursor="Hand"/>
                        </Grid>

                        <TextBlock Grid.Column="2" Text="{Binding LiveTvVolumePercentText}" Foreground="#9898B0"
                                   FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= ROW 3: COUNTRY SELECTOR & CATEGORY FILTER PILLS ================= -->
            <Grid Grid.Row="3" x:Name="FilterBarGrid" Margin="0,0,0,6"
                  Visibility="{Binding IsLiveTvWindowExpanded, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Country Picker + Channel Count -->
                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Negara:" Foreground="#9898B0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,6,0"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding LiveTvCountries}"
                              SelectedValue="{Binding SelectedLiveTvCountryCode, Mode=TwoWay}"
                              SelectedValuePath="Code"
                              Style="{StaticResource TvCountryComboBoxStyle}"/>

                    <TextBlock Grid.Column="3" Text="{Binding LiveTvCatalogCountText}" Foreground="#7E7E96" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,2,0"/>
                </Grid>

                <!-- Category Filter Pills -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource TvFilterPillStyle}" Command="{Binding SetLiveTvCategoryCommand}" CommandParameter="All" Content="Semua"/>
                        <Button Style="{StaticResource TvFilterPillStyle}" Command="{Binding SetLiveTvCategoryCommand}" CommandParameter="Favorites" Content="★ Favorit"/>
                        <Button Style="{StaticResource TvFilterPillStyle}" Command="{Binding SetLiveTvCategoryCommand}" CommandParameter="Indonesia" Content="🇮🇩 Indonesia"/>
                        <Button Style="{StaticResource TvFilterPillStyle}" Command="{Binding SetLiveTvCategoryCommand}" CommandParameter="Berita" Content="📰 Berita"/>
                        <Button Style="{StaticResource TvFilterPillStyle}" Command="{Binding SetLiveTvCategoryCommand}" CommandParameter="Hiburan" Content="🎬 Hiburan"/>
                        <Button Style="{StaticResource TvFilterPillStyle}" Command="{Binding SetLiveTvCategoryCommand}" CommandParameter="Olahraga" Content="⚽ Olahraga"/>
                        <Button Style="{StaticResource TvFilterPillStyle}" Command="{Binding SetLiveTvCategoryCommand}" CommandParameter="Religi" Content="🕌 Religi"/>
                        <Button Style="{StaticResource TvFilterPillStyle}" Command="{Binding SetLiveTvCategoryCommand}" CommandParameter="Musik" Content="🎵 Musik"/>
                        <Button Style="{StaticResource TvFilterPillStyle}" Command="{Binding SetLiveTvCategoryCommand}" CommandParameter="Anak" Content="🧸 Anak"/>
                        <Button Style="{StaticResource TvFilterPillStyle}" Command="{Binding SetLiveTvCategoryCommand}" CommandParameter="Internasional" Content="🌍 Dunia"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= ROW 4: SEARCH BAR (LOCAL & ONLINE CATALOG) ================= -->
            <Grid Grid.Row="4" x:Name="SearchBarGrid" Margin="0,0,0,6"
                  Visibility="{Binding IsLiveTvWindowExpanded, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,6,0">
                    <TextBox x:Name="SearchTvBox"
                             Text="{Binding LiveTvSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TvTextBoxStyle}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchOnlineLiveTvCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="Cari saluran TV (ketik lalu Enter untuk cari online)..."
                               Foreground="#66667A" FontSize="11" IsHitTestVisible="False"
                               Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTvBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="1" Style="{StaticResource SmallPillButton}"
                        Command="{Binding SearchOnlineLiveTvCommand}"
                        ToolTip="Cari saluran TV dari seluruh dunia secara online"
                        Padding="10,5" Margin="0">
                    <TextBlock Text="{Binding SearchOnlineLiveTvButtonText}" FontSize="11" FontWeight="SemiBold"/>
                </Button>
            </Grid>

            <!-- ================= ROW 5: COLLAPSIBLE ADD CUSTOM URL PANEL ================= -->
            <Border Grid.Row="5" Background="#14141D" BorderBrush="#2C2C3E" BorderThickness="1"
                    CornerRadius="10" Padding="10,8" Margin="0,0,0,6"
                    Visibility="{Binding IsAddingCustomLiveTv, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Tambah Saluran Live TV Custom (HLS .m3u8 / YouTube Live)" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,5">
                        <TextBox x:Name="CustomTvNameBox" Text="{Binding CustomLiveTvName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvTextBoxStyle}"/>
                        <TextBlock Text="Nama Saluran TV (contoh: TV Favoritku)" Foreground="#66667A" FontSize="11" IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=CustomTvNameBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <TextBox x:Name="CustomTvUrlBox" Text="{Binding CustomLiveTvUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvTextBoxStyle}"/>
                        <TextBlock Text="URL Stream (.m3u8 atau link YouTube Live)" Foreground="#66667A" FontSize="11" IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=CustomTvUrlBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding ToggleAddCustomLiveTvCommand}" Content="Batal" Margin="0,0,4,0"/>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding SaveCustomLiveTvCommand}" Content="Simpan &amp; Tonton" Background="#1E3A2B" BorderBrush="#30D158" Foreground="#FFFFFF"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= ROW 6: CHANNEL LIST ================= -->
            <Border Grid.Row="6" x:Name="ChannelListBorder"
                    Background="#0D0D12" BorderBrush="#1E1E28" BorderThickness="1" CornerRadius="12" Padding="6,5"
                    Visibility="{Binding IsLiveTvWindowExpanded, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredLiveTvChannels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="9" Padding="8,6" Margin="0,2" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.PlayLiveTvChannelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#14141C"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1E1E2A"/>
                                                    <Setter Property="BorderBrush" Value="#323246"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="#1C2232"/>
                                                    <Setter Property="BorderBrush" Value="#485880"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Play / Active Indicator Badge -->
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Margin="0,0,9,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1E1E2A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Background" Value="#30D158"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="▶" FontSize="9.5" Foreground="#E0E0F0" Margin="1,0,0,0"
                                                           Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVis}}"/>
                                                <TextBlock Text="📺" FontSize="10.5" Foreground="#000000"
                                                           Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Channel Name & Subtitle -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#8A8AA0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Stream Type Badge (HLS / YT) -->
                                        <Border Grid.Column="2" Background="#1A1A24" CornerRadius="5" Padding="5,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceBadgeText}" FontSize="9" Foreground="#9898B0" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Favorite & Delete Custom Buttons -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SmallPillButton}"
                                                    Command="{Binding DataContext.ToggleLiveTvChannelFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Favorit" Padding="6,2" Background="Transparent" BorderThickness="0">
                                                <TextBlock Text="{Binding FavoriteSymbol}" FontSize="12.5" Foreground="#FFCC4D"/>
                                            </Button>
                                            <Button Style="{StaticResource SmallPillButton}"
                                                    Command="{Binding DataContext.DeleteCustomLiveTvChannelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Hapus saluran custom" Padding="5,2" Background="Transparent" BorderThickness="0">
                                                <TextBlock Text="×" FontSize="13" FontWeight="Bold" Foreground="#FF6B8B"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ================= ROW 7: FOOTER ================= -->
            <DockPanel Grid.Row="7" x:Name="FooterDock" Margin="2,6,2,0" LastChildFill="True"
                       Visibility="{Binding IsLiveTvWindowExpanded, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Streaming Live TV Indonesia &amp; Dunia • DRANOTCH"
                           FontSize="9.5" Foreground="#66667A" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
