<Window x:Class="NotchMusic.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NotchMusic.Helpers"
        Title="DRANOTCH - Pengingat Pintar"
        Width="420" MinWidth="340"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#FFFFFF"
        Topmost="{Binding Settings.AlwaysOnTop}"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <LinearGradientBrush x:Key="MetallicSilverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#E2E6F0" Offset="0.35"/>
            <GradientStop Color="#949BA8" Offset="0.72"/>
            <GradientStop Color="#D4D9E6" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Bell / Water Drop Luxury Icon Geometry -->
        <Geometry x:Key="LuxuryReminderIconGeometry">M 12,2.2 C 9.2,6.4 6.5,9.8 6.5,13.6 C 6.5,16.8 9.0,19.4 12,19.4 C 15.0,19.4 17.5,16.8 17.5,13.6 C 17.5,9.8 14.8,6.4 12,2.2 Z M 10.2,15.8 C 9.4,15.1 9.0,14.1 9.0,13.0 H 10.6 C 10.6,13.7 10.9,14.3 11.4,14.7 L 10.2,15.8 Z M 18.5,3.2 L 19.3,5.2 L 21.3,6.0 L 19.3,6.8 L 18.5,8.8 L 17.7,6.8 L 15.7,6.0 L 17.7,5.2 Z</Geometry>

        <!-- Small Pill Button Style -->
        <Style x:Key="SmallPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E26"/>
            <Setter Property="Foreground" Value="#D4D4E0"/>
            <Setter Property="BorderBrush" Value="#2E2E3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2C2C3A"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4E4E66"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#38384A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark TextBox -->
        <Style x:Key="ReminderInputBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#121218"/>
            <Setter Property="Foreground" Value="#F0F0F8"/>
            <Setter Property="BorderBrush" Value="#2C2C3A"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="ReminderContainerBorder"
                Background="#0A0A0E"
                BorderBrush="#262632"
                BorderThickness="1.2"
                CornerRadius="20"
                MouseDown="Border_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.68"/>
            </Border.Effect>

            <Grid>
                <!-- ================= MODE 1: COMPACT REMINDER PILL ================= -->
                <Grid x:Name="ReminderCompactView"
                      Visibility="{Binding IsReminderWindowCompact, Converter={StaticResource BoolToVis}}"
                      Height="50" Margin="10,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Badge -->
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Margin="0,0,8,0"
                            Background="{Binding NextReminderBadgeBackground}" BorderBrush="{Binding NextReminderBadgeBorder}" BorderThickness="1">
                        <Path Data="{Binding NextReminderIconGeometry}" Fill="{Binding NextReminderAccentColor}"
                              Width="17" Height="17" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Active Reminders (Icons + Remaining Time Only, Click to Expand) -->
                    <Border Grid.Column="1" Background="#13131A" BorderBrush="#252532" BorderThickness="1.2"
                            CornerRadius="12" Height="34" Margin="0,0,6,0" Padding="7,2" Cursor="Hand"
                            ToolTip="{Binding ReminderNotchTooltip}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ExpandReminderWindowCommand}"/>
                        </Border.InputBindings>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding ActiveReminders}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#181822" BorderBrush="#2C2C3E" BorderThickness="1"
                                                CornerRadius="8" Padding="3,2,6,2" Margin="2,0" VerticalAlignment="Center"
                                                ToolTip="{Binding Title}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="6"
                                                        Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}"
                                                        BorderThickness="1" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <Path Data="{Binding IconGeometry}" Fill="{Binding AccentColor}"
                                                          Width="12" Height="12" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding CountdownText}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding ExpandReminderWindowCommand}"
                                Content="&#x25BE;" ToolTip="Perluas Pengingat" Padding="7,3"/>
                        <Button Style="{StaticResource SmallPillButton}" Click="CloseButton_Click"
                                Content="&#x2715;" ToolTip="Tutup Jendela Pengingat" Padding="7,3" Margin="3,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ================= MODE 2: EXPANDED REMINDER WINDOW ================= -->
                <Grid x:Name="ReminderExpandedView"
                      Visibility="{Binding IsReminderWindowExpanded, Converter={StaticResource BoolToVis}}"
                      Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0: Header -->
                        <RowDefinition Height="Auto"/> <!-- 1: Next Upcoming Countdown Banner -->
                        <RowDefinition Height="Auto"/> <!-- 2: Quick Presets Bar -->
                        <RowDefinition Height="Auto"/> <!-- 3: Add / Edit Form (Collapsible) -->
                        <RowDefinition Height="Auto"/> <!-- 4: Reminders List -->
                        <RowDefinition Height="Auto"/> <!-- 5: Footer -->
                    </Grid.RowDefinitions>

                    <!-- 0. Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="8" Background="#142434" BorderBrush="#2E5478" BorderThickness="1" Margin="0,0,8,0">
                                    <Path Data="{StaticResource LuxuryReminderIconGeometry}" Fill="#38BDF8"
                                          Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Pengingat Pintar" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <Border Background="#182636" BorderBrush="#28425C" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Air • Obat • Fokus" Foreground="#7CC4FA" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ReminderSummaryText}" FontSize="11" Foreground="#88889E" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenAddReminderFormCommand}"
                                    Background="#162C42" BorderBrush="#28527A" Foreground="#38BDF8"
                                    ToolTip="Buat pengingat kustom baru" Padding="9,4" Margin="0,0,4,0">
                                <TextBlock Text="+ Buat Baru" FontSize="11" FontWeight="Bold"/>
                            </Button>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding MinimizeReminderWindowCommand}"
                                    Content="&#x25B4;" ToolTip="Kecilkan ke mode ringkas (Compact)" Padding="7,4" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource SmallPillButton}" Click="CloseButton_Click"
                                    Content="&#x2715;" ToolTip="Tutup jendela Pengingat Pintar" Padding="7,4"/>
                        </StackPanel>
                    </Grid>

                    <!-- 1. Next Upcoming Reminder Banner Card -->
                    <Border Grid.Row="1" Background="#12141E" BorderBrush="#262C40" BorderThickness="1.2"
                            CornerRadius="13" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                                    Background="{Binding NextReminderBadgeBackground}" BorderBrush="{Binding NextReminderBadgeBorder}" BorderThickness="1"
                                    Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="{Binding NextReminderIconGeometry}" Fill="{Binding NextReminderAccentColor}"
                                      Width="20" Height="20" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="PENGINGAT BERIKUTNYA" FontSize="9.5" FontWeight="Bold" Foreground="#7E8CA8" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding NextReminderTitle}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding NextReminderScheduleText}" FontSize="11" Foreground="#98A2B8"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#1B2434" BorderBrush="#2E3F5C" BorderThickness="1"
                                    CornerRadius="9" Padding="10,6" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding NextReminderTimeFormatted}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#A8C0E0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding NextReminderCountdownBadge}" FontSize="13.5" FontWeight="Bold"
                                               Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 2. Quick Presets Bar (1-Click Add) -->
                    <Border Grid.Row="2" Background="#101016" BorderBrush="#20202C" BorderThickness="1"
                            CornerRadius="11" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="⚡ TAMBAH CEPAT (PRESET PINTAR)" FontSize="9.5" FontWeight="Bold" Foreground="#8888A0" VerticalAlignment="Center"/>
                                <TextBlock Text="Klik untuk langsung menambahkan" FontSize="9.5" Foreground="#626278" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <WrapPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding AddReminderPresetCommand}" CommandParameter="water_60"
                                        Background="#132232" BorderBrush="#244464" Margin="0,0,5,4" Padding="8,4"
                                        ToolTip="Tambahkan pengingat Minum Air Putih setiap 60 menit">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 12,2 C 12,2 5,10.2 5,15 C 5,18.87 8.13,22 12,22 C 15.87,22 19,18.87 19,15 C 19,10.2 12,2 12,2 Z"
                                              Fill="#38BDF8" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Minum Air (1 Jam)" FontSize="10.5" Foreground="#7CC4FA" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding AddReminderPresetCommand}" CommandParameter="medicine_3x"
                                        Background="#2A1420" BorderBrush="#52263C" Margin="0,0,5,4" Padding="8,4"
                                        ToolTip="Tambahkan pengingat Minum Obat/Vitamin pukul 08:00, 13:00, dan 20:00">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 19.07,4.93 C 16.92,2.78 13.44,2.78 11.29,4.93 L 4.93,11.29 C 2.78,13.44 2.78,16.92 4.93,19.07 C 7.08,21.22 10.56,21.22 12.71,19.07 L 19.07,12.71 C 21.22,10.56 21.22,7.08 19.07,4.93 Z M 17.45,11.09 L 14.45,14.09 L 9.91,9.55 L 12.91,6.55 C 14.16,5.30 16.20,5.30 17.45,6.55 C 18.70,7.80 18.70,9.84 17.45,11.09 Z"
                                              Fill="#FB7185" Width="11.5" Height="11.5" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Minum Obat (3x Sehari)" FontSize="10.5" Foreground="#FDA4AF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding AddReminderPresetCommand}" CommandParameter="eyes_20"
                                        Background="#201834" BorderBrush="#3E2E64" Margin="0,0,5,4" Padding="8,4"
                                        ToolTip="Tambahkan pengingat Istirahat Mata 20-20-20 setiap 20 menit">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 12,4.5 C 7,4.5 2.73,7.61 1,12 C 2.73,16.39 7,19.5 12,19.5 C 17,19.5 21.27,16.39 23,12 C 21.27,7.61 17,4.5 12,4.5 Z M 12,17 C 9.24,17 7,14.76 7,12 C 7,9.24 9.24,7 12,7 C 14.76,7 17,9.24 17,12 C 17,14.76 14.76,17 12,17 Z M 12,9 C 10.34,9 9,10.34 9,12 C 9,13.66 10.34,15 12,15 C 13.66,15 15,13.66 15,12 C 15,10.34 13.66,9 12,9 Z"
                                              Fill="#C084FC" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Istirahat Mata (20m)" FontSize="10.5" Foreground="#C4B5FD" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding AddReminderPresetCommand}" CommandParameter="stretch_45"
                                        Background="#122822" BorderBrush="#224E42" Margin="0,0,0,4" Padding="8,4"
                                        ToolTip="Tambahkan pengingat Peregangan setiap 45 menit">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 12,2 C 13.1,2 14,2.9 14,4 C 14,5.1 13.1,6 12,6 C 10.9,6 10,5.1 10,4 C 10,2.9 10.9,2 12,2 Z M 21,9 H 15 V 22 H 13 V 16 H 11 V 22 H 9 V 9 H 3 V 7 H 21 V 9 Z"
                                              Fill="#34D399" Width="11.5" Height="11.5" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Peregangan (45m)" FontSize="10.5" Foreground="#6EE7B7" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3. Add / Edit Custom Reminder Form -->
                    <Border Grid.Row="3"
                            Visibility="{Binding IsAddingOrEditingReminder, Converter={StaticResource BoolToVis}}"
                            Background="#141622" BorderBrush="#344060" BorderThickness="1.2"
                            CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding ReminderFormHeaderTitle}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallPillButton}" Command="{Binding CancelReminderFormCommand}"
                                        Content="Batal" Padding="8,2" FontSize="10.5" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- Pilih Ikon & Kategori -->
                            <TextBlock Text="Pilih Ikon &amp; Nama Pengingat:" FontSize="10.5" Foreground="#98A2B8" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding AvailableReminderIconOptions}" Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SmallPillButton}"
                                                Command="{Binding DataContext.SetFormReminderIconCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Key}"
                                                Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}"
                                                Padding="7,4" Margin="0,0,4,4"
                                                ToolTip="{Binding Label}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{Binding IconGeometry}" Fill="{Binding AccentColor}"
                                                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#E8ECF4" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="105"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{Binding FormReminderBadgeBackground}" BorderBrush="{Binding FormReminderBadgeBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,6,0">
                                    <Path Data="{Binding FormReminderIconGeometry}" Fill="{Binding FormReminderAccentColor}"
                                          Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Column="1" Style="{StaticResource ReminderInputBoxStyle}"
                                         Text="{Binding FormReminderTitle, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Nama pengingat (misal: Minum Air Putih, Minum Obat Pagi)" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="2" Style="{StaticResource ReminderInputBoxStyle}"
                                         Text="{Binding FormReminderCategory, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Kategori (misal: Hidrasi, Kesehatan, Kerja)"/>
                            </Grid>

                            <!-- Tipe Jadwal: Interval Berulang vs Jam Harian -->
                            <TextBlock Text="Tipe Jadwal Pengingat:" FontSize="10.5" Foreground="#98A2B8" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding SetFormReminderTypeCommand}" CommandParameter="Interval"
                                        Margin="0,0,4,0" Padding="8,6" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SmallPillButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFormIntervalType}" Value="True">
                                                    <Setter Property="Background" Value="#1A3650"/>
                                                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="🔄 Interval Berulang (Menit/Jam)" FontSize="10.5" FontWeight="SemiBold"/>
                                </Button>

                                <Button Grid.Column="1" Command="{Binding SetFormReminderTypeCommand}" CommandParameter="DailyTime"
                                        Margin="4,0,0,0" Padding="8,6" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SmallPillButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFormDailyTimeType}" Value="True">
                                                    <Setter Property="Background" Value="#3A1828"/>
                                                    <Setter Property="BorderBrush" Value="#F43F5E"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="⏰ Jam Harian (08:00, 13:00...)" FontSize="10.5" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <!-- Opsi 1: Interval Berulang -->
                            <StackPanel Visibility="{Binding IsFormIntervalType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="Ingatkan setiap berapa menit:" FontSize="10.5" Foreground="#98A2B8" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource ReminderInputBoxStyle}"
                                             Text="{Binding FormReminderIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             TextAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="menit" Foreground="#A0A8BC" FontSize="11" VerticalAlignment="Center" Margin="6,0,10,0"/>
                                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetFormIntervalPresetCommand}" CommandParameter="15" Content="15m" Padding="6,2" FontSize="10"/>
                                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetFormIntervalPresetCommand}" CommandParameter="30" Content="30m" Padding="6,2" FontSize="10"/>
                                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetFormIntervalPresetCommand}" CommandParameter="45" Content="45m" Padding="6,2" FontSize="10"/>
                                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetFormIntervalPresetCommand}" CommandParameter="60" Content="1 Jam" Padding="6,2" FontSize="10"/>
                                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetFormIntervalPresetCommand}" CommandParameter="120" Content="2 Jam" Padding="6,2" FontSize="10"/>
                                    </WrapPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Opsi 2: Jam Harian Tertentu -->
                            <StackPanel Visibility="{Binding IsFormDailyTimeType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="Jam pengingat harian (pisahkan dengan koma, format HH:mm):" FontSize="10.5" Foreground="#98A2B8" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource ReminderInputBoxStyle}"
                                         Text="{Binding FormReminderDailyTimesText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Contoh: 07:00, 12:30, 19:30"/>
                                <TextBlock Text="Contoh: 08:00, 13:00, 20:00 (bisa 1 jam atau beberapa jam sekaligus dalam sehari)"
                                           FontSize="9.5" Foreground="#6E7890" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Catatan / Pesan -->
                            <TextBlock Text="Pesan / Catatan Dosis (Opsional):" FontSize="10.5" Foreground="#98A2B8" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ReminderInputBoxStyle}"
                                     Text="{Binding FormReminderNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"
                                     ToolTip="Contoh: 1 tablet sesudah makan, atau Minum 250ml air hangat"/>

                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding SaveReminderFormCommand}"
                                    Background="#0284C7" BorderBrush="#38BDF8" Foreground="#FFFFFF"
                                    Padding="12,7" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding ReminderFormSaveButtonText}" FontSize="12" FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 4. Active & Saved Reminders List -->
                    <Border Grid.Row="4" Background="#0D0D12" BorderBrush="#1E1E28" BorderThickness="1"
                            CornerRadius="12" Padding="8,6" Margin="0,0,0,10">
                        <ScrollViewer MaxHeight="265" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Reminders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,8" Margin="0,3"
                                                Background="#14141C" BorderBrush="#252534" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Baris Atas: Icon, Judul + Jadwal, Toggle Switch & Countdown -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon Badge -->
                                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                                            Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1"
                                                            Margin="0,0,9,0" VerticalAlignment="Center" Cursor="Hand"
                                                            ToolTip="Klik untuk mengaktifkan / menonaktifkan pengingat ini">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.ToggleReminderItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Path Data="{Binding IconGeometry}" Fill="{Binding AccentColor}"
                                                              Width="16" Height="16" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Title & Schedule Summary -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="185"/>
                                                            <Border Background="#1F2230" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#98A2B8" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding ScheduleSummaryText}" FontSize="10.5" Foreground="#A0A8BC"/>
                                                            <TextBlock Text=" • " FontSize="10.5" Foreground="#555568"
                                                                       Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}"/>
                                                            <TextBlock Text="{Binding NextTriggerFormatted, StringFormat='Berikutnya: {0}'}"
                                                                       FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold"
                                                                       Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Notes}" FontSize="10" Foreground="#77778E"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>

                                                    <!-- Right Status & Toggle -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <Button Style="{StaticResource SmallPillButton}"
                                                                Command="{Binding DataContext.ToggleReminderItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="8,3" Margin="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="#555566"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                                    <Setter Property="Fill" Value="#30D158"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Baris Bawah: Quick Actions (Selesai Sekarang, Snooze, Reset, Edit, Hapus) -->
                                                <DockPanel Grid.Row="1" Margin="43,6,0,0">
                                                    <!-- Badge jumlah selesai hari ini -->
                                                    <Border Background="#12281E" BorderBrush="#224E38" BorderThickness="1" CornerRadius="5" Padding="6,1.5"
                                                            VerticalAlignment="Center" Margin="0,0,6,0"
                                                            Visibility="{Binding HasCompletedToday, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding CompletedTodayBadgeText}" Foreground="#4CD964" FontSize="9.5" FontWeight="SemiBold"/>
                                                    </Border>

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                        <Button Style="{StaticResource SmallPillButton}"
                                                                Command="{Binding DataContext.CompleteReminderItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Background="#142C20" BorderBrush="#24523A" Foreground="#4CD964"
                                                                Padding="7,2" FontSize="10" ToolTip="Tandai sudah dilakukan sekarang &amp; mulai hitung siklus berikutnya">
                                                            <TextBlock Text="✓ Selesai"/>
                                                        </Button>
                                                        <Button Style="{StaticResource SmallPillButton}"
                                                                Command="{Binding DataContext.SnoozeReminderItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="6,2" FontSize="10" ToolTip="Tunda pengingat ini 10 menit">
                                                            <TextBlock Text="💤 +10m"/>
                                                        </Button>
                                                        <Button Style="{StaticResource SmallPillButton}"
                                                                Command="{Binding DataContext.ResetReminderTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="6,2" FontSize="10" ToolTip="Ulangi / mulai ulang timer dari sekarang">
                                                            <TextBlock Text="↻"/>
                                                        </Button>
                                                        <Button Style="{StaticResource SmallPillButton}"
                                                                Command="{Binding DataContext.OpenEditReminderFormCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="6,2" FontSize="10" ToolTip="Edit jadwal pengingat ini">
                                                            <TextBlock Text="✎"/>
                                                        </Button>
                                                        <Button Style="{StaticResource SmallPillButton}"
                                                                Command="{Binding DataContext.DeleteReminderItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Foreground="#FF6B8B" Padding="6,2" FontSize="10" ToolTip="Hapus pengingat ini">
                                                            <TextBlock Text="🗑"/>
                                                        </Button>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 5. Bottom Status & Actions -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding TestReminderAlertCommand}"
                                    Padding="9,4" Margin="0,0,6,0" ToolTip="Uji tampilan banner Dynamic Island &amp; suara pengingat sekarang">
                                <TextBlock Text="🔔 Tes Bunyi &amp; Banner" FontSize="10.5"/>
                            </Button>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource SmallPillButton}" Command="{Binding OpenSettingsCommand}"
                                Content="⚙ Pengaturan" Padding="9,4"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
