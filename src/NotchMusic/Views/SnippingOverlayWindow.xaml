<Window x:Class="NotchMusic.Views.SnippingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DRANOTCH - Snipping Tool"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="True"
        Cursor="Cross">

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- 1. Frozen Screen Image Underneath -->
        <Image x:Name="FrozenImage" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- 2. Dark Overlay with Cutout Mask (Excluded selection area is clear) -->
        <Path x:Name="DimPath" Fill="#77000000">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry x:Name="ScreenGeometry"/>
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry x:Name="SelectionGeometry"/>
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>

        <!-- 3. Selection Rectangle Outline -->
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <Border x:Name="SelectionBorder" BorderBrush="#00D2FF" BorderThickness="2" Background="Transparent"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect Color="#00D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                </Border.Effect>
            </Border>

            <!-- Sizing Badge -->
            <Border x:Name="DimensionBadge" Background="#E614141E" BorderBrush="#00D2FF" BorderThickness="1.2"
                    CornerRadius="8" Padding="10,5" Visibility="Collapsed" MaxWidth="420">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.6"/>
                </Border.Effect>
                <TextBlock x:Name="DimensionText" Text="0 × 0 px" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Canvas>

        <!-- 4. Top Floating Toolbar -->
        <Border x:Name="TopToolbar" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                Background="#181820" BorderBrush="#2C2C3C" BorderThickness="1.2"
                CornerRadius="24" Padding="12,6" Cursor="Arrow">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Title & Drag Icon -->
                <TextBlock Text="✂️ DRANOTCH Snip" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                           VerticalAlignment="Center" Margin="4,0,10,0"/>

                <Border Width="1" Height="18" Background="#2C2C3C" Margin="0,0,8,0"/>

                <!-- Rectangular Snip -->
                <Button x:Name="BtnRectSnip" Content="📐 Area Kotak" Click="BtnRectSnip_Click"
                        Background="#00D2FF" Foreground="#000000" FontWeight="SemiBold" FontSize="11"
                        Padding="10,5" BorderThickness="0" Margin="2,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Fullscreen Snip -->
                <Button x:Name="BtnFullScreenSnip" Content="🖥️ Layar Penuh" Click="BtnFullScreenSnip_Click"
                        Background="#262634" Foreground="#D4D4E0" FontWeight="SemiBold" FontSize="11"
                        Padding="10,5" BorderThickness="0" Margin="2,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Active Window Snip -->
                <Button x:Name="BtnWindowSnip" Content="🪟 Pilih Jendela Form" Click="BtnWindowSnip_Click"
                        Background="#262634" Foreground="#D4D4E0" FontWeight="SemiBold" FontSize="11"
                        Padding="10,5" BorderThickness="0" Margin="2,0" Cursor="Hand"
                        ToolTip="Pilih dan klik form/jendela yang ingin dicapture">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Border Width="1" Height="18" Background="#2C2C3C" Margin="6,0"/>

                <!-- Multi-Snip Toggle Button -->
                <Button x:Name="BtnMultiSnip" Content="⚡ Multi-Snip: Nonaktif" Click="BtnMultiSnip_Click"
                        Background="#262634" Foreground="#D4D4E0" FontWeight="Bold" FontSize="11"
                        Padding="10,5" BorderThickness="0" Margin="2,0" Cursor="Hand"
                        ToolTip="Mode Banyak Snip: Tangkap banyak screenshot berturut-turut tanpa menutup overlay snipping tool!">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Snip Count Badge -->
                <Border x:Name="SnipCountBadge" Background="#10B981" CornerRadius="12" Padding="8,4" Margin="6,0,2,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="SnipCountText" Text="📸 0 Tersimpan" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                </Border>

                <!-- Done & Open Gallery Button -->
                <Button x:Name="BtnDone" Content="✔️ Buka Galeri" Click="BtnDone_Click"
                        Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"
                        Padding="10,5" BorderThickness="0" Margin="4,0,2,0" Cursor="Hand"
                        Visibility="Collapsed">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Border Width="1" Height="18" Background="#2C2C3C" Margin="6,0"/>

                <!-- Close / Cancel Button -->
                <Button x:Name="BtnClose" Content="✕ Batal (Esc)" Click="BtnClose_Click"
                        Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"
                        Padding="10,5" BorderThickness="0" Margin="2,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- Instruction Banner for Window Mode -->
        <Border x:Name="WindowModeHintBanner" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0"
                Background="#EE14141E" BorderBrush="#00D2FF" BorderThickness="1.2" CornerRadius="16" Padding="14,6"
                Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🪟" FontSize="13" Margin="0,0,6,0"/>
                <TextBlock Text="Arahkan kursor ke jendela / form yang ingin dicapture, lalu KLIK untuk mengambil tangkapan layar."
                           Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- 5. Toast Feedback Notification at Bottom -->
        <Border x:Name="ToastNotification" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
                Background="#10B981" CornerRadius="16" Padding="16,8" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <TextBlock x:Name="ToastText" Text="📸 Tangkapan layar tersimpan &amp; disalin ke Clipboard!"
                       Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
        </Border>
    </Grid>
</Window>
