<Window x:Class="NotchMusic.Views.ScreenshotHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NotchMusic.Helpers"
        Title="DRANOTCH - Tangkapan Layar &amp; Snipping Hub"
        Width="960" Height="640"
        MinWidth="700" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="{Binding Settings.AlwaysOnTop}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <helpers:CountToVisibilityConverter x:Key="CountToVis"/>
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>

        <LinearGradientBrush x:Key="MetallicSilverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#E2E6F0" Offset="0.35"/>
            <GradientStop Color="#949BA8" Offset="0.72"/>
            <GradientStop Color="#D4D9E6" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="SmallPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E26"/>
            <Setter Property="Foreground" Value="#D4D4E0"/>
            <Setter Property="BorderBrush" Value="#2E2E3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2C2C3A"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4E4E66"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#38384A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryCyanPillButton" TargetType="Button">
            <Setter Property="Background" Value="#00D2FF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#33DCFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#00B8E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#141418"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#00D2FF"/>
            <Setter Property="BorderBrush" Value="#282834"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#00D2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="TransparentThumbTemplate" TargetType="Thumb">
            <Border Background="Transparent"/>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <!-- Outer Container with Luxury Glow Shadow -->
        <Border x:Name="RootBorder" Margin="10" CornerRadius="16" Background="#101014" BorderBrush="#252530" BorderThickness="1.2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.55" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- 0: Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- 1: Top Actions Toolbar -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2: Split Content (Gallery list + Editor preview) -->
                    <RowDefinition Height="*"/>
                    <!-- 3: Bottom Status Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ROW 0: WINDOW TITLE BAR (Draggable & Double-Click Maximize) -->
                <Border Grid.Row="0" Background="#16161D" CornerRadius="16,16,0,0" Padding="14,10"
                        BorderBrush="#252530" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon & Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#1E1E28"
                                    BorderBrush="#353545" BorderThickness="1" Margin="0,0,10,0">
                                <TextBlock Text="✂️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Tangkapan Layar &amp; Snipping Hub" FontSize="13.5" FontWeight="Bold"
                                       Foreground="{StaticResource MetallicSilverBrush}" VerticalAlignment="Center"/>
                            <Border Background="#1E1E2A" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderBadgeText" Text="0 Gambar" FontSize="10.5" FontWeight="SemiBold" Foreground="#00D2FF"/>
                            </Border>
                        </StackPanel>

                        <!-- Window Controls (Minimize, Maximize/Restore, Close) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallPillButton}" Content="🗕" Click="BtnMinimize_Click" ToolTip="Kecilkan" Margin="0,0,4,0"/>
                            <Button x:Name="BtnMaximize" Style="{StaticResource SmallPillButton}" Content="🗖" Click="BtnMaximize_Click" ToolTip="Perbesar / Kembalikan Ukuran" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource SmallPillButton}" Content="✕" Click="BtnClose_Click" ToolTip="Tutup" Background="#261616" Foreground="#FF6666"/>
                        </StackPanel>
                    </Grid>
                </Border>

            <!-- ROW 1: TOP ACTIONS & SEARCH BAR -->
            <Border Grid.Row="1" Background="#14141A" Padding="14,10" BorderBrush="#20202A" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Primary Snip Actions -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryCyanPillButton}" Content="✂️ Snip Area (Kotak)"
                                Click="BtnNewSnip_Click" ToolTip="Ambil tangkapan layar baru dengan seleksi kotak (Shortcut: Ctrl+Alt+S)"/>
                        <Button Style="{StaticResource SmallPillButton}" Content="🖥️ Layar Penuh"
                                Click="BtnFullScreen_Click" ToolTip="Tangkap seluruh monitor" Margin="4,0,2,0"/>
                        <Button Style="{StaticResource SmallPillButton}" Content="🪟 Jendela Aktif"
                                Click="BtnActiveWindow_Click" ToolTip="Tangkap jendela aplikasi aktif" Margin="2,0"/>
                    </StackPanel>

                    <!-- Search Box -->
                    <Grid Grid.Column="1" Margin="14,0" VerticalAlignment="Center" MaxWidth="320">
                        <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBox}"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="🔍 Cari judul atau tanggal..." Foreground="#666677" FontSize="11.5"
                                   VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False"
                                   Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- Batch & Folder Tools -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnSyncDrive" Style="{StaticResource SmallPillButton}" Content="☁️ Sync Drive"
                                Click="BtnSyncDrive_Click" ToolTip="Sinkronisasi 2 arah dengan Google Drive (DRANOTCH/Screenshots)" Margin="0,0,4,0"/>
                        <Button Style="{StaticResource SmallPillButton}" Content="📂 Buka Folder"
                                Click="BtnOpenFolder_Click" ToolTip="Buka folder tempat gambar tersimpan di File Explorer"/>
                        <Button Style="{StaticResource SmallPillButton}" Content="📦 Ekspor Semua"
                                Click="BtnExportAll_Click" ToolTip="Ekspor semua tangkapan layar ke folder pilihan" Margin="4,0,2,0"/>
                        <Button Style="{StaticResource SmallPillButton}" Content="🧹 Hapus Semua"
                                Click="BtnClearAll_Click" ToolTip="Hapus semua tangkapan layar yang tersimpan"
                                Foreground="#FF7777" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 2: SPLIT CONTENT (GALLERY LIST & DETAIL STUDIO) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- Column 0: Gallery List -->
                    <ColumnDefinition Width="340" MinWidth="260" MaxWidth="460"/>
                    <!-- Splitter -->
                    <ColumnDefinition Width="5"/>
                    <!-- Column 1: Detail Preview & Annotations -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: GALLERY THUMBNAIL LIST -->
                <Border Grid.Column="0" Background="#121217" BorderBrush="#20202A" BorderThickness="0,0,1,0">
                    <Grid>
                        <!-- List of Screenshots -->
                        <ListBox x:Name="ScreenshotsListBox" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="ScreenshotsListBox_SelectionChanged"
                                 Padding="8">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="#181822" BorderBrush="#282836"
                                                        BorderThickness="1.2" CornerRadius="10" Padding="8" Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#22222E"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3D3D52"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1E2838"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#00D2FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Thumbnail Image Preview -->
                                        <Border Grid.Column="0" Width="80" Height="60" CornerRadius="6"
                                                Background="#0A0A0E" BorderBrush="#2A2A38" BorderThickness="1"
                                                ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Metadata & Actions -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontWeight="Bold"
                                                       FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FormattedDate}" Foreground="#9999A8" FontSize="10.5" Margin="0,2,0,0"/>
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Background="#242434" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding FormattedResolution}" Foreground="#00D2FF" FontSize="9.5" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="#242434" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding FormattedFileSize}" Foreground="#AAAABC" FontSize="9.5"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty State when list is empty -->
                        <StackPanel x:Name="EmptyGalleryPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="20" Visibility="Collapsed">
                            <TextBlock Text="📷" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Belum Ada Tangkapan Layar" Foreground="#FFFFFF" FontWeight="Bold"
                                       FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="Klik tombol 'Snip Area' di atas atau tekan Ctrl+Alt+S untuk mulai mengambil screenshot."
                                       Foreground="#888899" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="0,6,0,14" MaxWidth="220"/>
                            <Button Style="{StaticResource PrimaryCyanPillButton}" Content="✂️ Ambil Snip Sekarang"
                                    Click="BtnNewSnip_Click" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GridSplitter between panels -->
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#1A1A22" Cursor="SizeWE"/>

                <!-- RIGHT: PREVIEW & ANNOTATION STUDIO -->
                <Grid Grid.Column="2" Background="#0E0E12">
                    <!-- When an item is selected -->
                    <Grid x:Name="DetailStudioGrid" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <!-- 0: Detail Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- 1: Markup Toolbar -->
                            <RowDefinition Height="Auto"/>
                            <!-- 2: Interactive Zoomable Image Canvas -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Detail Header -->
                        <Border Grid.Row="0" Background="#16161D" Padding="14,10" BorderBrush="#20202A" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Title Editing -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBox x:Name="DetailTitleBox" Style="{StaticResource ModernTextBox}"
                                             FontWeight="Bold" FontSize="13" LostFocus="DetailTitleBox_LostFocus"
                                             KeyDown="DetailTitleBox_KeyDown"/>
                                    <TextBlock x:Name="DetailInfoText" Text="1920 × 1080 px • 320 KB • 06/11/2026 13:25"
                                               Foreground="#888899" FontSize="11" Margin="4,4,0,0"/>
                                </StackPanel>

                                <!-- Actions for selected image -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Button Style="{StaticResource PrimaryCyanPillButton}" Content="📋 Salin Gambar"
                                            Click="BtnCopySelected_Click" ToolTip="Salin gambar ke Clipboard (Ctrl+C)"/>
                                    <Button Style="{StaticResource SmallPillButton}" Content="📌 Pin ke Layar"
                                            Click="BtnPinSelected_Click" ToolTip="Sematkan gambar melayang di desktop" Margin="4,0,2,0"/>
                                    <Button Style="{StaticResource SmallPillButton}" Content="💾 Simpan Sebagai..."
                                            Click="BtnSaveAsSelected_Click" ToolTip="Simpan file ke folder pilihan (Ctrl+S)" Margin="2,0"/>
                                    <Button Style="{StaticResource SmallPillButton}" Content="🗑️ Hapus"
                                            Click="BtnDeleteSelected_Click" ToolTip="Hapus tangkapan layar ini"
                                            Foreground="#FF7777" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Markup Toolbar -->
                        <Border Grid.Row="1" Background="#13131A" Padding="12,6" BorderBrush="#20202A" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Drawing Tools -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnToolSelect" Content="👆 Pilihan" Click="BtnToolSelect_Click"
                                            Style="{StaticResource SmallPillButton}" Background="#00D2FF" Foreground="#000000" FontWeight="Bold"/>
                                    <Button x:Name="BtnToolPen" Content="✏️ Pena" Click="BtnToolPen_Click"
                                            Style="{StaticResource SmallPillButton}" Margin="4,0,2,0"/>
                                    <Button x:Name="BtnToolHighlighter" Content="🖍️ Stabilo" Click="BtnToolHighlighter_Click"
                                            Style="{StaticResource SmallPillButton}" Margin="2,0"/>

                                    <Border Width="1" Height="16" Background="#2C2C3C" Margin="6,0"/>

                                    <!-- Color Swatches -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="18" CornerRadius="9" Background="#EF4444" Margin="3,0"
                                                Cursor="Hand" MouseDown="ColorSwatch_MouseDown" Tag="#EF4444" ToolTip="Merah"/>
                                        <Border Width="18" Height="18" CornerRadius="9" Background="#F59E0B" Margin="3,0"
                                                Cursor="Hand" MouseDown="ColorSwatch_MouseDown" Tag="#F59E0B" ToolTip="Kuning"/>
                                        <Border Width="18" Height="18" CornerRadius="9" Background="#10B981" Margin="3,0"
                                                Cursor="Hand" MouseDown="ColorSwatch_MouseDown" Tag="#10B981" ToolTip="Hijau"/>
                                        <Border Width="18" Height="18" CornerRadius="9" Background="#00D2FF" Margin="3,0"
                                                Cursor="Hand" MouseDown="ColorSwatch_MouseDown" Tag="#00D2FF" ToolTip="Sian"/>
                                        <Border Width="18" Height="18" CornerRadius="9" Background="#FFFFFF" Margin="3,0"
                                                Cursor="Hand" MouseDown="ColorSwatch_MouseDown" Tag="#FFFFFF" ToolTip="Putih"/>
                                    </StackPanel>

                                    <Border Width="1" Height="16" Background="#2C2C3C" Margin="6,0"/>

                                    <Button Content="↩️ Undo" Click="BtnUndoStroke_Click" Style="{StaticResource SmallPillButton}" ToolTip="Batalkan coretan terakhir"/>
                                    <Button Content="💾 Simpan Coretan" Click="BtnSaveAnnotations_Click" Style="{StaticResource SmallPillButton}"
                                            Foreground="#10B981" ToolTip="Simpan coretan ke gambar permanen" Margin="4,0,0,0"/>
                                </StackPanel>

                                <!-- Zoom Controls -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="➖" Click="BtnZoomOut_Click" Style="{StaticResource SmallPillButton}" ToolTip="Perkecil"/>
                                    <TextBlock x:Name="ZoomLevelText" Text="100%" Foreground="#AAAAAA" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,0" MinWidth="36" TextAlignment="Center"/>
                                    <Button Content="➕" Click="BtnZoomIn_Click" Style="{StaticResource SmallPillButton}" ToolTip="Perbesar"/>
                                    <Button Content="Pas Layar" Click="BtnZoomFit_Click" Style="{StaticResource SmallPillButton}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Interactive Image & InkCanvas Container -->
                        <ScrollViewer Grid.Row="2" x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto" Background="#0B0B0E" Focusable="True">
                            <Grid x:Name="CanvasContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14">
                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                                </Grid.LayoutTransform>

                                <!-- Shadow border for previewed screenshot -->
                                <Border Background="#000000" CornerRadius="6" BorderBrush="#252535" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                                    </Border.Effect>
                                    <Grid>
                                        <!-- Real Image -->
                                        <Image x:Name="DetailImage" Stretch="None"/>
                                        <!-- Transparent InkCanvas for markup layered on top -->
                                        <InkCanvas x:Name="DetailInkCanvas" Background="Transparent"
                                                   EditingMode="None"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- Empty state when no screenshot is selected -->
                    <StackPanel x:Name="NoSelectionPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="🖼️" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Pilih Tangkapan Layar dari Galeri" Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ROW 3: BOTTOM STATUS BAR -->
            <Border Grid.Row="3" Background="#141418" Padding="14,6" BorderBrush="#202028" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="💡 Tips: Gunakan shortcut Ctrl+Alt+S kapan saja untuk mengambil screenshot. Mode Multi-Snip memungkinkan Anda mengambil banyak snip berturut-turut tanpa jeda!"
                               Foreground="#777788" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" x:Name="StoragePathText" Text="" Foreground="#555566" FontSize="10.5"
                               VerticalAlignment="Center"/>

                    <!-- Visual Resize Grip Indicator in Bottom Right -->
                    <Border Grid.Column="2" Width="14" Height="14" Margin="8,0,0,0" Cursor="SizeNWSE"
                            Background="Transparent" ToolTip="Tarik untuk mengubah ukuran jendela"
                            VerticalAlignment="Center">
                        <Path Data="M 12,2 L 2,12 M 12,6 L 6,12 M 12,10 L 10,12"
                              Stroke="#555568" StrokeThickness="1.2"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>

    <!-- 8 Direction Resizing Thumbs -->
    <!-- 4 Edges -->
    <Thumb x:Name="ResizeLeft" Width="8" HorizontalAlignment="Left" Cursor="SizeWE"
           DragDelta="ResizeLeft_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
           Template="{StaticResource TransparentThumbTemplate}"/>
    <Thumb x:Name="ResizeRight" Width="8" HorizontalAlignment="Right" Cursor="SizeWE"
           DragDelta="ResizeRight_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
           Template="{StaticResource TransparentThumbTemplate}"/>
    <Thumb x:Name="ResizeTop" Height="8" VerticalAlignment="Top" Cursor="SizeNS"
           DragDelta="ResizeTop_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
           Template="{StaticResource TransparentThumbTemplate}"/>
    <Thumb x:Name="ResizeBottom" Height="8" VerticalAlignment="Bottom" Cursor="SizeNS"
           DragDelta="ResizeBottom_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
           Template="{StaticResource TransparentThumbTemplate}"/>

    <!-- 4 Corners -->
    <Thumb x:Name="ResizeTopLeft" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"
           DragDelta="ResizeTopLeft_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
           Template="{StaticResource TransparentThumbTemplate}"/>
    <Thumb x:Name="ResizeTopRight" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"
           DragDelta="ResizeTopRight_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
           Template="{StaticResource TransparentThumbTemplate}"/>
    <Thumb x:Name="ResizeBottomLeft" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"
           DragDelta="ResizeBottomLeft_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
           Template="{StaticResource TransparentThumbTemplate}"/>
    <Thumb x:Name="ResizeBottomRight" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
           DragDelta="ResizeBottomRight_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
           Template="{StaticResource TransparentThumbTemplate}"/>
