<Window x:Class="NotchMusic.Views.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NotchMusic.Helpers"
        Title="DRANOTCH - To-Do List"
        Width="430" Height="520" MinWidth="360" MinHeight="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="{Binding Settings.AlwaysOnTop}"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <!-- Quick Preset Deadline Button Style -->
        <Style x:Key="QuickPresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20202A"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2E2E3C"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2C2C3A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Resize Thumb Templates -->
        <ControlTemplate x:Key="TransparentThumbTemplate" TargetType="Thumb">
            <Border Background="Transparent"/>
        </ControlTemplate>

        <ControlTemplate x:Key="ResizeGripThumbTemplate" TargetType="Thumb">
            <Grid Background="Transparent" Width="22" Height="22" ToolTip="Tarik untuk mengubah ukuran (Resize)">
                <Path x:Name="GripLines"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,6,6"
                      Data="M 12,2 L 2,12 M 12,6 L 6,12 M 12,10 L 10,12"
                      Stroke="#555566" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="GripLines" Property="Stroke" Value="#D4D9E6"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="GripLines" Property="Stroke" Value="#FFFFFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <LinearGradientBrush x:Key="MetallicSilverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#E2E6F0" Offset="0.35"/>
            <GradientStop Color="#949BA8" Offset="0.72"/>
            <GradientStop Color="#D4D9E6" Offset="1.0"/>
        </LinearGradientBrush>

        <Geometry x:Key="LuxuryTodoIconGeometry">M 9.2,11.3 L 11.6,13.7 L 18.2,7.1 L 20.1,9.0 L 11.6,17.5 L 7.3,13.2 Z M 5.5,3.2 H 14.2 V 5.5 H 5.8 V 18.2 H 18.5 V 12.8 H 20.8 V 18.5 A 2.3,2.3 0 0 1 18.5,20.8 H 5.5 A 2.3,2.3 0 0 1 3.2,18.5 V 5.5 A 2.3,2.3 0 0 1 5.5,3.2 Z</Geometry>

        <!-- Control Button Style (for compact quick complete) -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Pill Button Style -->
        <Style x:Key="SmallPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A2A34"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill Button Style -->
        <Style x:Key="FilterPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#18181E"/>
            <Setter Property="Foreground" Value="#888899"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#262630"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom CheckBox for To-Do -->
        <Style x:Key="TodoCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="BoxBorder" Width="18" Height="18" CornerRadius="5"
                                Background="#16161C" BorderBrush="#383842" BorderThickness="1.2">
                            <Path x:Name="CheckMark" Data="M 3 8 L 7 12 L 14 4" Stroke="#000000" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete Button for To-Do Item -->
        <Style x:Key="TodoDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555566"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DelBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DelBorder" Property="Background" Value="#33FF4D6D"/>
                                <Setter Property="Foreground" Value="#FF6B8B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox for To-Do -->
        <Style x:Key="TodoTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#141418"/>
            <Setter Property="Foreground" Value="#EDEDF5"/>
            <Setter Property="BorderBrush" Value="#2E2E36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Category ComboBox Style -->
        <Style x:Key="DarkCategoryComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#141418"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#2E2E36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Background="Transparent"
                                             Foreground="{TemplateBinding Foreground}"
                                             BorderThickness="0"
                                             Padding="6,2,0,2"
                                             FontSize="{TemplateBinding FontSize}"
                                             VerticalContentAlignment="Center"
                                             CaretBrush="#FFFFFF"/>
                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="#888899" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!-- Popup Dropdown List -->
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PopupAnimation="Slide">
                                <Border Background="#141418" BorderBrush="#2E2E36" BorderThickness="1" CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="160" Padding="3" Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4A4A58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#E2E2EA"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#24242E"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#32323E"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
            <!-- Tombol Panah Pindah Kategori Up / Down -->
        <Style x:Key="CategoryOrderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#181824"/>
            <Setter Property="Foreground" Value="#7E859E"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI"/>
            <Setter Property="BorderBrush" Value="#2E2E3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2E2E44"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#555577"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3F3F5A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="TodoContainerBorder"
                Background="#0A0A0C"
                BorderBrush="#24242A"
                BorderThickness="1.2"
                CornerRadius="20"
                MouseDown="Border_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.65"/>
            </Border.Effect>

            <Grid>
                <!-- ================= MODE 1: COMPACT TO-DO NOTCH ================= -->
                <Grid x:Name="TodoCompactView"
                      Visibility="{Binding IsTodoWindowCompact, Converter={StaticResource BoolToVis}}"
                      Height="48" Margin="8,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- To-Do Icon Badge -->
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9" Margin="2,0,8,0" Background="#1C1C26" BorderBrush="#38FFFFFF" BorderThickness="1">
                        <Path Data="{StaticResource LuxuryTodoIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                              Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Ticker Task Info (Click to Expand) -->
                    <Border Grid.Column="1" Background="#141418" BorderBrush="#24242A" BorderThickness="1.2"
                            CornerRadius="12" Height="32" Margin="0,0,6,0" Padding="8,2" Cursor="Hand"
                            ToolTip="{Binding CurrentTickerText, StringFormat='To-Do: {0} (Klik untuk buka daftar)'}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ExpandTodoWindowCommand}"/>
                        </Border.InputBindings>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Badge Jumlah Tugas -->
                            <Border Grid.Column="0" Background="#222228" CornerRadius="5" Padding="4,1" Margin="0,0,5,0"
                                    VerticalAlignment="Center" Visibility="{Binding HasPendingTodos, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding CurrentTickerBadge}" Foreground="#CCCCCC" FontSize="9.5" FontWeight="SemiBold"/>
                            </Border>

                            <helpers:MarqueeTextBlock Grid.Column="1" Text="{Binding CurrentTickerText}" 
                                                      Foreground="#EDEDF5" FontSize="11.5" FontWeight="Medium"
                                                      Speed="36" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Quick Complete Button -->
                    <Button Grid.Column="2" Command="{Binding CompleteCurrentTickerCommand}"
                            ToolTip="Tandai tugas selesai" Style="{StaticResource ControlButtonStyle}"
                            Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,4,0"
                            Visibility="{Binding HasPendingTodos, Converter={StaticResource BoolToVis}}">
                        <Border Width="22" Height="22" CornerRadius="6" Background="#18181C" BorderBrush="#2E2E36" BorderThickness="1">
                            <TextBlock Text="✓" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>

                    <!-- Actions (Expand, Pasang, Close) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding ExpandTodoWindowCommand}" Content="&#x25BE;" ToolTip="Perluas To-Do"/>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding AttachTodoCommand}" ToolTip="Pasang kembali ke musik" Margin="2,0,0,0">
                            <TextBlock Text="&#x21F2;" FontSize="11"/>
                        </Button>

                    </StackPanel>
                </Grid>

                <!-- ================= MODE 2: EXPANDED TO-DO LIST ================= -->
                <Grid x:Name="TodoExpandedView"
                      Visibility="{Binding IsTodoWindowExpanded, Converter={StaticResource BoolToVis}}"
                      Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Filter Tabs & Categories -->
                        <RowDefinition Height="Auto"/> <!-- Input New Task -->
                        <RowDefinition Height="*"/>    <!-- Task List -->
                    </Grid.RowDefinitions>

                    <!-- Header: Judul, Ringkasan, Sinkronisasi, Pasang Kembali, Tutup -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                        <!-- Action Buttons docked right so they are never clipped -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Tombol Pasang Kembali ke Panel Musik -->
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding AttachTodoCommand}"
                                    Content="&#x21F2;" ToolTip="Pasang kembali To-Do List ke panel utama" Margin="0,0,4,0"/>

                            <!-- Tombol Tutup ke Compact (Minimize) -->
                            <!-- Tombol Tutup ke Compact (Minimize) -->
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding MinimizeTodoWindowCommand}"
                                    Content="&#x25B4;" ToolTip="Perkecil (Minimize)" Margin="0"/>


                            <!-- Tombol Tutup / Sembunyikan -->


                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="7" Background="#1C1C26" BorderBrush="#38FFFFFF" BorderThickness="1" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource LuxuryTodoIconGeometry}" Fill="{StaticResource MetallicSilverBrush}"
                                      Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="To-Do List" Foreground="#FFFFFF" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Background="#1A1A20" CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TodoSummaryText}" Foreground="#CCCCCC" FontSize="10.5" FontWeight="Medium"/>
                            </Border>

                            <!-- Tombol Status Google Drive (Klik untuk Login / Sync) -->
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding SyncGoogleDriveCommand}"
                                    ToolTip="{Binding GoogleDriveSyncTooltip}" Padding="6,2" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="☁" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFAA44"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGoogleDriveConnected}" Value="True">
                                                        <Setter Property="Foreground" Value="#4CD964"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding GoogleDriveStatusButtonText}" FontSize="10" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#BBBBCC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGoogleDriveConnected}" Value="True">
                                                        <Setter Property="Foreground" Value="#EEEEEE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                <!-- Filter Tabs & Actions -->
                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Filter Tabs -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Style="{StaticResource FilterPillStyle}" Command="{Binding SetTodoFilterCommand}" CommandParameter="All">
                                <TextBlock Text="Semua">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAllFilterSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource FilterPillStyle}" Command="{Binding SetTodoFilterCommand}" CommandParameter="Active">
                                <TextBlock Text="Aktif">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActiveFilterSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource FilterPillStyle}" Command="{Binding SetTodoFilterCommand}" CommandParameter="Completed">
                                <TextBlock Text="Selesai">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompletedFilterSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>

                        <!-- Bersihkan Tugas Selesai -->
                        <Button Grid.Column="1" Style="{StaticResource SmallPillButton}" Command="{Binding ClearCompletedTodosCommand}" 
                                Visibility="{Binding HasCompletedTodos, Converter={StaticResource BoolToVis}}"
                                ToolTip="Hapus semua tugas yang selesai" Padding="6,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑" FontSize="10" Margin="0,0,3,0"/>
                                <TextBlock Text="Bersihkan Selesai" FontSize="10.5"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Kategori Filter Chips -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasCategories, Converter={StaticResource BoolToVis}}" Margin="0,5,0,0">
                        <ItemsControl ItemsSource="{Binding AvailableCategories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FilterPillStyle}"
                                            Command="{Binding DataContext.SetCategoryFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,4,0" Padding="6,1.5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="#" Foreground="#888888" FontSize="9" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="#B0B0C0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Input Tugas Baru -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <!-- Active Target Deadline Pill -->
                    <Border Visibility="{Binding HasNewTodoDueDate, Converter={StaticResource BoolToVis}}"
                            Background="#281A10" BorderBrush="#FFAA00" BorderThickness="1" CornerRadius="6"
                            Padding="8,2" Margin="0,0,0,6" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z M 11.25,6.5 L 11.25,12.5 L 15.5,15 L 16.25,13.75 L 12.75,11.75 L 12.75,6.5 Z"
                                  Width="11" Height="11" Stretch="Uniform" Fill="#FFAA00" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Target: " Foreground="#FFAA00" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding NewTodoDueDateText}" Foreground="#FFD080" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Command="{Binding ClearNewTodoDueDateCommand}" Background="Transparent" BorderThickness="0"
                                    Foreground="#FFAA00" Cursor="Hand" Padding="2,0" VerticalAlignment="Center" ToolTip="Batalkan target waktu">
                                <TextBlock Text="&#x2715;" FontSize="10" FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Dropdown / Input Kategori -->
                            <ColumnDefinition Width="90"/>
                            <!-- Input Teks Tugas -->
                            <ColumnDefinition Width="*"/>
                            <!-- Tombol Target Waktu (Vector Clock Icon) -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Tombol Tambah (+) -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" 
                                  IsEditable="True"
                                  ItemsSource="{Binding ExistingCategories}"
                                  Text="{Binding NewTodoCategory, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource DarkCategoryComboBoxStyle}"
                                  Margin="0,0,5,0" VerticalAlignment="Center"
                                  ToolTip="Pilih atau ketik kategori/tag tugas (misal: KERJA)"/>

                        <Grid Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBox x:Name="NewTodoTextBox" 
                                     Text="{Binding NewTodoTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TodoTextBoxStyle}" VerticalAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddTodoCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <!-- Watermark -->
                            <TextBlock Text="Tulis tugas lalu Enter..." Foreground="#666677" FontSize="11"
                                       IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NewTodoTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Tombol Target Waktu (Vector Clock Icon - High Contrast) -->
                        <Border Grid.Column="2" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Button x:Name="TodoWindowDeadlineButton"
                                    Command="{Binding ToggleSetDeadlineCommand}"
                                    ToolTip="Atur target tanggal dan jam selesai"
                                    Width="28" Height="28" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#252533"/>
                                        <Setter Property="BorderBrush" Value="#404054"/>
                                        <Setter Property="Foreground" Value="#DCDCEE"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNewTodoDueDate}" Value="True">
                                                <Setter Property="Background" Value="#382410"/>
                                                <Setter Property="BorderBrush" Value="#FFAA00"/>
                                                <Setter Property="Foreground" Value="#FFAA00"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#343448"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#686888"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1.5" CornerRadius="8">
                                            <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z M 11.25,6.5 L 11.25,12.5 L 15.5,15 L 16.25,13.75 L 12.75,11.75 L 12.75,6.5 Z"
                                                  Width="14" Height="14" Stretch="Uniform" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>

                        <!-- Popup Pilihan Deadline -->
                        <Popup IsOpen="{Binding IsSettingNewTodoDeadline, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=TodoWindowDeadlineButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="#16161D" BorderBrush="#343444" BorderThickness="1.5" CornerRadius="10"
                                    Padding="10" Margin="0,4,0,0" Width="280">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Command="{Binding ToggleSetDeadlineCommand}"
                                                Background="Transparent" BorderThickness="0" Foreground="#888899" Cursor="Hand" Padding="4,0" ToolTip="Tutup">
                                            <TextBlock Text="&#x2715;" FontSize="12" FontWeight="Bold"/>
                                        </Button>
                                        <TextBlock Text="Target Waktu Selesai" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5"/>
                                    </DockPanel>

                                    <!-- Quick Presets -->
                                    <TextBlock Text="Pilihan Cepat:" Foreground="#888899" FontSize="10" Margin="0,0,0,4"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Command="{Binding SetDeadlinePresetCommand}" CommandParameter="plus_1h"
                                                Content="+1 Jam" Style="{StaticResource QuickPresetButtonStyle}"/>
                                        <Button Command="{Binding SetDeadlinePresetCommand}" CommandParameter="plus_3h"
                                                Content="+3 Jam" Style="{StaticResource QuickPresetButtonStyle}"/>
                                        <Button Command="{Binding SetDeadlinePresetCommand}" CommandParameter="today_17"
                                                Content="Hari ini 17:00" Style="{StaticResource QuickPresetButtonStyle}"/>
                                        <Button Command="{Binding SetDeadlinePresetCommand}" CommandParameter="today_21"
                                                Content="Malam 21:00" Style="{StaticResource QuickPresetButtonStyle}"/>
                                        <Button Command="{Binding SetDeadlinePresetCommand}" CommandParameter="tomorrow_09"
                                                Content="Besok 09:00" Style="{StaticResource QuickPresetButtonStyle}"/>
                                        <Button Command="{Binding SetDeadlinePresetCommand}" CommandParameter="tomorrow_17"
                                                Content="Besok 17:00" Style="{StaticResource QuickPresetButtonStyle}"/>
                                    </WrapPanel>

                                    <!-- Divider -->
                                    <Border Height="1" Background="#262632" Margin="0,0,0,8"/>

                                    <!-- Kustom Tanggal & Jam -->
                                    <TextBlock Text="Kustom Tanggal &amp; Jam:" Foreground="#888899" FontSize="10" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <DatePicker SelectedDate="{Binding CustomDeadlineDate, Mode=TwoWay}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding CustomDeadlineHour, Mode=TwoWay}" Width="32" Height="26"
                                                 Style="{StaticResource TodoTextBoxStyle}" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                                 ToolTip="Jam (0-23)"/>
                                        <TextBlock Grid.Column="1" Text=":" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" Margin="34,0,0,0" HorizontalAlignment="Right"/>
                                        <TextBox Grid.Column="2" Text="{Binding CustomDeadlineMinute, Mode=TwoWay}" Width="32" Height="26"
                                                 Style="{StaticResource TodoTextBoxStyle}" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                                 ToolTip="Menit (0-59)" Margin="4,0,0,0"/>
                                    </Grid>

                                    <DockPanel LastChildFill="False">
                                        <Button DockPanel.Dock="Left" Command="{Binding ClearNewTodoDueDateCommand}"
                                                Visibility="{Binding HasNewTodoDueDate, Converter={StaticResource BoolToVis}}"
                                                Content="Hapus Target" Background="Transparent" Foreground="#FF6B8B" BorderThickness="0"
                                                FontSize="11" Cursor="Hand" Padding="0,4"/>
                                        <Button DockPanel.Dock="Right" Command="{Binding ApplyCustomDeadlineCommand}"
                                                Content="Terapkan" Background="#4D96FF" Foreground="#FFFFFF" BorderThickness="0"
                                                FontSize="11" FontWeight="SemiBold" Cursor="Hand" Padding="12,5">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Tombol Tambah (+) -->
                        <Button Grid.Column="3" Command="{Binding AddTodoCommand}" ToolTip="Tambah Tugas"
                                Background="#FFFFFF" Foreground="#000000" Width="28" Height="28" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                   FontWeight="Bold" FontSize="15" Foreground="#000000"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Daftar Tugas (Scrollable) -->
                <Border Grid.Row="3" Background="#0E0E12" CornerRadius="10" Padding="6,4">
                    <Grid>
                        <!-- Tampilan saat kosong -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding FilteredTodos.IsEmpty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="🎉" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Tidak ada tugas saat ini" Foreground="#666677" FontSize="11.5" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- List Item -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                            <ItemsControl ItemsSource="{Binding FilteredTodos}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="{x:Type GroupItem}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                            <StackPanel Margin="0,3,0,6">
                                                                <!-- Header Kategori Cabang -->
                                                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                                <!-- Batang Pohon / Garis Cabang Vertikal -->
                                                                <Border Margin="10,2,0,0" BorderBrush="#2C2C3A" BorderThickness="1.5,0,0,0" Padding="8,0,0,0">
                                                                    <ItemsPresenter/>
                                                                </Border>
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                        <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,4,0,3" Padding="2,1"
                                                                Background="Transparent"
                                                                helpers:TodoCategoryDragDropBehavior.IsEnabled="True">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <!-- Drag Handle Grip -->
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <!-- Ikon Folder Kategori -->
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <!-- Nama Kategori -->
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <!-- Badge Jumlah Tugas -->
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <!-- Garis Cabang Horizontal -->
                                                                    <ColumnDefinition Width="*"/>
                                                                    <!-- Tombol Pindah Kategori Naik / Turun -->
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Drag Handle Grip untuk Kategori -->
                                                                <Border Grid.Column="0" Background="Transparent" Width="14" Height="18" Margin="0,0,2,0"
                                                                        Cursor="SizeAll" ToolTip="Tahan dan geser (drag &amp; drop) untuk memindahkan urutan kategori beserta seluruh tugasnya">
                                                                    <TextBlock Text="⋮⋮" Foreground="#4E556E" FontSize="11" FontWeight="Bold"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>

                                                                <!-- Ikon Folder Kategori -->
                                                                <Border Grid.Column="1" Background="#181822" BorderBrush="#303040" BorderThickness="1" CornerRadius="4"
                                                                        Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="📁" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>

                                                                <!-- Nama Kategori -->
                                                                <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="#D2D6E4" FontSize="11" FontWeight="Bold"
                                                                           VerticalAlignment="Center"/>

                                                                <!-- Badge Jumlah Tugas -->
                                                                <Border Grid.Column="3" Background="#1D1D28" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ItemCount, StringFormat='{}{0}'}" Foreground="#7E859E" FontSize="9" FontWeight="SemiBold"/>
                                                                </Border>

                                                                <!-- Garis Cabang Horizontal -->
                                                                <Border Grid.Column="4" Height="1" Background="#22222E" Margin="8,0,8,0" VerticalAlignment="Center"/>

                                                                <!-- Tombol Pindah Kategori Naik / Turun -->
                                                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource CategoryOrderButtonStyle}"
                                                                            Command="{Binding DataContext.MoveCategoryUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding Name}"
                                                                            Content="&#x25B4;" ToolTip="Geser kategori ke atas (anak tugas ikut)"/>
                                                                    <Button Style="{StaticResource CategoryOrderButtonStyle}"
                                                                            Command="{Binding DataContext.MoveCategoryDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding Name}"
                                                                            Content="&#x25BE;" ToolTip="Geser kategori ke bawah (anak tugas ikut)" Margin="3,0,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#141418" CornerRadius="8" Padding="7,6" Margin="0,2,0,2"
                                                helpers:TodoDragDropBehavior.IsEnabled="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1C1C22"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Garis Penghubung Cabang ├──• -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Drag Handle Grip -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Checkbox -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Judul Tugas & Target Waktu -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Tombol Aksi (Edit & Hapus) -->
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Penghubung Cabang Horisontal (Branch Arm) -->
                                                <Grid Grid.Column="0" Width="10" Height="18" VerticalAlignment="Center" Margin="-6,0,3,0">
                                                    <Rectangle Height="1.5" Width="6" Fill="#36364A" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <Ellipse Width="3.5" Height="3.5" Fill="#5A5A72" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Drag Grip Handle ⋮⋮ -->
                                                <Border Grid.Column="1" Width="14" Height="20" Background="Transparent" Cursor="SizeAll"
                                                        VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="Tahan dan geser naik/turun untuk ubah urutan">
                                                    <TextBlock Text="⋮⋮" Foreground="#555566" FontSize="11" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Checkbox -->
                                                <CheckBox Grid.Column="2" IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                          Style="{StaticResource TodoCheckBoxStyle}"
                                                          VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                <!-- Judul Tugas & Target Waktu (Mode Tampilan) -->
                                                <DockPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand"
                                                           ToolTip="Klik dua kali atau klik ikon pensil untuk mengedit tugas"
                                                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                    <DockPanel.InputBindings>
                                                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding StartEditCommand}"/>
                                                    </DockPanel.InputBindings>

                                                    <!-- Target Waktu Badge dengan Remaining Time & Day -->
                                                    <Border DockPanel.Dock="Right" Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVis}}"
                                                            Background="{Binding DueBadgeBackground}" BorderBrush="{Binding DueBadgeBorder}" BorderThickness="1"
                                                            CornerRadius="4" Padding="5,1" Margin="6,0,2,0" VerticalAlignment="Center"
                                                            ToolTip="{Binding DueDateFullTooltip}">
                                                        <Border.ContextMenu>
                                                            <ContextMenu Background="#181820" Foreground="#FFFFFF" BorderBrush="#333340">
                                                                <MenuItem Header="Hapus Target Waktu" Command="{Binding ClearDueDateCommand}"/>
                                                                <Separator Background="#333340"/>
                                                                <MenuItem Header="+1 Jam" Command="{Binding SetDueDatePresetCommand}" CommandParameter="plus_1h"/>
                                                                <MenuItem Header="+3 Jam" Command="{Binding SetDueDatePresetCommand}" CommandParameter="plus_3h"/>
                                                                <MenuItem Header="Hari ini 17:00" Command="{Binding SetDueDatePresetCommand}" CommandParameter="today_17"/>
                                                                <MenuItem Header="Malam ini 21:00" Command="{Binding SetDueDatePresetCommand}" CommandParameter="today_21"/>
                                                                <MenuItem Header="Besok 09:00" Command="{Binding SetDueDatePresetCommand}" CommandParameter="tomorrow_09"/>
                                                                <MenuItem Header="Besok 17:00" Command="{Binding SetDueDatePresetCommand}" CommandParameter="tomorrow_17"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z M 11.25,6.5 L 11.25,12.5 L 15.5,15 L 16.25,13.75 L 12.75,11.75 L 12.75,6.5 Z"
                                                                  Width="9.5" Height="9.5" Stretch="Uniform" Fill="{Binding DueBadgeForeground}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DueDateBadgeText}" Foreground="{Binding DueBadgeForeground}" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Teks Tugas -->
                                                    <TextBlock Text="{Binding TaskText}" VerticalAlignment="Center"
                                                               FontSize="11.5" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#E2E2EA"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="Foreground" Value="#666677"/>
                                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DockPanel>

                                                <!-- Mode Edit Inline (Input Teks + Pilihan Target Waktu) -->
                                                <Grid Grid.Column="3" Margin="0,0,6,0" VerticalAlignment="Center"
                                                      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox Grid.Column="0" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource TodoTextBoxStyle}"
                                                             FontSize="11.5" Padding="6,3" VerticalAlignment="Center"
                                                             ToolTip="Tekan Enter untuk simpan, Esc untuk batal">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Enter" Command="{Binding SaveEditCommand}"/>
                                                            <KeyBinding Key="Esc" Command="{Binding CancelEditCommand}"/>
                                                        </TextBox.InputBindings>
                                                    </TextBox>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                                                        <!-- Target Pill if active in edit mode -->
                                                        <Border Visibility="{Binding HasEditDueDate, Converter={StaticResource BoolToVis}}"
                                                                Background="#281A10" BorderBrush="#FFAA00" BorderThickness="1" CornerRadius="4"
                                                                Padding="5,1" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Target waktu tugas (Klik tombol jam untuk ubah)">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z M 11.25,6.5 L 11.25,12.5 L 15.5,15 L 16.25,13.75 L 12.75,11.75 L 12.75,6.5 Z"
                                                                      Width="9" Height="9" Stretch="Uniform" Fill="#FFAA00" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding EditDueDateText}" Foreground="#FFD080" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                <Button Command="{Binding ClearEditDueDateCommand}" Background="Transparent" BorderThickness="0"
                                                                        Foreground="#FFAA00" Cursor="Hand" Padding="2,0" Margin="3,0,0,0" ToolTip="Hapus target waktu">
                                                                    <TextBlock Text="&#x2715;" FontSize="8.5" FontWeight="Bold"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Tombol Target Waktu Edit -->
                                                        <Border VerticalAlignment="Center">
                                                            <Button x:Name="EditDeadlineButton"
                                                                    Command="{Binding ToggleEditDueDateDetachedCommand}"
                                                                    ToolTip="Atur target tanggal dan jam selesai"
                                                                    Width="24" Height="24" Cursor="Hand">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Background" Value="#252533"/>
                                                                        <Setter Property="BorderBrush" Value="#404054"/>
                                                                        <Setter Property="Foreground" Value="#DCDCEE"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasEditDueDate}" Value="True">
                                                                                <Setter Property="Background" Value="#382410"/>
                                                                                <Setter Property="BorderBrush" Value="#FFAA00"/>
                                                                                <Setter Property="Foreground" Value="#FFAA00"/>
                                                                            </DataTrigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#343448"/>
                                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                                <Setter Property="BorderBrush" Value="#686888"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="1.2" CornerRadius="6">
                                                                            <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z M 11.25,6.5 L 11.25,12.5 L 15.5,15 L 16.25,13.75 L 12.75,11.75 L 12.75,6.5 Z"
                                                                                  Width="12" Height="12" Stretch="Uniform" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Border>

                                                        <!-- Popup Pilihan Deadline Edit -->
                                                        <Popup IsOpen="{Binding IsSettingEditDueDateInDetached, Mode=TwoWay}"
                                                               PlacementTarget="{Binding ElementName=EditDeadlineButton}"
                                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                                            <Border Background="#16161D" BorderBrush="#343444" BorderThickness="1.5" CornerRadius="10"
                                                                    Padding="10" Margin="0,4,0,0" Width="280">
                                                                <Border.Effect>
                                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                                                                </Border.Effect>
                                                                <StackPanel>
                                                                    <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                                                        <Button DockPanel.Dock="Right" Command="{Binding CloseEditDueDatePopupCommand}"
                                                                                Background="Transparent" BorderThickness="0" Foreground="#888899" Cursor="Hand" Padding="4,0" ToolTip="Tutup">
                                                                            <TextBlock Text="&#x2715;" FontSize="12" FontWeight="Bold"/>
                                                                        </Button>
                                                                        <TextBlock Text="Target Waktu Selesai" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5"/>
                                                                    </DockPanel>

                                                                    <!-- Quick Presets -->
                                                                    <TextBlock Text="Pilihan Cepat:" Foreground="#888899" FontSize="10" Margin="0,0,0,4"/>
                                                                    <WrapPanel Margin="0,0,0,8">
                                                                        <Button Command="{Binding SetEditDueDatePresetCommand}" CommandParameter="plus_1h"
                                                                                Content="+1 Jam" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                                        <Button Command="{Binding SetEditDueDatePresetCommand}" CommandParameter="plus_3h"
                                                                                Content="+3 Jam" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                                        <Button Command="{Binding SetEditDueDatePresetCommand}" CommandParameter="today_17"
                                                                                Content="Hari ini 17:00" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                                        <Button Command="{Binding SetEditDueDatePresetCommand}" CommandParameter="today_21"
                                                                                Content="Malam 21:00" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                                        <Button Command="{Binding SetEditDueDatePresetCommand}" CommandParameter="tomorrow_09"
                                                                                Content="Besok 09:00" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                                        <Button Command="{Binding SetEditDueDatePresetCommand}" CommandParameter="tomorrow_17"
                                                                                Content="Besok 17:00" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                                    </WrapPanel>

                                                                    <!-- Divider -->
                                                                    <Border Height="1" Background="#262632" Margin="0,0,0,8"/>

                                                                    <!-- Kustom Tanggal & Jam -->
                                                                    <TextBlock Text="Kustom Tanggal &amp; Jam:" Foreground="#888899" FontSize="10" Margin="0,0,0,4"/>
                                                                    <Grid Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <DatePicker SelectedDate="{Binding EditCustomDeadlineDate, Mode=TwoWay}"
                                                                                    VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        <TextBox Grid.Column="1" Text="{Binding EditCustomDeadlineHour, Mode=TwoWay}" Width="32" Height="26"
                                                                                 Style="{StaticResource TodoTextBoxStyle}" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                                                                 ToolTip="Jam (0-23)"/>
                                                                        <TextBlock Grid.Column="1" Text=":" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" Margin="34,0,0,0" HorizontalAlignment="Right"/>
                                                                        <TextBox Grid.Column="2" Text="{Binding EditCustomDeadlineMinute, Mode=TwoWay}" Width="32" Height="26"
                                                                                 Style="{StaticResource TodoTextBoxStyle}" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                                                                 ToolTip="Menit (0-59)" Margin="4,0,0,0"/>
                                                                    </Grid>

                                                                    <DockPanel LastChildFill="False">
                                                                        <Button DockPanel.Dock="Left" Command="{Binding ClearEditDueDateCommand}"
                                                                                Visibility="{Binding HasEditDueDate, Converter={StaticResource BoolToVis}}"
                                                                                Content="Hapus Target" Background="Transparent" Foreground="#FF6B8B" BorderThickness="0"
                                                                                FontSize="11" Cursor="Hand" Padding="0,4"/>
                                                                        <Button DockPanel.Dock="Right" Command="{Binding ApplyEditCustomDeadlineCommand}"
                                                                                Content="Terapkan" Background="#4D96FF" Foreground="#FFFFFF" BorderThickness="0"
                                                                                FontSize="11" FontWeight="SemiBold" Cursor="Hand" Padding="12,5">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>
                                                                    </DockPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </Popup>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Tombol Aksi saat Normal (Edit ✎ & Hapus ×) -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                    <Button Command="{Binding StartEditCommand}"
                                                            Style="{StaticResource TodoDeleteButtonStyle}"
                                                            ToolTip="Edit tugas" Width="20" Height="20" Margin="0,0,2,0">
                                                        <TextBlock Text="✎" FontSize="11" Foreground="#777788" Margin="0,-1,0,0"/>
                                                    </Button>
                                                    <Button Command="{Binding DeleteCommand}"
                                                            Style="{StaticResource TodoDeleteButtonStyle}"
                                                            ToolTip="Hapus tugas" Width="20" Height="20">
                                                        <TextBlock Text="×" FontSize="14" FontWeight="Bold" Margin="0,-2,0,0"/>
                                                    </Button>
                                                </StackPanel>

                                                <!-- Tombol Aksi saat Mode Edit (Simpan ✓ & Batal ✕) -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                    <Button Command="{Binding SaveEditCommand}"
                                                            Style="{StaticResource TodoDeleteButtonStyle}"
                                                            ToolTip="Simpan (Enter)" Width="20" Height="20" Margin="0,0,2,0">
                                                        <TextBlock Text="✓" FontSize="12" Foreground="#4CD964" FontWeight="Bold"/>
                                                    </Button>
                                                    <Button Command="{Binding CancelEditCommand}"
                                                            Style="{StaticResource TodoDeleteButtonStyle}"
                                                            ToolTip="Batal (Esc)" Width="20" Height="20">
                                                        <TextBlock Text="✕" FontSize="11" Foreground="#FF4D6D"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>

    <!-- Resizing Overlay (Hanya aktif & tampil saat kondisi EXPANDED) -->
    <Grid Visibility="{Binding IsTodoWindowExpanded, Converter={StaticResource BoolToVis}}" IsHitTestVisible="True">
        <!-- Sisi / Tepi Jendela -->
        <Thumb x:Name="ResizeLeft" Width="6" HorizontalAlignment="Left" Cursor="SizeWE"
               DragDelta="ResizeLeft_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               Template="{StaticResource TransparentThumbTemplate}"/>
        <Thumb x:Name="ResizeRight" Width="6" HorizontalAlignment="Right" Cursor="SizeWE"
               DragDelta="ResizeRight_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               Template="{StaticResource TransparentThumbTemplate}"/>
        <Thumb x:Name="ResizeTop" Height="6" VerticalAlignment="Top" Cursor="SizeNS"
               DragDelta="ResizeTop_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               Template="{StaticResource TransparentThumbTemplate}"/>
        <Thumb x:Name="ResizeBottom" Height="6" VerticalAlignment="Bottom" Cursor="SizeNS"
               DragDelta="ResizeBottom_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               Template="{StaticResource TransparentThumbTemplate}"/>

        <!-- Sudut Jendela -->
        <Thumb x:Name="ResizeTopLeft" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"
               DragDelta="ResizeTopLeft_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               Template="{StaticResource TransparentThumbTemplate}"/>
        <Thumb x:Name="ResizeTopRight" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"
               DragDelta="ResizeTopRight_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               Template="{StaticResource TransparentThumbTemplate}"/>
        <Thumb x:Name="ResizeBottomLeft" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"
               DragDelta="ResizeBottomLeft_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               Template="{StaticResource TransparentThumbTemplate}"/>

        <!-- Indikator Grip Sudut Kanan-Bawah (Resize Grip) -->
        <Thumb x:Name="ResizeBottomRight" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
               DragDelta="ResizeBottomRight_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               Template="{StaticResource ResizeGripThumbTemplate}"/>
    </Grid>
</Grid>
</Window>
