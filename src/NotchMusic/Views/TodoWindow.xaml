<Window x:Class="NotchMusic.Views.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NotchMusic.Helpers"
        Title="DRANOTCH - To-Do List"
        Width="430" Height="520" MinWidth="340" MinHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="{Binding Settings.AlwaysOnTop}"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <!-- Control Button Style (for compact quick complete) -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Pill Button Style -->
        <Style x:Key="SmallPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A2A34"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill Button Style -->
        <Style x:Key="FilterPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#18181E"/>
            <Setter Property="Foreground" Value="#888899"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#262630"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom CheckBox for To-Do -->
        <Style x:Key="TodoCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="BoxBorder" Width="18" Height="18" CornerRadius="5"
                                Background="#16161C" BorderBrush="#383842" BorderThickness="1.2">
                            <Path x:Name="CheckMark" Data="M 3 8 L 7 12 L 14 4" Stroke="#000000" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete Button for To-Do Item -->
        <Style x:Key="TodoDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555566"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DelBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DelBorder" Property="Background" Value="#33FF4D6D"/>
                                <Setter Property="Foreground" Value="#FF6B8B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox for To-Do -->
        <Style x:Key="TodoTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#141418"/>
            <Setter Property="Foreground" Value="#EDEDF5"/>
            <Setter Property="BorderBrush" Value="#2E2E36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Category ComboBox Style -->
        <Style x:Key="DarkCategoryComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#141418"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#2E2E36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Background="Transparent"
                                             Foreground="{TemplateBinding Foreground}"
                                             BorderThickness="0"
                                             Padding="6,2,0,2"
                                             FontSize="{TemplateBinding FontSize}"
                                             VerticalContentAlignment="Center"
                                             CaretBrush="#FFFFFF"/>
                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="#888899" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!-- Popup Dropdown List -->
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PopupAnimation="Slide">
                                <Border Background="#141418" BorderBrush="#2E2E36" BorderThickness="1" CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="160" Padding="3" Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4A4A58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#E2E2EA"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#24242E"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#32323E"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="TodoContainerBorder"
                Background="#0A0A0C"
                BorderBrush="#24242A"
                BorderThickness="1.2"
                CornerRadius="20"
                MouseDown="Border_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.65"/>
            </Border.Effect>

            <Grid>
                <!-- ================= MODE 1: COMPACT TO-DO NOTCH ================= -->
                <Grid x:Name="TodoCompactView"
                      Visibility="{Binding IsTodoWindowCompact, Converter={StaticResource BoolToVis}}"
                      Height="48" Margin="8,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- To-Do Icon Badge -->
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Margin="2,0,8,0" Background="#18181C" BorderBrush="#2E2E36" BorderThickness="1">
                        <TextBlock Text="✓" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Ticker Task Info (Click to Expand) -->
                    <Border Grid.Column="1" Background="#141418" BorderBrush="#24242A" BorderThickness="1.2"
                            CornerRadius="12" Height="32" Margin="0,0,6,0" Padding="8,2" Cursor="Hand"
                            ToolTip="{Binding CurrentTickerText, StringFormat='To-Do: {0} (Klik untuk buka daftar)'}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ExpandTodoWindowCommand}"/>
                        </Border.InputBindings>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Badge Jumlah Tugas -->
                            <Border Grid.Column="0" Background="#222228" CornerRadius="5" Padding="4,1" Margin="0,0,5,0"
                                    VerticalAlignment="Center" Visibility="{Binding HasPendingTodos, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding CurrentTickerBadge}" Foreground="#CCCCCC" FontSize="9.5" FontWeight="SemiBold"/>
                            </Border>

                            <helpers:MarqueeTextBlock Grid.Column="1" Text="{Binding CurrentTickerText}" 
                                                      Foreground="#EDEDF5" FontSize="11.5" FontWeight="Medium"
                                                      Speed="36" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Quick Complete Button -->
                    <Button Grid.Column="2" Command="{Binding CompleteCurrentTickerCommand}"
                            ToolTip="Tandai tugas selesai" Style="{StaticResource ControlButtonStyle}"
                            Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,4,0"
                            Visibility="{Binding HasPendingTodos, Converter={StaticResource BoolToVis}}">
                        <Border Width="22" Height="22" CornerRadius="6" Background="#18181C" BorderBrush="#2E2E36" BorderThickness="1">
                            <TextBlock Text="✓" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>

                    <!-- Actions (Expand, Pasang, Close) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding ExpandTodoWindowCommand}" Content="▾" ToolTip="Perluas To-Do"/>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding AttachTodoCommand}" ToolTip="Pasang kembali ke musik" Margin="2,0,0,0">
                            <TextBlock Text="⇲" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource SmallPillButton}" Click="CloseButton_Click" Content="✕" ToolTip="Tutup To-Do" Margin="2,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ================= MODE 2: EXPANDED TO-DO LIST ================= -->
                <Grid x:Name="TodoExpandedView"
                      Visibility="{Binding IsTodoWindowExpanded, Converter={StaticResource BoolToVis}}"
                      Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Filter Tabs & Categories -->
                        <RowDefinition Height="Auto"/> <!-- Input New Task -->
                        <RowDefinition Height="*"/>    <!-- Task List -->
                    </Grid.RowDefinitions>

                    <!-- Header: Judul, Ringkasan, Sinkronisasi, Pasang Kembali, Tutup -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✓" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="To-Do List" Foreground="#FFFFFF" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Background="#1A1A20" CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TodoSummaryText}" Foreground="#CCCCCC" FontSize="10.5" FontWeight="Medium"/>
                            </Border>

                            <!-- Tombol Status Google Drive (Klik untuk Login / Sync) -->
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding SyncGoogleDriveCommand}"
                                    ToolTip="{Binding GoogleDriveSyncTooltip}" Padding="6,2" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="☁" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFAA44"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGoogleDriveConnected}" Value="True">
                                                        <Setter Property="Foreground" Value="#4CD964"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding GoogleDriveStatusButtonText}" FontSize="10" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#BBBBCC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGoogleDriveConnected}" Value="True">
                                                        <Setter Property="Foreground" Value="#EEEEEE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Tombol Pasang Kembali ke Panel Musik -->
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding AttachTodoCommand}"
                                    ToolTip="Pasang kembali To-Do List ke panel utama" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⇲" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Pasang ke Musik" FontSize="10.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Tombol Tutup ke Compact (Minimize) -->
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding MinimizeTodoWindowCommand}"
                                    Content="▴" ToolTip="Tutup ke Compact" Margin="0,0,4,0"/>

                            <!-- Tombol Tutup / Sembunyikan -->
                            <Button Style="{StaticResource SmallPillButton}" Click="CloseButton_Click"
                                    Content="✕" ToolTip="Tutup jendela To-Do (dapat dibuka kembali via pengaturan atau panel)"/>
                        </StackPanel>
                    </Grid>

                <!-- Filter Tabs & Actions -->
                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Filter Tabs -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Style="{StaticResource FilterPillStyle}" Command="{Binding SetTodoFilterCommand}" CommandParameter="All">
                                <TextBlock Text="Semua">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAllFilterSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource FilterPillStyle}" Command="{Binding SetTodoFilterCommand}" CommandParameter="Active">
                                <TextBlock Text="Aktif">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActiveFilterSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource FilterPillStyle}" Command="{Binding SetTodoFilterCommand}" CommandParameter="Completed">
                                <TextBlock Text="Selesai">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompletedFilterSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>

                        <!-- Bersihkan Tugas Selesai -->
                        <Button Grid.Column="1" Style="{StaticResource SmallPillButton}" Command="{Binding ClearCompletedTodosCommand}" 
                                Visibility="{Binding HasCompletedTodos, Converter={StaticResource BoolToVis}}"
                                ToolTip="Hapus semua tugas yang selesai" Padding="6,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑" FontSize="10" Margin="0,0,3,0"/>
                                <TextBlock Text="Bersihkan Selesai" FontSize="10.5"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Kategori Filter Chips -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasCategories, Converter={StaticResource BoolToVis}}" Margin="0,5,0,0">
                        <ItemsControl ItemsSource="{Binding AvailableCategories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FilterPillStyle}"
                                            Command="{Binding DataContext.SetCategoryFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,4,0" Padding="6,1.5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="#" Foreground="#888888" FontSize="9" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="#B0B0C0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Input Tugas Baru -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <!-- Dropdown / Input Kategori -->
                        <ColumnDefinition Width="105"/>
                        <!-- Input Teks Tugas -->
                        <ColumnDefinition Width="*"/>
                        <!-- Tombol Tambah (+) -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" 
                              IsEditable="True"
                              ItemsSource="{Binding ExistingCategories}"
                              Text="{Binding NewTodoCategory, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource DarkCategoryComboBoxStyle}"
                              Margin="0,0,5,0" VerticalAlignment="Center"
                              ToolTip="Pilih atau ketik kategori/tag tugas (misal: KERJA)"/>

                    <Grid Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBox x:Name="NewTodoTextBox" 
                                 Text="{Binding NewTodoTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TodoTextBoxStyle}" VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddTodoCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Watermark -->
                        <TextBlock Text="Tulis tugas lalu Enter..." Foreground="#666677" FontSize="11"
                                   IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NewTodoTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Column="2" Command="{Binding AddTodoCommand}" ToolTip="Tambah Tugas"
                            Background="#FFFFFF" Foreground="#000000" Width="28" Height="28" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                               FontWeight="Bold" FontSize="15" Foreground="#000000"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Daftar Tugas (Scrollable) -->
                <Border Grid.Row="3" Background="#0E0E12" CornerRadius="10" Padding="6,4">
                    <Grid>
                        <!-- Tampilan saat kosong -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding FilteredTodos.IsEmpty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="🎉" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Tidak ada tugas saat ini" Foreground="#666677" FontSize="11.5" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- List Item -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                            <ItemsControl ItemsSource="{Binding FilteredTodos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#141418" CornerRadius="8" Padding="7,6" Margin="0,2,0,2"
                                                helpers:TodoDragDropBehavior.IsEnabled="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1C1C22"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Drag Handle Grip -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Checkbox -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Judul Tugas & Kategori Tag -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Tombol Hapus -->
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Drag Grip Handle ⋮⋮ -->
                                                <Border Grid.Column="0" Width="14" Height="20" Background="Transparent" Cursor="SizeAll"
                                                        VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="Tahan dan geser naik/turun untuk ubah urutan">
                                                    <TextBlock Text="⋮⋮" Foreground="#555566" FontSize="11" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Checkbox -->
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                          Style="{StaticResource TodoCheckBoxStyle}"
                                                          VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                <!-- Judul Tugas & Kategori Tag (Mode Tampilan) -->
                                                <DockPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand"
                                                           ToolTip="Klik dua kali atau klik ikon pensil untuk mengedit tugas"
                                                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                    <DockPanel.InputBindings>
                                                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding StartEditCommand}"/>
                                                    </DockPanel.InputBindings>

                                                    <!-- Tag / Kategori Badge -->
                                                    <Border DockPanel.Dock="Left" Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}"
                                                            Background="#1E1E24" BorderBrush="#363640" BorderThickness="1"
                                                            CornerRadius="4" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" Foreground="#DDDDDD" FontSize="9.5" FontWeight="Bold"/>
                                                    </Border>

                                                    <!-- Teks Tugas -->
                                                    <TextBlock Text="{Binding TaskText}" VerticalAlignment="Center"
                                                               FontSize="11.5" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#E2E2EA"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="Foreground" Value="#666677"/>
                                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DockPanel>

                                                <!-- Mode Edit Inline -->
                                                <Grid Grid.Column="2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource TodoTextBoxStyle}"
                                                             FontSize="11.5" Padding="6,3" VerticalAlignment="Center"
                                                             ToolTip="Tekan Enter untuk simpan, Esc untuk batal">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Enter" Command="{Binding SaveEditCommand}"/>
                                                            <KeyBinding Key="Esc" Command="{Binding CancelEditCommand}"/>
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                </Grid>

                                                <!-- Tombol Aksi saat Normal (Edit ✎ & Hapus ×) -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                    <Button Command="{Binding StartEditCommand}"
                                                            Style="{StaticResource TodoDeleteButtonStyle}"
                                                            ToolTip="Edit tugas" Width="20" Height="20" Margin="0,0,2,0">
                                                        <TextBlock Text="✎" FontSize="11" Foreground="#777788" Margin="0,-1,0,0"/>
                                                    </Button>
                                                    <Button Command="{Binding DeleteCommand}"
                                                            Style="{StaticResource TodoDeleteButtonStyle}"
                                                            ToolTip="Hapus tugas" Width="20" Height="20">
                                                        <TextBlock Text="×" FontSize="14" FontWeight="Bold" Margin="0,-2,0,0"/>
                                                    </Button>
                                                </StackPanel>

                                                <!-- Tombol Aksi saat Mode Edit (Simpan ✓ & Batal ✕) -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                    <Button Command="{Binding SaveEditCommand}"
                                                            Style="{StaticResource TodoDeleteButtonStyle}"
                                                            ToolTip="Simpan (Enter)" Width="20" Height="20" Margin="0,0,2,0">
                                                        <TextBlock Text="✓" FontSize="12" Foreground="#4CD964" FontWeight="Bold"/>
                                                    </Button>
                                                    <Button Command="{Binding CancelEditCommand}"
                                                            Style="{StaticResource TodoDeleteButtonStyle}"
                                                            ToolTip="Batal (Esc)" Width="20" Height="20">
                                                        <TextBlock Text="✕" FontSize="11" Foreground="#FF4D6D"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Grid>
</Window>
