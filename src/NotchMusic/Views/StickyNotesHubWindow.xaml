<Window x:Class="NotchMusic.Views.StickyNotesHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NotchMusic.Helpers"
        Title="DRANOTCH - Catatan Tempel (Sticky Notes)"
        Width="640" Height="540"
        MinWidth="460" MinHeight="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="{Binding Settings.AlwaysOnTop}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <helpers:CountToVisibilityConverter x:Key="CountToVis"/>
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>

        <LinearGradientBrush x:Key="MetallicSilverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#E2E6F0" Offset="0.35"/>
            <GradientStop Color="#949BA8" Offset="0.72"/>
            <GradientStop Color="#D4D9E6" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Luxury Sticky Note Icon Geometry -->
        <Geometry x:Key="LuxuryStickyNoteIconGeometry">M 4,3 H 16 L 20,7 V 20 A 1,1 0 0 1 19,21 H 4 A 1,1 0 0 1 3,20 V 4 A 1,1 0 0 1 4,3 Z M 15,3 V 7 H 19 M 6,8 H 12 M 6,12 H 16 M 6,16 H 14</Geometry>

        <Style x:Key="SmallPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E26"/>
            <Setter Property="Foreground" Value="#D4D4E0"/>
            <Setter Property="BorderBrush" Value="#2E2E3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2C2C3A"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4E4E66"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#38384A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryPillButton" TargetType="Button">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FBBF24"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#D97706"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search Box Style -->
        <Style x:Key="HubSearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#15151C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#F59E0B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F59E0B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="TransparentThumbTemplate" TargetType="Thumb">
            <Border Background="Transparent"/>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <Border Margin="10" CornerRadius="14" Background="#14141A" BorderBrush="#262634" BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.45"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Bar (Draggable) -->
            <Border Grid.Row="0" Background="#1B1B24" CornerRadius="13,13,0,0" Padding="14,10,12,10"
                    MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="#282218" BorderBrush="#F59E0B" BorderThickness="1" Margin="0,0,10,0">
                            <Path Data="{StaticResource LuxuryStickyNoteIconGeometry}" Stroke="#F59E0B" StrokeThickness="1.5"
                                  Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Catatan Tempel" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <Border Background="#252533" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StickyNotesCountText, FallbackValue='0 catatan'}" FontSize="10.5" Foreground="#CBD5E1"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Sticky Notes yang tersinkron otomatis ke Google Drive" FontSize="10.5" Foreground="#888899" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Google Drive Sync Button / Pill -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding SyncStickyNotesCommand}"
                                ToolTip="{Binding GoogleDriveSyncTooltip}" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2601;" FontSize="11" Foreground="#38BDF8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding GoogleDriveStatusButtonText, FallbackValue='Drive'}" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Window Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SmallPillButton}" Click="CloseWindow_Click" ToolTip="Tutup Hub" Padding="8,4">
                            <TextBlock Text="&#x2715;" FontSize="11" Foreground="#FFFFFF"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Action Toolbar & Filter -->
            <Border Grid.Row="1" Background="#16161F" BorderBrush="#22222E" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <TextBox Style="{StaticResource HubSearchBoxStyle}" x:Name="SearchBox"
                                 Text="{Binding StickyNotesSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="26,6,24,6"/>
                        <TextBlock Text="&#x1F50D;" FontSize="11" Foreground="#666677" Margin="8,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <TextBlock Text="Cari catatan..." FontSize="11.5" Foreground="#666677" Margin="28,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource StringNotEmptyToVis}, ConverterParameter='invert'}"/>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding ClearStickyNotesSearchCommand}"
                                HorizontalAlignment="Right" Margin="0,0,4,0" Padding="4,2"
                                Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="&#x2715;" FontSize="9"/>
                        </Button>
                    </Grid>

                    <!-- Primary Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryPillButton}" Command="{Binding CreateStickyNoteCommand}" ToolTip="Buat Catatan Baru">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2795;" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Catatan Baru" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding ShowAllStickyNotesCommand}" ToolTip="Buka seluruh catatan di desktop" Margin="6,0,0,0">
                            <TextBlock Text="Buka Semua" FontSize="11"/>
                        </Button>

                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding HideAllStickyNotesCommand}" ToolTip="Sembunyikan seluruh catatan dari layar" Margin="4,0,0,0">
                            <TextBlock Text="Tutup Semua" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Notes Grid / Collection -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,40"
                                Visibility="{Binding FilteredStickyNotes.Count, Converter={StaticResource CountToVis}}">
                        <Border Width="56" Height="56" CornerRadius="16" Background="#22222E" BorderBrush="#333344" BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Path Data="{StaticResource LuxuryStickyNoteIconGeometry}" Stroke="#F59E0B" StrokeThickness="1.5"
                                  Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Belum Ada Catatan Tempel" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Buat catatan pertama Anda untuk mencatat ide, todo cepat, atau pengingat penting."
                                   FontSize="11.5" Foreground="#888899" Margin="0,6,0,14" TextAlignment="Center" MaxWidth="320" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource PrimaryPillButton}" Command="{Binding CreateStickyNoteCommand}" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2795;" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Buat Catatan Sekarang" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Items List (Tampilan Per Baris) -->
                    <ItemsControl ItemsSource="{Binding FilteredStickyNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,7" CornerRadius="10"
                                        BorderThickness="1" Padding="0" Cursor="Hand"
                                        HorizontalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#181824"/>
                                            <Setter Property="BorderBrush" Value="#252536"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#212130"/>
                                                    <Setter Property="BorderBrush" Value="#3A3A52"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding OpenNoteCommand}"/>
                                    </Border.InputBindings>

                                    <Grid Margin="12,10">
                                        <Grid.ColumnDefinitions>
                                            <!-- 0: Color Bar Indicator -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- 1: Note Details -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- 2: Action Buttons -->
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Color Accent Bar Indicator -->
                                        <Border Grid.Column="0" Width="4.5" CornerRadius="2.5"
                                                Background="{Binding AccentBrush}"
                                                Margin="0,1,12,1" VerticalAlignment="Stretch"/>

                                        <!-- Details (Title, Snippet, Timestamp) -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <!-- Top Row: Title & Badges -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#FFFFFF"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="380" VerticalAlignment="Center"/>

                                                <!-- Pin Badge -->
                                                <TextBlock Text="&#x1F4CC;" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" ToolTip="Selalu di atas (Pinned)"/>

                                                <!-- Lock Badge -->
                                                <TextBlock Text="&#x1F512;" FontSize="10.5" Margin="4,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" ToolTip="Terkunci (Hanya baca)"/>

                                                <!-- Status Badge (Di Layar / Tersimpan) -->
                                                <Border CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Background="{Binding StatusBackgroundBrush}">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="9.5" FontWeight="SemiBold"
                                                               Foreground="{Binding StatusForegroundBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Middle Row: Snippet Preview -->
                                            <TextBlock Text="{Binding Snippet}"
                                                       FontSize="12" FontFamily="Segoe UI, Calibri"
                                                       Foreground="#94A3B8"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,3"/>

                                            <!-- Bottom Row: Last Edited Timestamp -->
                                            <TextBlock Text="{Binding LastEditedText}"
                                                       FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>

                                        <!-- Right Actions: Buka/Fokus & Hapus -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SmallPillButton}"
                                                    Command="{Binding OpenNoteCommand}"
                                                    ToolTip="Buka / Fokus catatan di desktop"
                                                    Padding="9,4" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding ActionButtonText}"
                                                           FontSize="11" Foreground="#FFFFFF"/>
                                            </Button>

                                            <Button Style="{StaticResource SmallPillButton}"
                                                    Command="{Binding DeleteNoteCommand}"
                                                    ToolTip="Hapus catatan"
                                                    Padding="7,4">
                                                <TextBlock Text="&#x1F5D1;" FontSize="11" Foreground="#EF4444"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- 4. Footer Bar -->
            <Border Grid.Row="3" Background="#161620" BorderBrush="#22222E" BorderThickness="0,1,0,0" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x2601; Google Drive:" FontSize="11" Foreground="#94A3B8" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding GoogleDriveSyncStatus, FallbackValue='Belum terhubung'}" FontSize="11" Foreground="#CBD5E1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="DRANOTCH v1.9.0" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                        <!-- Resize Grip Visual Indicator -->
                        <Border Width="12" Height="12" Margin="8,0,0,0" Cursor="SizeNWSE"
                                Background="Transparent" ToolTip="Tarik untuk mengubah ukuran Hub"
                                VerticalAlignment="Center">
                            <Path Data="M 10,14 L 14,10 M 6,14 L 14,6 M 2,14 L 14,2"
                                  Stroke="#64748B" StrokeThickness="1.2" Opacity="0.7"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>

    <!-- 8-Direction Resizing Overlay (Edges & Corners) -->
    <Grid IsHitTestVisible="True">
        <!-- 4 Edges -->
        <Thumb x:Name="ResizeLeft" Width="8" HorizontalAlignment="Left" Cursor="SizeWE"
               DragDelta="ResizeLeft_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               Template="{StaticResource TransparentThumbTemplate}"/>
        <Thumb x:Name="ResizeRight" Width="8" HorizontalAlignment="Right" Cursor="SizeWE"
               DragDelta="ResizeRight_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               Template="{StaticResource TransparentThumbTemplate}"/>
        <Thumb x:Name="ResizeTop" Height="8" VerticalAlignment="Top" Cursor="SizeNS"
               DragDelta="ResizeTop_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               Template="{StaticResource TransparentThumbTemplate}"/>
        <Thumb x:Name="ResizeBottom" Height="8" VerticalAlignment="Bottom" Cursor="SizeNS"
               DragDelta="ResizeBottom_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               Template="{StaticResource TransparentThumbTemplate}"/>

        <!-- 4 Corners -->
        <Thumb x:Name="ResizeTopLeft" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"
               DragDelta="ResizeTopLeft_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               Template="{StaticResource TransparentThumbTemplate}"/>
        <Thumb x:Name="ResizeTopRight" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"
               DragDelta="ResizeTopRight_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               Template="{StaticResource TransparentThumbTemplate}"/>
        <Thumb x:Name="ResizeBottomLeft" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"
               DragDelta="ResizeBottomLeft_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               Template="{StaticResource TransparentThumbTemplate}"/>
        <Thumb x:Name="ResizeBottomRight" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
               DragDelta="ResizeBottomRight_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               Template="{StaticResource TransparentThumbTemplate}"/>
    </Grid>
</Grid>
</Window>
