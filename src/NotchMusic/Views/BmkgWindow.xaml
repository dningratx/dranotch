<Window x:Class="NotchMusic.Views.BmkgWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NotchMusic.Helpers"
        Title="DRANOTCH - Cuaca &amp; Gempa Bumi BMKG"
        Width="456" MinWidth="380"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#FFFFFF"
        Topmost="{Binding Settings.AlwaysOnTop}"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>

        <LinearGradientBrush x:Key="MetallicSilverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#E2E6F0" Offset="0.35"/>
            <GradientStop Color="#949BA8" Offset="0.72"/>
            <GradientStop Color="#D4D9E6" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Luxury BMKG Cloud, Sun & Seismic Pulse Geometry (24x24) -->
        <Geometry x:Key="LuxuryBmkgIconGeometry">M 6.5,17.5 H 17.5 A 3.5,3.5 0 0 0 18.2,10.6 A 5,5 0 0 0 8.6,8.8 A 4,4 0 0 0 6.5,17.5 Z M 3,20.5 H 8.5 L 10.2,18 L 12.2,22.5 L 14.2,19 L 15.5,20.5 H 21</Geometry>

        <!-- Bright Seismic Pulse / Earthquake Geometry (24x24) -->
        <Geometry x:Key="SeismicPulseIconGeometry">M 2,12 H 6 L 8.5,5 L 12,19 L 15,9 L 17.5,14 L 19,12 H 22</Geometry>

        <!-- Bright Pin / Location Geometry (24x24) -->
        <Geometry x:Key="PinLocationIconGeometry">M 12,2 C 8.13,2 5,5.13 5,9 C 5,14.25 12,22 12,22 C 12,22 19,14.25 19,9 C 19,5.13 15.87,2 12,2 Z M 12,11.5 A 2.5,2.5 0 1 1 12,6.5 A 2.5,2.5 0 0 1 12,11.5 Z</Geometry>

        <!-- Bright Search Magnifier Geometry (24x24) -->
        <Geometry x:Key="SearchIconGeometry">M 11,4 A 7,7 0 1 0 11,18 A 7,7 0 1 0 11,4 Z M 16.2,16.2 L 21,21</Geometry>

        <!-- Bright Water Drop Geometry (24x24) -->
        <Geometry x:Key="DropIconGeometry">M 12,2.5 C 12,2.5 6,9.5 6,14 A 6,6 0 0 0 18,14 C 18,9.5 12,2.5 12,2.5 Z</Geometry>

        <!-- Bright Wind Geometry (24x24) -->
        <Geometry x:Key="WindIconGeometry">M 3,8 H 16.5 A 2.5,2.5 0 1 0 14,5.5 M 3,12 H 19.5 A 2.5,2.5 0 1 1 17,14.5 M 3,16 H 13.5 A 2.5,2.5 0 1 1 11,18.5</Geometry>

        <!-- Bright Cloud Geometry (24x24) -->
        <Geometry x:Key="CloudSmallIconGeometry">M 6,18 H 18 A 3.5,3.5 0 0 0 18.5,11 A 5,5 0 0 0 8.8,9.2 A 4,4 0 0 0 6,18 Z</Geometry>

        <!-- Bright Rain Geometry (24x24) -->
        <Geometry x:Key="RainSmallIconGeometry">M 6,15 H 18 A 3.2,3.2 0 0 0 18.4,8.6 A 4.5,4.5 0 0 0 9,7 A 3.6,3.6 0 0 0 6,15 Z M 8.5,17.5 L 7,21 M 12.5,17.5 L 11,21 M 16.5,17.5 L 15,21</Geometry>

        <!-- Bright Calendar Geometry (24x24) -->
        <Geometry x:Key="CalendarIconGeometry">M 5,4 H 19 A 2,2 0 0 1 21,6 V 19 A 2,2 0 0 1 19,21 H 5 A 2,2 0 0 1 3,19 V 6 A 2,2 0 0 1 5,4 Z M 16,2 V 6 M 8,2 V 6 M 3,10 H 21</Geometry>

        <!-- Bright Globe Geometry (24x24) -->
        <Geometry x:Key="GlobeIconGeometry">M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 2,12 H 22 M 12,2 C 14.5,4.7 16,8.2 16,12 C 16,15.8 14.5,19.3 12,22 C 9.5,19.3 8,15.8 8,12 C 8,8.2 9.5,4.7 12,2 Z</Geometry>

        <!-- Small Pill Button Style -->
        <Style x:Key="SmallPillButton" TargetType="Button">
            <Setter Property="Background" Value="#222434"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3C405A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#30344C"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#606890"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- High-Contrast Dark ComboBox Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E1E28"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="#FFFFFF"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#343448"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2C2C3E"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BmkgDarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1C1E2B"/>
            <Setter Property="BorderBrush" Value="#3E425E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#FFFFFF"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="Background" Value="#282B3E"/>
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#5E648C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,2,22,2"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="#FFFFFF"
                                              TextElement.FontWeight="SemiBold"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="240">
                                    <Border Background="#181822"
                                            BorderBrush="#464A68"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="BmkgContainerBorder"
                Background="#0A0A0E"
                BorderBrush="#2C2E42"
                BorderThickness="1.2"
                CornerRadius="20"
                MouseDown="Border_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="5" BlurRadius="18" Opacity="0.75"/>
            </Border.Effect>

            <Grid>
                <!-- ================= MODE 1: COMPACT BMKG MINI NOTCH ================= -->
                <Grid x:Name="BmkgCompactView"
                      Visibility="{Binding IsBmkgWindowCompact, Converter={StaticResource BoolToVis}}"
                      Height="50" Margin="10,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bright Vector Icon Badge -->
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Margin="0,0,8,0"
                            Background="#1E2234" BorderBrush="#4E5882" BorderThickness="1">
                        <Path Data="{Binding BmkgWeatherIconGeometry}"
                              Stroke="{Binding BmkgWeatherIconColor, FallbackValue=#FFD43B}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Current Weather Pill (Click to Expand Weather) -->
                    <Border Grid.Column="1" Background="#141622" BorderBrush="#2C3048" BorderThickness="1.2"
                            CornerRadius="12" Height="34" Margin="0,0,6,0" Padding="10,2" Cursor="Hand"
                            ToolTip="{Binding BmkgNotchTooltip}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenBmkgWeatherTabCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BmkgWeatherCityText}" Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding BmkgWeatherTempText}" Foreground="#4CD964" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding BmkgWeatherDescText}" Foreground="#D0D4E8" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Latest Earthquake Pill (Click to Expand Earthquake) -->
                    <Border Grid.Column="2" Background="#24161C" BorderBrush="#5C2E3C" BorderThickness="1"
                            CornerRadius="10" Height="30" Margin="0,0,6,0" Padding="7,2" Cursor="Hand"
                            Visibility="{Binding HasLatestEarthquake, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding LatestEarthquakeCompactText}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenBmkgEarthquakeTabCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource SeismicPulseIconGeometry}" Stroke="#FF6B8B" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding LatestEarthquakeBadge}" Foreground="#FFB74D" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick Controls -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding RefreshBmkgCommand}" Content="&#x21BB;" ToolTip="Muat Ulang Data BMKG" Padding="7,4"/>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding ExpandBmkgWindowCommand}" Content="&#x25BE;" ToolTip="Perluas Jendela BMKG"/>
                        <Button Style="{StaticResource SmallPillButton}" Click="CloseButton_Click" Content="&#x2715;" ToolTip="Tutup Jendela BMKG"/>
                    </StackPanel>
                </Grid>

                <!-- ================= MODE 2: EXPANDED BMKG CUACA & GEMPA BUMI ================= -->
                <Grid x:Name="BmkgExpandedView"
                      Visibility="{Binding IsBmkgWindowExpanded, Converter={StaticResource BoolToVis}}"
                      Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: Main Tabs (Cuaca vs Gempa Bumi) -->
                        <RowDefinition Height="Auto"/> <!-- Row 2: Active Tab Content -->
                        <RowDefinition Height="Auto"/> <!-- Row 3: Footer Attribution -->
                    </Grid.RowDefinitions>

                    <!-- ROW 0: HEADER (No Overlap, Bright Icons) -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0" ClipToBounds="True">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Bright Weather Icon Badge -->
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="9"
                                        Background="#1E2438" BorderBrush="#485680" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Data="{Binding BmkgWeatherIconGeometry}"
                                          Stroke="{Binding BmkgWeatherIconColor, FallbackValue=#FFD43B}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1" Text="Cuaca &amp; Gempa BMKG" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>

                                <Border Grid.Column="2" Background="#1C263B" BorderBrush="#3B527E" BorderThickness="1" CornerRadius="6"
                                        Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="115">
                                    <TextBlock Text="{Binding BmkgWeatherCityText}" Foreground="#7DD3FC" FontSize="10.5" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding BmkgWeatherLocationSubtitle}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding BmkgStatusMessage}" FontSize="10.5" Foreground="#A6ACCD" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding RefreshBmkgCommand}"
                                    ToolTip="Perbarui Data Cuaca &amp; Gempa BMKG Sekarang" Margin="0,0,3,0" Padding="7,4">
                                <TextBlock Text="&#x21BB;" Foreground="#7DD3FC" FontSize="12" FontWeight="Bold"/>
                            </Button>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding TestBmkgAlertCommand}"
                                    ToolTip="Simulasi Banner Peringatan Gempa di Notch" Margin="0,0,3,0" Padding="7,4">
                                <Path Data="M 12,3 A 6,6 0 0 1 18,9 V 14 L 20,16 V 17 H 4 V 16 L 6,14 V 9 A 6,6 0 0 1 12,3 Z M 10,19 A 2,2 0 0 0 14,19"
                                      Stroke="#FFD43B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenSettingsCommand}"
                                    ToolTip="Buka Pengaturan DRANOTCH" Margin="0,0,3,0" Padding="7,4">
                                <TextBlock Text="&#x2699;" Foreground="#FFFFFF" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding MinimizeBmkgWindowCommand}"
                                    ToolTip="Kecilkan ke Mode Compact" Margin="0,0,3,0" Padding="7,4">
                                <TextBlock Text="&#x25B4;" Foreground="#FFFFFF" FontSize="11"/>
                            </Button>
                            <Button Style="{StaticResource SmallPillButton}" Click="CloseButton_Click"
                                    ToolTip="Tutup Jendela Cuaca &amp; Gempa BMKG" Padding="7,4">
                                <TextBlock Text="&#x2715;" Foreground="#FF8787" FontSize="11" FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 1: MAIN TAB SWITCHER (CUACA VS GEMPA BUMI) -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tab 1: Prakiraan Cuaca -->
                        <Button Grid.Column="0" Command="{Binding SetBmkgTabCommand}" CommandParameter="Weather" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TabBorder" CornerRadius="10" Padding="10,7" BorderThickness="1.3" Background="#141622" BorderBrush="#2C3046">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{Binding BmkgWeatherIconGeometry}"
                                                  Stroke="{Binding BmkgWeatherIconColor, FallbackValue=#FFD43B}"
                                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Prakiraan Cuaca" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Border Background="#183224" BorderBrush="#2E6444" BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BmkgWeatherTempText}" Foreground="#4CD964" FontSize="10.5" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsBmkgWeatherTab}" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#1E243B"/>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#5C7CFA"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#252C46"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Tab 2: Gempa Bumi -->
                        <Button Grid.Column="2" Command="{Binding SetBmkgTabCommand}" CommandParameter="Earthquake" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TabBorder" CornerRadius="10" Padding="10,7" BorderThickness="1.3" Background="#141622" BorderBrush="#2C3046">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource SeismicPulseIconGeometry}"
                                                  Stroke="#FF6B8B" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Gempa Bumi" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Border Background="{Binding LatestEarthquake.MagnitudeBadgeBackground, FallbackValue=#2A1E17}"
                                                    BorderBrush="{Binding LatestEarthquake.MagnitudeBadgeBorder, FallbackValue=#FF9F1C}"
                                                    BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LatestEarthquakeBadge}"
                                                           Foreground="{Binding LatestEarthquake.MagnitudeBadgeForeground, FallbackValue=#FFB74D}"
                                                           FontSize="10.5" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsBmkgEarthquakeTab}" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#2C1924"/>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#FF6B8B"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#341E2B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- ================= ROW 2A: TAB PRAKIRAAN CUACA BMKG ================= -->
                    <StackPanel Grid.Row="2" Visibility="{Binding IsBmkgWeatherTab, Converter={StaticResource BoolToVis}}">

                        <!-- Bar Pilihan & Pencarian Lokasi Presisi BMKG -->
                        <Border Background="#131520" BorderBrush="#282C42" BorderThickness="1.2" CornerRadius="12" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <!-- Baris 1: Pencarian Langsung Kelurahan / Kecamatan / Kota + Deteksi + Pilih Bertingkat -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search Box Kelurahan / Kecamatan / Kota -->
                                    <Grid Grid.Column="0" Margin="0,0,5,0">
                                        <TextBox x:Name="LocationSearchBox"
                                                 Text="{Binding BmkgLocationSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#1B1E2E" Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                                                 BorderBrush="#3A405E" BorderThickness="1"
                                                 Padding="26,4,8,4" Height="28" FontSize="11" VerticalContentAlignment="Center"
                                                 ToolTip="Ketik nama Kelurahan/Desa, Kecamatan, atau Kota lalu tekan Enter">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding SearchBmkgLocationCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Path Data="{StaticResource SearchIconGeometry}" Stroke="#7DD3FC" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="8,0,0,0" IsHitTestVisible="False"/>
                                        <TextBlock Text="Cari Kelurahan / Kecamatan / Kota..."
                                                   Foreground="#7880A0" FontSize="10.5" VerticalAlignment="Center" Margin="26,0,6,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=LocationSearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Tombol Cari -->
                                    <Button Grid.Column="1" Style="{StaticResource SmallPillButton}"
                                            Command="{Binding SearchBmkgLocationCommand}"
                                            Background="#203254" BorderBrush="#4C6EF5" Padding="8,4" Margin="0,0,4,0"
                                            ToolTip="Cari lokasi presisi tingkat Kelurahan/Desa &amp; Kecamatan">
                                        <TextBlock Text="{Binding BmkgLocationSearchButtonText}" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold"/>
                                    </Button>

                                    <!-- Tombol Deteksi Presisi -->
                                    <Button Grid.Column="2" Style="{StaticResource SmallPillButton}"
                                            Command="{Binding DetectBmkgLocationCommand}"
                                            Padding="8,4" Margin="0,0,4,0"
                                            ToolTip="Deteksi otomatis lokasi Anda hingga tingkat Kelurahan/Desa">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource PinLocationIconGeometry}" Fill="#4CD964" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Deteksi" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Tombol Pilih Wilayah Presisi Bertingkat (Provinsi -> Kab/Kota -> Kecamatan -> Kelurahan) -->
                                    <Button Grid.Column="3" Style="{StaticResource SmallPillButton}"
                                            Command="{Binding TogglePreciseRegionSelectorCommand}"
                                            Padding="8,4" Margin="0"
                                            ToolTip="Pilih manual secara presisi: Provinsi ▸ Kab/Kota ▸ Kecamatan ▸ Kelurahan/Desa">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#x25BE;" Foreground="#FFD43B" FontSize="11" FontWeight="Bold" Margin="0,0,4,0"/>
                                            <TextBlock Text="Pilih Wilayah" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Daftar Hasil Pencarian Lokasi Presisi (Muncul saat hasil ditemukan) -->
                                <Border Visibility="{Binding HasBmkgLocationSearchResults, Converter={StaticResource BoolToVis}}"
                                        Background="#0E1018" BorderBrush="#3A466E" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,6,0,2">
                                    <StackPanel>
                                        <DockPanel Margin="2,0,2,4" LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallPillButton}"
                                                    Command="{Binding ClearBmkgLocationSearchCommand}" Content="&#x2715;" Padding="5,1" FontSize="9.5"/>
                                            <TextBlock Text="Pilih Kelurahan / Kecamatan hasil pencarian:" FontSize="10" FontWeight="Bold" Foreground="#7DD3FC" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ScrollViewer MaxHeight="145" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding BmkgLocationSearchResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectBmkgSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Cursor="Hand" Margin="0,0,0,3">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="ResBorder" Background="#171A28" BorderBrush="#2C324C" BorderThickness="1" CornerRadius="7" Padding="8,5">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Path Grid.Column="0" Data="{StaticResource PinLocationIconGeometry}" Fill="#38BDF8"
                                                                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding DisplayTitle}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Text="{Binding DisplaySubtitle}" Foreground="#9AA4C4" FontSize="9.5" TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                            <Border Grid.Column="2" Background="#1E2C46" CornerRadius="4" Padding="5,2" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                                <TextBlock Text="Pilih" Foreground="#7DD3FC" FontSize="9.5" FontWeight="Bold"/>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ResBorder" Property="Background" Value="#222840"/>
                                                                            <Setter TargetName="ResBorder" Property="BorderBrush" Value="#5C7CFA"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <!-- Panel Pilih Wilayah Presisi 4 Tingkat (Provinsi ▸ Kab/Kota ▸ Kecamatan ▸ Kelurahan/Desa) -->
                                <Border Visibility="{Binding IsSelectingPreciseRegion, Converter={StaticResource BoolToVis}}"
                                        Background="#0D0F17" BorderBrush="#323854" BorderThickness="1" CornerRadius="9" Padding="9,8" Margin="0,6,0,2">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallPillButton}"
                                                    Command="{Binding ToggleCustomAdm4EditCommand}"
                                                    Content="Input Kode ADM4" FontSize="9.5" Padding="6,2"/>
                                            <TextBlock Text="🎯 Pilih Lokasi Manual Presisi (Tingkat Kelurahan / Desa):"
                                                       Foreground="#FFD43B" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="6"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- 1. Provinsi -->
                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="1. Provinsi:" Foreground="#B0B8D4" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                <ComboBox Style="{StaticResource BmkgDarkComboBoxStyle}"
                                                          ItemsSource="{Binding BmkgProvinces}"
                                                          SelectedItem="{Binding SelectedBmkgProvince, Mode=TwoWay}"
                                                          DisplayMemberPath="Name" Height="26"/>
                                            </StackPanel>

                                            <!-- 2. Kabupaten / Kota -->
                                            <StackPanel Grid.Row="0" Grid.Column="2">
                                                <TextBlock Text="2. Kabupaten / Kota:" Foreground="#B0B8D4" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                <ComboBox Style="{StaticResource BmkgDarkComboBoxStyle}"
                                                          ItemsSource="{Binding BmkgRegencies}"
                                                          SelectedItem="{Binding SelectedBmkgRegency, Mode=TwoWay}"
                                                          DisplayMemberPath="Name" Height="26"/>
                                            </StackPanel>

                                            <!-- 3. Kecamatan -->
                                            <StackPanel Grid.Row="2" Grid.Column="0">
                                                <TextBlock Text="3. Kecamatan:" Foreground="#B0B8D4" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                <ComboBox Style="{StaticResource BmkgDarkComboBoxStyle}"
                                                          ItemsSource="{Binding BmkgDistricts}"
                                                          SelectedItem="{Binding SelectedBmkgDistrict, Mode=TwoWay}"
                                                          DisplayMemberPath="Name" Height="26"/>
                                            </StackPanel>

                                            <!-- 4. Kelurahan / Desa -->
                                            <StackPanel Grid.Row="2" Grid.Column="2">
                                                <TextBlock Text="4. Kelurahan / Desa (Presisi):" Foreground="#4CD964" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,2"/>
                                                <ComboBox Style="{StaticResource BmkgDarkComboBoxStyle}"
                                                          ItemsSource="{Binding BmkgVillages}"
                                                          SelectedItem="{Binding SelectedBmkgVillage, Mode=TwoWay}"
                                                          DisplayMemberPath="Name" Height="26"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Pilihan Cepat Kota Besar (Opsional) -->
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Pintasan Kota Besar:" Foreground="#9AA4C4" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox Grid.Column="1" Style="{StaticResource BmkgDarkComboBoxStyle}"
                                                      ItemsSource="{Binding BmkgCities}"
                                                      SelectedItem="{Binding SelectedBmkgCity, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName" Height="25"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Input Kode Wilayah ADM4 Kustom (Opsional) -->
                                <Border Visibility="{Binding IsEditingCustomAdm4, Converter={StaticResource BoolToVis}}"
                                        Background="#0D0D12" BorderBrush="#383E5A" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,6,0,2">
                                    <StackPanel>
                                        <TextBlock Text="Kode Wilayah Kelurahan/Desa (ADM4 Kemendagri/BMKG, misal 31.74.06.1001):"
                                                   Foreground="#C4CAE0" FontSize="10" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding BmkgCustomAdm4Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="#161824" Foreground="#FFFFFF" CaretBrush="#FFFFFF" BorderBrush="#464C6E" BorderThickness="1"
                                                     Padding="6,3" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Style="{StaticResource SmallPillButton}"
                                                    Command="{Binding ApplyCustomAdm4Command}"
                                                    Content="Terapkan" Background="#253458" BorderBrush="#4C6EF5"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Info Lokasi & Toggle Sinkronisasi Waktu Sholat -->
                                <DockPanel Margin="0,6,0,0" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding BmkgActiveAdm4Text}" Foreground="#8A92B2" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <CheckBox Content="Sinkronkan lokasi presisi dengan Waktu Sholat" IsChecked="{Binding BmkgFollowPrayerCity, Mode=TwoWay}"
                                              Foreground="#D0D6EC" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                </DockPanel>

                                <TextBlock Text="{Binding BmkgLocationStatus}" Foreground="#4CD964" FontSize="10" FontWeight="SemiBold" Margin="0,3,0,0"
                                           TextWrapping="Wrap" Visibility="{Binding BmkgLocationStatus, Converter={StaticResource StringNotEmptyToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Hero Card Cuaca Saat Ini -->
                        <Border Background="#141826" BorderBrush="#2E3654" BorderThickness="1.2" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Big Bright Vector Weather Icon -->
                                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="15"
                                            Background="#1E253C" BorderBrush="#424E78" BorderThickness="1.2" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Path Data="{Binding BmkgWeatherIconGeometry}"
                                              Stroke="{Binding BmkgWeatherIconColor, FallbackValue=#FFD43B}"
                                              StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Temp & Weather Desc -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BmkgWeatherTempText}" FontSize="26" FontWeight="ExtraBold" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BmkgWeatherDescText}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{Binding CurrentWeatherSlot.FullTimeLabel, FallbackValue='Prakiraan Saat Ini'}" FontSize="10.5" Foreground="#A6B0D0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{Binding BmkgWeatherLocationSubtitle}" FontSize="10.5" FontWeight="SemiBold" Foreground="#7DD3FC"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding BmkgWeatherLocationSubtitle}"/>
                                    </StackPanel>

                                    <!-- Min-Max Today Badge -->
                                    <Border Grid.Column="2" Background="#1C2236" BorderBrush="#384264" BorderThickness="1" CornerRadius="9" Padding="9,6" VerticalAlignment="Top">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="RENTANG HARI INI" FontSize="8" FontWeight="Bold" Foreground="#9AA6CC" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding BmkgWeatherRangeText}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 4 Weather Parameter Pills (Bright Vector Icons: Kelembapan, Angin, Tutupan Awan, Curah Hujan) -->
                                <UniformGrid Columns="4" Margin="0,10,0,0">
                                    <!-- Kelembapan -->
                                    <Border Background="#0E111B" BorderBrush="#262C44" BorderThickness="1" CornerRadius="8" Padding="6,6" Margin="0,0,4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Data="{StaticResource DropIconGeometry}" Fill="#38BDF8" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Kelembapan" FontSize="9.5" FontWeight="SemiBold" Foreground="#C4CCE4" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding BmkgWeatherHumidityText}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Angin -->
                                    <Border Background="#0E111B" BorderBrush="#262C44" BorderThickness="1" CornerRadius="8" Padding="6,6" Margin="2,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Data="{StaticResource WindIconGeometry}" Stroke="#67E8F9" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Angin" FontSize="9.5" FontWeight="SemiBold" Foreground="#C4CCE4" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CurrentWeatherSlot.WindSpeedFormatted, FallbackValue='-'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"
                                                       ToolTip="{Binding BmkgWeatherWindText}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Awan -->
                                    <Border Background="#0E111B" BorderBrush="#262C44" BorderThickness="1" CornerRadius="8" Padding="6,6" Margin="2,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Data="{StaticResource CloudSmallIconGeometry}" Fill="#BAE6FD" Width="11" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Awan" FontSize="9.5" FontWeight="SemiBold" Foreground="#C4CCE4" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding BmkgWeatherCloudText}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Curah Hujan -->
                                    <Border Background="#0E111B" BorderBrush="#262C44" BorderThickness="1" CornerRadius="8" Padding="6,6" Margin="4,0,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Data="{StaticResource RainSmallIconGeometry}" Stroke="#60A5FA" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Curah Hujan" FontSize="9.5" FontWeight="SemiBold" Foreground="#C4CCE4" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding BmkgWeatherRainText}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Prakiraan Cuaca Per 3 Jam (3 Hari ke Depan) -->
                        <Border Background="#0E1017" BorderBrush="#24283C" BorderThickness="1" CornerRadius="12" Padding="10,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="Interval 3 Jam • 3 Hari" FontSize="9.5" Foreground="#98A0C0" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource CalendarIconGeometry}" Stroke="#60A5FA" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Prakiraan Cuaca Per 3 Jam (BMKG)" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>

                                <ScrollViewer MaxHeight="245" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding BmkgWeatherDayGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#131622" BorderBrush="#262B42" BorderThickness="1" CornerRadius="9" Padding="8,6" Margin="0,0,0,7">
                                                    <StackPanel>
                                                        <!-- Day Header with Bright Vector Weather Icon -->
                                                        <DockPanel Margin="0,0,0,5" LastChildFill="True">
                                                            <Border DockPanel.Dock="Right" Background="#1E2438" BorderBrush="#364062" BorderThickness="1" CornerRadius="5" Padding="6,1.5" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TempRangeFormatted}" Foreground="#A8C0FF" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{Binding DominantWeatherIconGeometry}"
                                                                      Stroke="{Binding DominantWeatherIconColor, FallbackValue=#FFD43B}"
                                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding DayTitle}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding DominantWeatherDesc}" Foreground="#B4BCD8" FontSize="10" FontWeight="Medium" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DockPanel>

                                                        <!-- 3-Hour Slots Horizontal Scroll -->
                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                            <ItemsControl ItemsSource="{Binding Items}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Width="78" CornerRadius="8" Padding="6,6" Margin="0,0,5,2" BorderThickness="1.2">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="#181C2C"/>
                                                                                    <Setter Property="BorderBrush" Value="#2A3048"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsCurrentSlot}" Value="True">
                                                                                            <Setter Property="Background" Value="#202844"/>
                                                                                            <Setter Property="BorderBrush" Value="#5C7CFA"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <StackPanel HorizontalAlignment="Center">
                                                                                <TextBlock Text="{Binding TimeLabel}" FontSize="10" FontWeight="Bold" Foreground="#D4DCF4" HorizontalAlignment="Center"/>
                                                                                <!-- Bright Vector Weather Icon -->
                                                                                <Border Width="28" Height="28" CornerRadius="8" Background="#121522" Margin="0,4,0,3" HorizontalAlignment="Center">
                                                                                    <Path Data="{Binding WeatherIconGeometry}"
                                                                                          Stroke="{Binding WeatherIconColor, FallbackValue=#FFD43B}"
                                                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                                          Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <TextBlock Text="{Binding TemperatureFormatted}" FontSize="12.5" FontWeight="ExtraBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                                                <TextBlock Text="{Binding WeatherDesc}" FontSize="9" FontWeight="Medium" Foreground="#B8C0DC" HorizontalAlignment="Center"
                                                                                           TextTrimming="CharacterEllipsis" MaxWidth="70" ToolTip="{Binding WeatherDesc}" Margin="0,1,0,3"/>
                                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                                    <Path Data="{StaticResource DropIconGeometry}" Fill="#38BDF8" Width="8" Height="8" Stretch="Uniform" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding HumidityFormatted}" FontSize="9" FontWeight="SemiBold" Foreground="#98B4DC" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= ROW 2B: TAB GEMPA BUMI BMKG ================= -->
                    <StackPanel Grid.Row="2" Visibility="{Binding IsBmkgEarthquakeTab, Converter={StaticResource BoolToVis}}">

                        <!-- Sub-Tab Filter Pills: Gempa Terbaru | 15 Gempa Terkini (M >= 5.0) | 15 Gempa Dirasakan -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{Binding SetBmkgEarthquakeSubTabCommand}" CommandParameter="AutoGempa" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="SubBorder" CornerRadius="8" Padding="6,5" Background="#141620" BorderBrush="#282C3E" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource SeismicPulseIconGeometry}" Stroke="#FF6B8B" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Gempa Terbaru" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsBmkgEqAutoTab}" Value="True">
                                                <Setter TargetName="SubBorder" Property="Background" Value="#2C1924"/>
                                                <Setter TargetName="SubBorder" Property="BorderBrush" Value="#FF6B8B"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2" Command="{Binding SetBmkgEarthquakeSubTabCommand}" CommandParameter="Terkini" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="SubBorder" CornerRadius="8" Padding="6,5" Background="#141620" BorderBrush="#282C3E" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="&#x26A0;" Foreground="#FFB74D" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="15 Gempa M ≥ 5.0" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsBmkgEqTerkiniTab}" Value="True">
                                                <Setter TargetName="SubBorder" Property="Background" Value="#2C2014"/>
                                                <Setter TargetName="SubBorder" Property="BorderBrush" Value="#FFB74D"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="4" Command="{Binding SetBmkgEarthquakeSubTabCommand}" CommandParameter="Dirasakan" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="SubBorder" CornerRadius="8" Padding="6,5" Background="#141620" BorderBrush="#282C3E" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource PinLocationIconGeometry}" Fill="#4CD964" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="15 Dirasakan" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsBmkgEqDirasakanTab}" Value="True">
                                                <Setter TargetName="SubBorder" Property="Background" Value="#162C22"/>
                                                <Setter TargetName="SubBorder" Property="BorderBrush" Value="#30D158"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- SUB-TAB 1: GEMPA BUMI TERBARU (AUTOGEMPA + SHAKEMAP) -->
                        <Border Visibility="{Binding IsBmkgEqAutoTab, Converter={StaticResource BoolToVis}}"
                                Background="#16131C" BorderBrush="#3A283A" BorderThickness="1.2" CornerRadius="14" Padding="14,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Magnitude Badge Box -->
                                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="14"
                                            Background="{Binding LatestEarthquake.MagnitudeBadgeBackground, FallbackValue=#362210}"
                                            BorderBrush="{Binding LatestEarthquake.MagnitudeBadgeBorder, FallbackValue=#FF9F1C}"
                                            BorderThickness="1.5" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="MAGNITUDO" FontSize="7.5" FontWeight="Bold"
                                                       Foreground="{Binding LatestEarthquake.MagnitudeBadgeForeground, FallbackValue=#FFB74D}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding LatestEarthquake.Magnitude, FallbackValue='-'}" FontSize="22" FontWeight="ExtraBold"
                                                       Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Wilayah & Waktu -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <DockPanel LastChildFill="True" Margin="0,0,0,3">
                                            <Border DockPanel.Dock="Right" Background="#281E28" BorderBrush="#4C3448" BorderThickness="1" CornerRadius="5" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LatestEarthquake.TimeAgoLabel, FallbackValue='-'}" Foreground="#FFB74D" FontSize="9.5" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding LatestEarthquake.DateTimeSummary, FallbackValue='Memuat data gempa...'}" FontSize="10.5" Foreground="#C8C0D4" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <TextBlock Text="{Binding LatestEarthquake.Wilayah, FallbackValue='Menunggu data dari server BMKG...'}"
                                                   FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding LatestEarthquake.PotensiOrDirasakanSummary}"
                                                   FontSize="11" Foreground="#4CD964" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Parameter Detail Gempa (Kedalaman & Koordinat) -->
                                <UniformGrid Columns="2" Margin="0,10,0,8">
                                    <Border Background="#0E0D14" BorderBrush="#2C2638" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Kedalaman Pusat Gempa" FontSize="9.5" FontWeight="SemiBold" Foreground="#B4B0C8"/>
                                            <TextBlock Text="{Binding LatestEarthquake.Kedalaman, FallbackValue='-'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0E0D14" BorderBrush="#2C2638" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Koordinat Episentrum" FontSize="9.5" FontWeight="SemiBold" Foreground="#B4B0C8"/>
                                            <TextBlock Text="{Binding LatestEarthquake.CoordinateSummary, FallbackValue='-'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Tombol Aksi Peta & Shakemap -->
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenEarthquakeMapCommand}" Padding="9,4" Margin="0,0,5,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource PinLocationIconGeometry}" Fill="#4CD964" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Buka Titik di Google Maps" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SmallPillButton}" Command="{Binding ToggleShakemapCommand}"
                                            Visibility="{Binding LatestEarthquake.HasShakemap, Converter={StaticResource BoolToVis}}" Padding="9,4" Margin="0,0,5,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource SeismicPulseIconGeometry}" Stroke="#FFB74D" StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Peta Guncangan (Shakemap)" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenShakemapBrowserCommand}"
                                            Visibility="{Binding LatestEarthquake.HasShakemap, Converter={StaticResource BoolToVis}}" Padding="9,4" Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GlobeIconGeometry}" Stroke="#7DD3FC" StrokeThickness="1.8" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Perbesar Shakemap" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <!-- Pratinjau Gambar Shakemap Resmi BMKG -->
                                <Border Visibility="{Binding IsShowingShakemap, Converter={StaticResource BoolToVis}}"
                                        Background="#0A0A0E" BorderBrush="#2E283C" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,2,0,0">
                                    <StackPanel>
                                        <TextBlock Text="PETA GUNCANGAN (SHAKEMAP BMKG)" FontSize="9" FontWeight="Bold" Foreground="#A8A4C0" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <Border CornerRadius="8" ClipToBounds="True" MaxHeight="220" HorizontalAlignment="Center" Cursor="Hand"
                                                ToolTip="Klik untuk memperbesar Peta Guncangan (Shakemap) di browser">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenShakemapBrowserCommand}"/>
                                            </Border.InputBindings>
                                            <Image Source="{Binding LatestEarthquake.ShakemapUrl}" Stretch="Uniform" MaxHeight="215"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SUB-TAB 2: DAFTAR 15 GEMPA TERKINI (M >= 5.0) -->
                        <Border Visibility="{Binding IsBmkgEqTerkiniTab, Converter={StaticResource BoolToVis}}"
                                Background="#0E0E14" BorderBrush="#26283A" BorderThickness="1" CornerRadius="12" Padding="8,6">
                            <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RecentEarthquakes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#151722" BorderBrush="#282C40" BorderThickness="1" CornerRadius="9" Padding="9,7" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Badge Magnitudo -->
                                                    <Border Grid.Column="0" CornerRadius="8" Padding="4,6" Margin="0,0,9,0" VerticalAlignment="Center"
                                                            Background="{Binding MagnitudeBadgeBackground}"
                                                            BorderBrush="{Binding MagnitudeBadgeBorder}" BorderThickness="1">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MagnitudeFormatted}" Foreground="{Binding MagnitudeBadgeForeground}"
                                                                       FontSize="11.5" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Kedalaman}" Foreground="#E0E4F0" FontSize="8.5" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Detail Lokasi & Waktu -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Wilayah}" Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding DateTimeSummary}" Foreground="#B0B6D0" FontSize="10" Margin="0,2,0,1"/>
                                                        <TextBlock Text="{Binding Potensi}" Foreground="#4CD964" FontSize="9.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <!-- Tombol Maps -->
                                                    <Button Grid.Column="2" Style="{StaticResource SmallPillButton}"
                                                            Command="{Binding DataContext.OpenEarthquakeMapCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Buka lokasi gempa di Google Maps" VerticalAlignment="Center" Padding="7,5">
                                                        <Path Data="{StaticResource PinLocationIconGeometry}" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- SUB-TAB 3: DAFTAR 15 GEMPA DIRASAKAN -->
                        <Border Visibility="{Binding IsBmkgEqDirasakanTab, Converter={StaticResource BoolToVis}}"
                                Background="#0E0E14" BorderBrush="#26283A" BorderThickness="1" CornerRadius="12" Padding="8,6">
                            <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FeltEarthquakes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#151722" BorderBrush="#282C40" BorderThickness="1" CornerRadius="9" Padding="9,7" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Badge Magnitudo -->
                                                    <Border Grid.Column="0" CornerRadius="8" Padding="4,6" Margin="0,0,9,0" VerticalAlignment="Center"
                                                            Background="{Binding MagnitudeBadgeBackground}"
                                                            BorderBrush="{Binding MagnitudeBadgeBorder}" BorderThickness="1">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MagnitudeFormatted}" Foreground="{Binding MagnitudeBadgeForeground}"
                                                                       FontSize="11.5" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Kedalaman}" Foreground="#E0E4F0" FontSize="8.5" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Detail Lokasi, Waktu & Skala MMI Dirasakan -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Wilayah}" Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding DateTimeSummary}" Foreground="#B0B6D0" FontSize="10" Margin="0,2,0,1"/>
                                                        <TextBlock Text="{Binding Dirasakan, StringFormat='Dirasakan (MMI): {0}'}" Foreground="#FFB74D" FontSize="9.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                                                   Visibility="{Binding HasDirasakan, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>

                                                    <!-- Tombol Maps -->
                                                    <Button Grid.Column="2" Style="{StaticResource SmallPillButton}"
                                                            Command="{Binding DataContext.OpenEarthquakeMapCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Buka lokasi gempa di Google Maps" VerticalAlignment="Center" Padding="7,5">
                                                        <Path Data="{StaticResource PinLocationIconGeometry}" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- ROW 3: FOOTER ATRIBUSI RESMI BMKG -->
                    <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallPillButton}"
                                Command="{Binding OpenBmkgWebsiteCommand}" Padding="9,3.5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GlobeIconGeometry}" Stroke="#38BDF8" StrokeThickness="1.8" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="bmkg.go.id" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Sumber Data Terbuka: Badan Meteorologi, Klimatologi, dan Geofisika (BMKG)"
                                   FontSize="9.5" Foreground="#98A0BE" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
