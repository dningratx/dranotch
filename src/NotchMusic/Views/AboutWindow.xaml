<Window x:Class="NotchMusic.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tentang DRANOTCH"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <LinearGradientBrush x:Key="LuxuryNotchBorderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#28FFFFFF" Offset="0.0"/>
            <GradientStop Color="#282838" Offset="0.5"/>
            <GradientStop Color="#44445E" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MetallicIconBadgeBgBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#232330" Offset="0.0"/>
            <GradientStop Color="#15151E" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MetallicIconBadgeBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4AFFFFFF" Offset="0.0"/>
            <GradientStop Color="#1CFFFFFF" Offset="0.5"/>
            <GradientStop Color="#36FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="SmallPillButton" TargetType="Button">
            <Setter Property="Background" Value="#24242E"/>
            <Setter Property="Foreground" Value="#E0E0E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#363646"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#343444"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#565670"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#1E1E28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" Background="#F40D0D12"
            BorderBrush="{StaticResource LuxuryNotchBorderBrush}"
            BorderThickness="1.2"
            CornerRadius="20"
            Padding="18,16,18,18">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.72"/>
        </Border.Effect>

        <StackPanel>
            <!-- HEADER: Logo, Title, Version & Close Button -->
            <DockPanel LastChildFill="True" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallPillButton}"
                        Click="CloseButton_Click" Content="&#x2715;" ToolTip="Tutup Info DRANOTCH"
                        VerticalAlignment="Top" Padding="8,4"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="13"
                            Background="{StaticResource MetallicIconBadgeBgBrush}"
                            BorderBrush="{StaticResource MetallicIconBadgeBorderBrush}"
                            BorderThickness="1.2" Margin="0,0,12,0">
                        <Image Source="pack://application:,,,/NotchMusic;component/Assets/app.png"
                               Width="30" Height="30" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DRANOTCH" Foreground="#FFFFFF" FontSize="17.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Background="#232332" BorderBrush="#40405A" BorderThickness="1" CornerRadius="7" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentVersionText, FallbackValue='v1.8.0'}" Foreground="#30D158" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Dynamic Island &amp; Productivity Companion for Windows"
                                   Foreground="#A2A2B8" FontSize="11" FontWeight="Medium" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- DESKRIPSI SINGKAT -->
            <Border Background="#161620" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,14">
                <TextBlock Text="DRANOTCH menghadirkan pengalaman Dynamic Island modern, ramping, dan elegan langsung di bagian atas desktop Windows Anda untuk menunjang hiburan dan produktivitas harian."
                           Foreground="#DCDCE8" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
            </Border>

            <!-- FOOTER: Tombol Versi / Pembaruan, Halaman Rilis, & Tutup -->
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource SmallPillButton}"
                        Command="{Binding CheckOrInstallUpdateCommand}"
                        ToolTip="{Binding VersionButtonTooltip}" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2B06;" Foreground="#30D158" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding VersionButtonText, FallbackValue='v1.8.0'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Left" Style="{StaticResource SmallPillButton}"
                        Click="OpenReleasePage_Click" Content="Halaman Rilis"
                        ToolTip="Buka halaman rilis resmi DRANOTCH (https://dningratx.github.io/dranotch/)"/>

                <Button DockPanel.Dock="Right" Style="{StaticResource SmallPillButton}"
                        Click="CloseButton_Click" Content="Tutup" Padding="14,6"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
