<Window x:Class="NotchMusic.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tentang DRANOTCH"
        Width="340"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/NotchMusic;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="8"
            Background="{StaticResource SurfaceBaseBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14,12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.45"/>
        </Border.Effect>

        <StackPanel>
            <DockPanel LastChildFill="True" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource CompactGhostButtonStyle}"
                        Click="CloseButton_Click" Content="&#x2715;" ToolTip="Tutup"
                        Width="24" Height="24" VerticalAlignment="Top"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8"
                            Background="{StaticResource SurfaceElevatedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" Margin="0,0,10,0">
                        <Image Source="pack://application:,,,/NotchMusic;component/Assets/app.png"
                               Width="22" Height="22" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DRANOTCH" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentVersionText, FallbackValue='v1.8.1'}" Foreground="{StaticResource AccentActiveBrush}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Top-bezel utility for Windows"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                <TextBlock Text="Panel ringkas di tepi atas layar Windows untuk pemutar musik, lirik, jadwal sholat, daftar tugas, radio, cuaca BMKG, pengingat, catatan tempel, dan tangkapan layar."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap" LineHeight="17"/>
            </Border>

            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource CompactButtonStyle}"
                        Command="{Binding CheckOrInstallUpdateCommand}"
                        ToolTip="{Binding VersionButtonTooltip}" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2B06;" Foreground="{StaticResource AccentActiveBrush}" FontSize="10.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding VersionButtonText, FallbackValue='v1.8.1'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Left" Style="{StaticResource CompactButtonStyle}"
                        Click="OpenReleasePage_Click" Content="Halaman Rilis"
                        ToolTip="Buka halaman rilis DRANOTCH"/>

                <Button DockPanel.Dock="Right" Style="{StaticResource CompactButtonStyle}"
                        Click="CloseButton_Click" Content="Tutup" Padding="12,4"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
