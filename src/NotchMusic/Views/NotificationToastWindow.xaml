<Window x:Class="NotchMusic.Views.NotificationToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NotchMusic.Helpers"
        Title="DRANOTCH - Notifikasi"
        SizeToContent="WidthAndHeight"
        MinWidth="380" MaxWidth="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <!-- Geometries -->
        <Geometry x:Key="LuxuryPrayerIconGeometry">M 20.6,13.4 A 8.6,8.6 0 1 1 10.6,3.4 A 6.6,6.6 0 0 0 20.6,13.4 Z M 17.5,2.2 L 18.5,5.0 L 21.3,6.0 L 18.5,7.0 L 17.5,9.8 L 16.5,7.0 L 13.7,6.0 L 16.5,5.0 Z</Geometry>
        <Geometry x:Key="LuxuryBmkgIconGeometry">M 6.5,14.8 H 17.5 A 3.4,3.4 0 0 0 18.1,8.1 A 4.8,4.8 0 0 0 8.8,6.5 A 3.8,3.8 0 0 0 6.5,14.8 Z M 2.5,19.2 H 7.2 L 9.0,16.2 L 11.4,21.5 L 13.8,17.2 L 15.2,19.2 H 21.5</Geometry>

        <!-- Small Pill Button Style -->
        <Style x:Key="SmallPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E28"/>
            <Setter Property="Foreground" Value="#D4D4E0"/>
            <Setter Property="BorderBrush" Value="#2E2E3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2C2C3E"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4E4E68"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#383850"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border x:Name="ToastContainer"
                CornerRadius="20"
                Background="#0C0C12"
                BorderBrush="#30FFFFFF"
                BorderThickness="1.2"
                Padding="6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.65"/>
            </Border.Effect>

            <StackPanel Orientation="Vertical">
                <!-- 1. PENGINGAT PINTAR (MINUM AIR / OBAT / AKTIVITAS) NOTIFIKASI -->
                <Border Visibility="{Binding HasActiveReminderNotification, Converter={StaticResource BoolToVis}}"
                        Background="#0E1824" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="16"
                        Padding="14,10" Margin="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                Background="{Binding ActiveReminderNotification.BadgeBackground, FallbackValue=#16283C}"
                                BorderBrush="{Binding ActiveReminderNotification.BadgeBorder, FallbackValue=#284A6E}"
                                BorderThickness="1" Margin="0,0,12,0">
                            <Path Data="{Binding ActiveReminderNotification.IconGeometry}"
                                  Fill="{Binding ActiveReminderNotification.AccentColor, FallbackValue=#38BDF8}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Background="#1A2C42" BorderBrush="#2E4E74" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveReminderNotification.TimeFormatted}" Foreground="#7CC4FA" FontSize="10.5" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding ActiveReminderNotification.Title}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding ActiveReminderNotification.Message}" Foreground="#D4E4F4" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Sudah / Selesai Button -->
                        <Button Grid.Column="2" Command="{Binding CompleteActiveReminderNotificationCommand}"
                                Style="{StaticResource SmallPillButton}" Content="✓ Sudah" ToolTip="Tandai pengingat ini sudah dilakukan"
                                Background="#143624" Foreground="#4CD964" BorderBrush="#265E3E"
                                Height="28" Padding="12,0" Margin="0,0,6,0" VerticalAlignment="Center"/>

                        <!-- Tunda 10m Button -->
                        <Button Grid.Column="3" Command="{Binding SnoozeActiveReminderNotificationCommand}" CommandParameter="10"
                                Style="{StaticResource SmallPillButton}" Content="💤 +10m" ToolTip="Tunda pengingat ini 10 menit"
                                Background="#1C2838" Foreground="#98C0E8" BorderBrush="#2E4460"
                                Height="28" Padding="10,0" Margin="0,0,6,0" VerticalAlignment="Center"/>

                        <!-- Dismiss button -->
                        <Button Grid.Column="4" Command="{Binding DismissReminderNotificationCommand}"
                                Style="{StaticResource SmallPillButton}" Content="&#x2715;" ToolTip="Tutup Notifikasi"
                                Width="28" Height="28" Padding="0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 2. WAKTU SHOLAT & ADZAN NOTIFIKASI -->
                <Border Visibility="{Binding HasActivePrayerNotification, Converter={StaticResource BoolToVis}}"
                        Background="#0D0D11" BorderBrush="#FFD43B" BorderThickness="1.5" CornerRadius="16"
                        Padding="14,10" Margin="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#262215" BorderBrush="#504422" BorderThickness="1" Margin="0,0,12,0">
                            <Path Data="{StaticResource LuxuryPrayerIconGeometry}" Fill="#FFD43B"
                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Background="#332A15" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActivePrayerNotification.PrayerTimeFormatted}" Foreground="#FFE082" FontSize="10.5" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding ActivePrayerNotification.Title}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding ActivePrayerNotification.Message}" Foreground="#E0E0E0" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Dismiss button -->
                        <Button Grid.Column="2" Command="{Binding DismissPrayerNotificationCommand}"
                                Style="{StaticResource SmallPillButton}" Content="&#x2715;" ToolTip="Tutup Notifikasi"
                                Width="28" Height="28" Padding="0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 3. CUACA & GEMPA BUMI BMKG NOTIFIKASI -->
                <Border Visibility="{Binding HasActiveBmkgNotification, Converter={StaticResource BoolToVis}}"
                        Background="#1A1014" BorderBrush="#FF6B8B" BorderThickness="1.5" CornerRadius="16"
                        Padding="14,10" Margin="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#361822" BorderBrush="#5A2838" BorderThickness="1" Margin="0,0,12,0">
                            <Path Data="{StaticResource LuxuryBmkgIconGeometry}" Stroke="#FF6B8B" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Background="#3B1A24" BorderBrush="#FF6B8B" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveBmkgNotification.MagnitudeBadge}" Foreground="#FFB74D" FontSize="10.5" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding ActiveBmkgNotification.Title}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding ActiveBmkgNotification.Message}" Foreground="#E2E2EC" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Lihat Detail Button -->
                        <Button Grid.Column="2" Command="{Binding OpenBmkgNotificationDetailCommand}"
                                Style="{StaticResource SmallPillButton}" Content="Lihat Detail" ToolTip="Buka detail gempa &amp; peta guncangan (Shakemap) BMKG"
                                Background="#2D1C28" Foreground="#FFB74D" BorderBrush="#5C3448"
                                Height="28" Padding="12,0" Margin="0,0,6,0" VerticalAlignment="Center"/>

                        <!-- Dismiss button -->
                        <Button Grid.Column="3" Command="{Binding DismissBmkgNotificationCommand}"
                                Style="{StaticResource SmallPillButton}" Content="&#x2715;" ToolTip="Tutup Peringatan BMKG"
                                Width="28" Height="28" Padding="0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 4. TO-DO LIST DEADLINE NOTIFIKASI -->
                <Border Visibility="{Binding HasActiveTodoNotification, Converter={StaticResource BoolToVis}}"
                        Background="#161017" BorderBrush="#FF4D6D" BorderThickness="1.5" CornerRadius="16"
                        Padding="14,10" Margin="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#301520" BorderBrush="#552233" BorderThickness="1" Margin="0,0,12,0">
                            <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z M 11.25,6.5 L 11.25,12.5 L 15.5,15 L 16.25,13.75 L 12.75,11.75 L 12.75,6.5 Z"
                                  Width="18" Height="18" Stretch="Uniform" Fill="#FF6B8B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding ActiveTodoNotification.Title}" Foreground="#FF6B8B" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ActiveTodoNotification.Message}" Foreground="#EAEAEA" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Selesai Button -->
                        <Button Grid.Column="2" Command="{Binding CompleteTodoNotificationCommand}"
                                Style="{StaticResource SmallPillButton}" Content="Selesai" ToolTip="Tandai tugas selesai"
                                Background="#1A3820" Foreground="#4CD964" BorderBrush="#2A5C32"
                                Height="28" Padding="12,0" Margin="0,0,6,0" VerticalAlignment="Center"/>

                        <!-- Dismiss button -->
                        <Button Grid.Column="3" Command="{Binding DismissTodoNotificationCommand}"
                                Style="{StaticResource SmallPillButton}" Content="&#x2715;" ToolTip="Tutup Notifikasi"
                                Width="28" Height="28" Padding="0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>