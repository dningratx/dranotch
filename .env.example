# DRANOTCH - Environment Variables Template
# Salin berkas ini menjadi .env jika ingin menyetel variabel lokal saat development.

# Google Drive API OAuth Credentials
# Didapatkan dari Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth Client ID (Desktop Application)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
